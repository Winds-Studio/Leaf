From: MrlingXD <90316914+wling-art@users.noreply.github.com>
Date: Sun, 16 Aug 2026 07:47:55 +0800
Subject: [PATCH] Avoid regex in Material#matchMaterial


diff --git a/src/main/java/org/bukkit/Material.java b/src/main/java/org/bukkit/Material.java
index 3390c05258c1b93bf1295935e7704b4d6e234b58..de60a2527ac1fe95063f2c34ef2a33e246f0578d 100644
--- a/src/main/java/org/bukkit/Material.java
+++ b/src/main/java/org/bukkit/Material.java
@@ -3119,10 +3119,37 @@ public enum Material implements Keyed, Translatable, net.kyori.adventure.transla
 
         filtered = filtered.toUpperCase(Locale.ROOT);
 
-        filtered = filtered.replaceAll("\\s+", "_").replaceAll("\\W", "");
+        // Leaf start - collapse whitespace to '_', drop non-word chars
+        filtered = matchMaterialStrip(filtered);
+        // Leaf end - collapse whitespace to '_', drop non-word chars
         return getMaterial(filtered, legacyName);
     }
 
+    // Leaf start - collapse whitespace to '_', drop non-word chars
+    private static String matchMaterialStrip(final String filtered) {
+        StringBuilder result = new StringBuilder(filtered.length());
+        boolean pendingUnderscore = false;
+        for (int i = 0; i < filtered.length(); i++) {
+            char c = filtered.charAt(i);
+            if (c == ' ' || c == '\t' || c == '\n' || c == 0x0B || c == '\f' || c == '\r') {
+                pendingUnderscore = true;
+                continue;
+            }
+            if (pendingUnderscore) {
+                result.append('_');
+                pendingUnderscore = false;
+            }
+            if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
+                result.append(c);
+            }
+        }
+        if (pendingUnderscore) {
+            result.append('_');
+        }
+        return result.toString();
+    }
+    // Leaf end - collapse whitespace to '_', drop non-word chars
+
     static {
         for (Material material : values()) {
             BY_NAME.put(material.name(), material);
