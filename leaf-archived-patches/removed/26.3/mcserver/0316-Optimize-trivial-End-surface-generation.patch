From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Tue, 9 Nov 2077 00:00:00 +0800
Subject: [PATCH] Optimize trivial End surface generation

Removed since Leaf 26.3, Mojang rewrote the target code.

This patch is based on the following mixin:
"org/codeberg/zenxarch/fastnoise/mixin/perf/surface/NoiseChunkGeneratorMixin.java"
By: ZenXArch <zenxarch@noreply.codeberg.org>
As part of: FastNoise (https://codeberg.org/ZenXArch/FastNoise)
Licensed under: MPL-2.0 (https://www.mozilla.org/en-US/MPL/2.0/)

diff --git a/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java b/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
index 9c82e9552c4c23ea080332c4c6f948b18810a12a..ff3c22ad3e2fcaab852aec7797e9643ba9f6713f 100644
--- a/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
+++ b/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
@@ -222,8 +222,20 @@ public final class NoiseBasedChunkGenerator extends ChunkGenerator {
         final Set<Holder<Biome>> possibleBiomes,
         final MaterialRule materialRule
         , final net.minecraft.server.level.ServerLevel serverLevel // Paper - Flat bedrock generator settings
+        , final boolean hasCustomGenerator // Leaf - Optimize trivial End surface generation
     ) {
         if (!SharedConstants.debugVoidTerrain(protoChunk.getPos()) && !SharedConstants.DEBUG_DISABLE_SURFACE) {
+            // Leaf start - Optimize trivial End surface generation
+            if (org.dreeam.leaf.config.modules.opt.OptimizeEndSurfaceGen.enabled && !hasCustomGenerator) {
+                final NoiseGeneratorSettings settings = this.settings.value();
+                if (this.settings.is(NoiseGeneratorSettings.END)
+                    && !protoChunk.isUpgrading()
+                    && materialRule instanceof net.minecraft.world.level.levelgen.material.rule.BlockRule block
+                    && block.resultState() == settings.defaultBlock()) {
+                    return;
+                }
+            }
+            // Leaf end - Optimize trivial End surface generation
             WorldGenerationContext context = new WorldGenerationContext(this, protoChunk.getHeightAccessorForGeneration(), serverLevel); // Paper - Flat bedrock generator settings
             randomState.surfaceSystem().buildSurface(randomState, biomeManager, context, protoChunk, noiseChunk, materialRule, possibleBiomes);
         }
@@ -422,7 +434,7 @@ public final class NoiseBasedChunkGenerator extends ChunkGenerator {
 
                 try (Zone var41 = profiler.zone("buildSurface")) {
                     if (customGenerator == null || customGenerator.shouldGenerateSurface(chunk)) // Paper - Bukkit chunk generator callbacks
-                    this.buildSurface(chunk, noiseChunk, randomState, biomeManager, possibleBiomes, materialRule, structureManager.level.getMinecraftWorld()); // Paper - Flat bedrock generator settings
+                    this.buildSurface(chunk, noiseChunk, randomState, biomeManager, possibleBiomes, materialRule, structureManager.level.getMinecraftWorld(), customGenerator != null); // Paper - Flat bedrock generator settings // Leaf - Optimize trivial End surface generation
                 }
                 if (customGenerator != null) customGenerator.buildSurface(chunk); // Paper - Bukkit chunk generator callbacks
 
