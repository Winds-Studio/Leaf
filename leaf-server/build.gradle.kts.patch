+// Leaf start - Use leafclip
+/**
+ * - Excludes libraries from Maven Central, Paper's maven, and Leaf' maven.
+ *  They will be downloaded during server launches.
+ * - Adds `LICENSE.txt`
+ */
+abstract class CreateLeafclipJar : DefaultTask() {
+    @get:InputFile
+    @get:PathSensitive(PathSensitivity.NONE)
+    abstract val inputJar: RegularFileProperty
+
+    @get:InputFile
+    @get:PathSensitive(PathSensitivity.NONE)
+    abstract val licenseFile: RegularFileProperty
+
+    // Same order as the loader
+    @get:Input
+    abstract val repositories: ListProperty<String>
+
+    @get:OutputFile
+    abstract val outputZip: RegularFileProperty
+
+    @get:Internal
+    abstract val cacheDir: DirectoryProperty
+
+    // line: the line of libraries.list; path: also where the file is in the jar
+    private class Lib(val sha256: String, val id: String, val path: String, val line: String)
+
+    private fun sha256Hex(digest: MessageDigest) = digest.digest().joinToString("") {
+        "%02x".format(it)
+    }
+
+    private fun sha256(file: Path): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+        Files.newInputStream(file).use { input ->
+            val buffer = ByteArray(65536)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                digest.update(buffer, 0, read)
+            }
+        }
+        return sha256Hex(digest)
+    }
+
+    /** @return the SHA-256 of the downloaded file written to [target], or null if the repository doesn't have it */
+    private fun download(client: HttpClient, url: String, target: Path): String? {
+        var failure: IOException? = null
+        for (attempt in 0..2) {
+            if (attempt > 0) Thread.sleep(1000L * attempt)
+            try {
+                val request = HttpRequest.newBuilder(URI.create(url)).timeout(Duration.ofSeconds(60)).GET().build()
+                val response = client.send(request, HttpResponse.BodyHandlers.ofInputStream())
+                response.body().use { body ->
+                    when (response.statusCode()) {
+                        200 -> {
+                            val digest = MessageDigest.getInstance("SHA-256")
+                            Files.newOutputStream(target).use { out ->
+                                val buffer = ByteArray(65536)
+                                while (true) {
+                                    val read = body.read(buffer)
+                                    if (read < 0) break
+                                    digest.update(buffer, 0, read)
+                                    out.write(buffer, 0, read)
+                                }
+                            }
+                            return sha256Hex(digest)
+                        }
+                        404 -> return null
+                        else -> throw IOException("HTTP ${response.statusCode()}")
+                    }
+                }
+            } catch (e: IOException) {
+                failure = e
+            }
+        }
+        throw GradleException("Failed to check $url: $failure", failure)
+    }
+
+    /** @return where the file with this SHA-256 can be downloaded from, "cache" if known, or null if nowhere */
+    private fun findSource(client: HttpClient, lib: Lib, cache: Path): String? {
+        val cached = cache.resolve(lib.sha256 + ".jar")
+        if (Files.exists(cached) && sha256(cached) == lib.sha256) {
+            return "cache"
+        }
+
+        val temp = Files.createTempFile(cache, "download", ".tmp")
+        try {
+            for (repository in repositories.get()) {
+                val hash = download(client, repository.trimEnd('/') + "/" + lib.path, temp)
+                if (hash == lib.sha256) {
+                    Files.move(temp, cached, StandardCopyOption.REPLACE_EXISTING)
+                    return repository
+                }
+            }
+            return null
+        } finally {
+            Files.deleteIfExists(temp)
+        }
+    }
+
+    @TaskAction
+    fun create() {
+        val output = outputZip.get().asFile.toPath()
+        val temp = output.resolveSibling(output.fileName.toString() + ".tmp")
+        Files.createDirectories(output.parent)
+
+        ZipFile(inputJar.get().asFile).use { zip ->
+            val librariesList = zip.getEntry("META-INF/libraries.list")
+                ?: throw GradleException("META-INF/libraries.list not found in ${inputJar.get().asFile}")
+            val libs = zip.getInputStream(librariesList).bufferedReader().readLines().filter { it.isNotBlank() }.map {
+                val parts = it.split("\t")
+                if (parts.size != 3) throw GradleException("Malformed libraries.list line: $it")
+                Lib(parts[0], parts[1], parts[2], it)
+            }
+
+            // Only libraries bundled as complete jars; the others are from the original jar or created from patches
+            val bundled = libs.filter { zip.getEntry("META-INF/libraries/" + it.path) != null }
+            val removable = HashMap<Lib, String>() // lib -> source
+            val kept = ArrayList<Lib>() // no repository has a file with the same SHA-256
+
+            val cache = cacheDir.get().asFile.toPath()
+            Files.createDirectories(cache)
+            val client = HttpClient.newBuilder().followRedirects(HttpClient.Redirect.NORMAL)
+                .connectTimeout(Duration.ofSeconds(15)).build()
+            val executor = Executors.newFixedThreadPool(8)
+            try {
+                val futures =
+                    bundled.map { lib -> lib to executor.submit(Callable<String?> { findSource(client, lib, cache) }) }
+                for ((lib, future) in futures) {
+                    val source = try {
+                        future.get()
+                    } catch (e: ExecutionException) {
+                        throw e.cause ?: e
+                    }
+                    if (source != null) removable[lib] = source else kept.add(lib)
+                }
+            } finally {
+                executor.shutdownNow()
+            }
+
+            val removedNames = removable.keys.mapTo(HashSet()) { "META-INF/libraries/" + it.path }
+            // Directories that still contain a file
+            val keptDirs = HashSet<String>()
+            for (entry in zip.entries()) {
+                if (entry.isDirectory || entry.name in removedNames) continue
+                var index = entry.name.lastIndexOf('/')
+                while (index > 0) {
+                    if (!keptDirs.add(entry.name.substring(0, index + 1))) break
+                    index = entry.name.lastIndexOf('/', index - 1)
+                }
+            }
+
+            val fixedTime = zip.getEntry("META-INF/MANIFEST.MF")?.time ?: 0L
+            ZipOutputStream(Files.newOutputStream(temp).buffered()).use { out ->
+                fun add(name: String, time: Long, content: ByteArray) {
+                    out.putNextEntry(ZipEntry(name).also { it.time = time })
+                    out.write(content)
+                    out.closeEntry()
+                }
+
+                var hasLicense = false
+                for (entry in zip.entries()) {
+                    if (entry.name in removedNames) continue
+                    if (entry.isDirectory && entry.name.startsWith("META-INF/libraries/") && entry.name !in keptDirs) continue
+                    if (entry.name == "META-INF/libraries.list") {
+                        // One line for every library, also the removed ones
+                        val text = libs.joinToString("") { it.line + "\n" }
+                        add(entry.name, entry.time, text.toByteArray())
+                        continue
+                    }
+                    if (entry.name == "LICENSE.txt") hasLicense = true
+
+                    out.putNextEntry(ZipEntry(entry.name).also { it.time = entry.time })
+                    if (!entry.isDirectory) {
+                        zip.getInputStream(entry).use { it.transferTo(out) }
+                    }
+                    out.closeEntry()
+                }
+
+                if (!hasLicense) {
+                    add("LICENSE.txt", fixedTime, licenseFile.get().asFile.readBytes())
+                }
+            }
+
+            Files.move(temp, output, StandardCopyOption.REPLACE_EXISTING)
+
+            removable.entries.sortedBy { it.key.id }.forEach { logger.info("createLeafclipJar: removed ${it.key.id} <- ${it.value}") }
+            kept.sortedBy { it.id }.forEach { logger.info("createLeafclipJar: kept ${it.id}") }
+            fun mb(bytes: Long) = "%.2f MB".format(bytes / 1024.0 / 1024.0)
+            logger.lifecycle("createLeafclipJar: removed ${removable.size} libraries, kept ${kept.size}; ${mb(inputJar.get().asFile.length())} -> ${mb(Files.size(output))}")
+        }
+    }
+}
+
+tasks.register<CreateLeafclipJar>("createLeafclipJar") {
+    group = "bundling"
+    description = "Build a runnable paperclip jar without maven downloadable libraries for Leaf"
+    inputJar.set(tasks.createPaperclipJar.flatMap { it.outputZip })
+    licenseFile.set(layout.projectDirectory.file("../paper-server/LICENSE.txt"))
+    repositories.set(
+        listOf(
+            "https://repo1.maven.org/maven2/",
+            paperMavenPublicUrl,
+            leafMavenPublicUrl
+        )
+    )
+    // Same name scheme as createPaperclipJar
+    outputZip.set(layout.buildDirectory.file("libs/${rootProject.name}-leafclip-${project.version}.jar"))
+    cacheDir.set(layout.buildDirectory.dir("leafclip/cache"))
+}
+// Leaf end - Use leafclip
