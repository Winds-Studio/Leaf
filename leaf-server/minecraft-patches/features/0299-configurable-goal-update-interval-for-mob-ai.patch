         this.speedModifier = speedModifier;
     }
 
+    private final int reciprocal = Math.max(1, reducedTickDelay(org.dreeam.leaf.config.modules.opt.EntityGoal.chanceFollowParent)); private int counter; // Leaf
     @Override
     public boolean canUse() {
+        counter += 1; if (counter < reciprocal) { return false; } else { counter = this.animal.random.nextInt(reciprocal); } // Leaf
         if (this.animal.getAge() >= 0) {
             return false;
         } else {
diff --git a/net/minecraft/world/entity/ai/goal/MoveThroughVillageGoal.java b/net/minecraft/world/entity/ai/goal/MoveThroughVillageGoal.java
index f3b1a34497dd5496c8a19279dcbaad673a804337..bd8de045836155ad288ca084751015c4c2a02125 100644
--- a/net/minecraft/world/entity/ai/goal/MoveThroughVillageGoal.java
+++ b/net/minecraft/world/entity/ai/goal/MoveThroughVillageGoal.java
@@ -44,8 +44,10 @@ public class MoveThroughVillageGoal extends Goal {
         }
     }
 
+    private final int reciprocal = Math.max(1, reducedTickDelay(org.dreeam.leaf.config.modules.opt.EntityGoal.chanceMoveThroughVillage)); private int counter; // Leaf
     @Override
     public boolean canUse() {
+        counter += 1; if (counter < reciprocal) { return false; } else { counter = this.mob.random.nextInt(reciprocal); } // Leaf
         if (!GoalUtils.hasGroundPathNavigation(this.mob)) {
             return false;
         } else {
diff --git a/net/minecraft/world/entity/ai/goal/TemptGoal.java b/net/minecraft/world/entity/ai/goal/TemptGoal.java
index 7cb94eb75a1de0cef02d4953ee5896bd5e3c7abd..5d7e4eb689f0411865e85675f1d66cd8c3a93393 100644
--- a/net/minecraft/world/entity/ai/goal/TemptGoal.java
+++ b/net/minecraft/world/entity/ai/goal/TemptGoal.java
@@ -51,8 +51,10 @@ public class TemptGoal extends Goal {
         this.targetingConditions = globalTemptationLookupIndex >= 0 ? TEMPT_TARGETING.copy() : TEMPT_TARGETING.copy().selector((entity, level) -> this.shouldFollow(entity)); // Paper - optimise temptation checks - skip selector if we have a lookup index.
     }
 
+    private final int reciprocal = Math.max(1, reducedTickDelay(org.dreeam.leaf.config.modules.opt.EntityGoal.chanceTempt)); private int counter; // Leaf
     @Override
     public boolean canUse() {
+        counter += 1; if (counter < reciprocal) { return false; } else { counter = this.mob.random.nextInt(reciprocal); } // Leaf
         if (this.calmDown > 0) {
             this.calmDown--;
             return false;
diff --git a/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java b/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
index 024792900c8ab716e91ef512d2da22548075044d..6c5efe75b9468d55afc94a9b7afee3557514a7ab 100644
--- a/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
+++ b/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
@@ -36,7 +36,7 @@ public class NearestAttackableTargetGoal<T extends LivingEntity> extends TargetG
     ) {
         super(mob, mustSee, mustReach);
         this.targetType = targetType;
-        this.randomInterval = reducedTickDelay(interval);
+        this.randomInterval = org.dreeam.leaf.config.modules.opt.EntityGoal.chanceTarget > 0 && interval <= 10 ? reducedTickDelay(org.dreeam.leaf.config.modules.opt.EntityGoal.chanceTarget) : reducedTickDelay(interval); // Leaf
         this.setFlags(EnumSet.of(Goal.Flag.TARGET));
         this.targetConditions = TargetingConditions.forCombat().range(this.getFollowDistance()).selector(selector);
     }
