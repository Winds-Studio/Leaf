From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hayanesuru <hayanesuru@outlook.jp>
Date: Sun, 31 Aug 2025 00:04:28 +0900
Subject: [PATCH] configurable goal update interval for mob ai


diff --git a/net/minecraft/world/entity/ai/goal/AvoidEntityGoal.java b/net/minecraft/world/entity/ai/goal/AvoidEntityGoal.java
index 7651676e72fcec52d7c1f9f7d7b6f9e585015c4d..e23eab1971932e2206ffe7bca05a4b844342143d 100644
--- a/net/minecraft/world/entity/ai/goal/AvoidEntityGoal.java
+++ b/net/minecraft/world/entity/ai/goal/AvoidEntityGoal.java
@@ -65,8 +65,10 @@ public class AvoidEntityGoal<T extends LivingEntity> extends Goal {
         this(mob, avoidClass, livingEntity -> true, maxDistance, walkSpeedModifier, sprintSpeedModifier, predicateOnAvoidEntity);
     }
 
+    private final int reciprocal = Math.max(1, reducedTickDelay(org.dreeam.leaf.config.modules.opt.EntityGoal.chanceAvoidEntity)); private int counter; // Leaf
     @Override
     public boolean canUse() {
+        counter += 1; if (counter < reciprocal) { return false; } else { counter = this.mob.random.nextInt(reciprocal); } // Leaf
         this.toAvoid = getServerLevel(this.mob)
             .getNearestEntity(
                 this.mob.level().getEntitiesOfClass(this.avoidClass, this.mob.getBoundingBox().inflate(this.maxDist, 3.0, this.maxDist), livingEntity -> true),
