From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Naw0ke <nawoke@trprac.net>
Date: Sun, 17 May 2026 12:00:00 +0300
Subject: [PATCH] Optimize EndCrystalItem useOn by using pattern variable

Replace redundant cast with pattern variable to avoid repeated
ServerLevel casting and reduce level() method calls.

diff --git a/net/minecraft/world/item/EndCrystalItem.java b/net/minecraft/world/item/EndCrystalItem.java
index 0db35674..ea12d9f4 100644
--- a/net/minecraft/world/item/EndCrystalItem.java
+++ b/net/minecraft/world/item/EndCrystalItem.java
@@ -38,8 +38,8 @@ public class EndCrystalItem extends Item {
                 if (!entities.isEmpty()) {
                     return InteractionResult.FAIL;
                 } else {
-                    if (level instanceof ServerLevel) {
-                        EndCrystal endCrystal = new EndCrystal(level, d + 0.5, d1, d2 + 0.5);
+                    if (level instanceof ServerLevel serverLevel) { // Leaf - use pattern variable
+                        EndCrystal endCrystal = new EndCrystal(serverLevel, d + 0.5, d1, d2 + 0.5); // Leaf - use cached serverLevel
                         endCrystal.setShowBottom(false);
                         // CraftBukkit start
                         if (org.bukkit.craftbukkit.event.CraftEventFactory.callEntityPlaceEvent(context, endCrystal).isCancelled()) {
@@ -47,10 +47,10 @@ public class EndCrystalItem extends Item {
                             return InteractionResult.FAIL;
                         }
                         // CraftBukkit end
-                        level.addFreshEntity(endCrystal);
-                        level.gameEvent(context.getPlayer(), GameEvent.ENTITY_PLACE, blockPos);
-                        if (level.galeConfig().gameplayMechanics.tryRespawnEnderDragonAfterEndCrystalPlace) { // Gale - Pufferfish - make ender dragon respawn attempt after placing end crystals configurable
-                        EndDragonFight dragonFight = ((ServerLevel)level).getDragonFight();
+                        serverLevel.addFreshEntity(endCrystal); // Leaf - use cached serverLevel
+                        serverLevel.gameEvent(context.getPlayer(), GameEvent.ENTITY_PLACE, blockPos); // Leaf - use cached serverLevel
+                        if (serverLevel.galeConfig().gameplayMechanics.tryRespawnEnderDragonAfterEndCrystalPlace) { // Leaf - use cached serverLevel // Gale - Pufferfish - make ender dragon respawn attempt after placing end crystals configurable
+                        EndDragonFight dragonFight = serverLevel.getDragonFight(); // Leaf - use cached serverLevel
                         if (dragonFight != null) {
                             dragonFight.tryRespawn(aboveBlockPos); // Paper - Perf: Do crystal-portal proximity check before entity lookup
                         }
