Subject: [PATCH] Temp fix blockpos is null crash

This patch is not the correct solution at all. It just aims to prevent the server from crashing in production.
And adds some useful debug information to find out why this can happen.

In theory, this NPE should not happen at all, my assumption is that some plugins are doing sus things or causing this
issue indirectly.

Note: Based on the report, this issue is not in Leaf 26.2

diff --git a/net/minecraft/world/level/block/CropBlock.java b/net/minecraft/world/level/block/CropBlock.java
index 372559399ce8a4ce551f4403975879e365e1ad75..af4bd2c33242bf8faab9c3566cda56ef4fb6cba6 100644
--- a/net/minecraft/world/level/block/CropBlock.java
+++ b/net/minecraft/world/level/block/CropBlock.java
@@ -120,6 +120,34 @@ public class CropBlock extends VegetationBlock implements BonemealableBlock {
         for (int i = -1; i <= 1; i++) {
             for (int i1 = -1; i1 <= 1; i1++) {
                 float f1 = 0.0F;
+                // Leaf start - Temp fix blockpos is null crash
+                if (blockPos == null) {
+                    // Debug, no idea why this crash happens so no idea how this debug can work.
+                    org.apache.logging.log4j.Logger logger = org.dreeam.leaf.config.modules.fixes.MCBugFix.LOGGER;
+
+                    logger.info("CropBlock.getGrowthSpeed: i={}, i1={}, f={}", i, i1, f);
+                    logger.info("pos: null={}, class={}",
+                        pos == null,
+                        pos == null ? "<null>" : pos.getClass().getName()
+                    );
+                    logger.info("below: null={}, class={}",
+                        blockPos == null,
+                        blockPos == null ? "<null>" : blockPos.getClass().getName()
+                    );
+
+                    if (pos != null) {
+                        try {
+                            logger.info("pos.below() declaringClass={}",
+                                pos.getClass().getMethod("below").getDeclaringClass().getName());
+                        } catch (ReflectiveOperationException | SecurityException e) {
+                            logger.info("Unable to resolve pos.below() declaring class", e);
+                        }
+                    }
+                    Thread.dumpStack();
+
+                    return 0.0F;
+                }
+                // Leaf end - Temp fix blockpos is null crash
                 BlockState blockState = level.getBlockState(blockPos.offset(i, 0, i1));
                 if (blockState.is(Blocks.FARMLAND)) {
                     f1 = 1.0F;
