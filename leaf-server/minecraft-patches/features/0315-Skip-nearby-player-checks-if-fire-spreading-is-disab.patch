From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: okx-code <okx@okx.sh>
Date: Mon, 19 Oct 2026 16:42:48 +0100
Subject: [PATCH] Skip nearby player checks if fire spreading is disabled


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 7c73f5373d741c5703fff7f5e6eb66d6916b6d8f..f2cbf7bedbdbf821ae7f6e02eb71135271742ed4 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -3332,6 +3332,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
     public boolean canSpreadFireAround(final BlockPos pos) {
         int spreadRadius = this.getGameRules().get(GameRules.FIRE_SPREAD_RADIUS_AROUND_PLAYER);
+        // Leaf start - Skip player checks when fire spreading is disabled
+        if (spreadRadius == 0) {
+            return false;
+        }
+        // Leaf end - Skip player checks when fire spreading is disabled
         return spreadRadius == -1 || this.chunkSource.chunkMap.anyPlayerCloseEnoughTo(pos, spreadRadius);
     }
 
