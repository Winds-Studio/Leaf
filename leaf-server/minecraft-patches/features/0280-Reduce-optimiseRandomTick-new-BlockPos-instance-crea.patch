diff --git a/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
index 7f2dfe7258de5e738e7651c1a4afa6546fd62139..5a13e92a9563c0992b6661d36e8fdaa5a36c2da6 100644
--- a/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
@@ -115,7 +115,7 @@ public class ExperimentalRedstoneWireEvaluator extends RedstoneWireEvaluator {
         BlockState initialState = level.getBlockState(initialPosition);
         if (initialState.is(this.wireBlock)) {
             this.setPower(initialPosition, initialState.getValue(RedstoneWireBlock.POWER), initialOrientation);
-            this.wiresToTurnOff.add(initialPosition);
+            this.wiresToTurnOff.add(initialPosition.immutable()); // Leaf - Reduce optimiseRandomTick new BlockPos instance create - immutable
         } else {
             this.propagateChangeToNeighbors(level, initialPosition, 0, initialOrientation, true);
         }
