                         chargeMap.computeInt(pos, (k, count) -> (count == null ? 0 : count) + cursor.charge);
                         SculkSpreader.ChargeCursor existing = mergeableCursors.get(pos);
                         if (existing == null) {
diff --git a/net/minecraft/world/level/block/TurtleEggBlock.java b/net/minecraft/world/level/block/TurtleEggBlock.java
