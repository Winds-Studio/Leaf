+    // Leaf start - Fix MC-152094
+    static boolean recursiveChildren(
+        StructureTemplateManager structureTemplateManager,
+        SectionGenerator sectionGenerator,
+        int counter,
+        EndCityPiece piece,
+        BlockPos startPos,
+        List<StructurePiece> pieces,
+        RandomSource random,
+        org.dreeam.leaf.util.ReferenceBounds referenceBounds
+    ) {
+        if (counter > 8) {
+            return false;
+        } else {
+            List<StructurePiece> list = Lists.newArrayList();
+            if (sectionGenerator.generate(structureTemplateManager, counter, piece, startPos, list, random, referenceBounds)) {
+                boolean flag = false;
+                int randomInt = random.nextInt();
+
+                for (StructurePiece structurePiece : list) {
+                    structurePiece.setGenDepth(randomInt);
+
+                    StructurePiece structurePiece1 = StructurePiece.findCollisionPiece(pieces, structurePiece.getBoundingBox());
+                    if (structurePiece1 != null && structurePiece1.getGenDepth() != piece.getGenDepth()) {
+                        flag = true;
+                        break;
+                    }
+                }
+
+                if (!flag) {
+                    pieces.addAll(list);
+                    return true;
+                }
+            }
+
+            return false;
+        }
+    }
+
+    private static @org.jspecify.annotations.Nullable EndCityPiece addShipWithinReferenceBounds(
+        StructureTemplateManager structureTemplateManager,
+        EndCityPiece parent,
+        int localX,
+        int localY,
+        int requestedLocalZ,
+        Rotation rotation,
+        List<StructurePiece> currentBranchPieces,
+        org.dreeam.leaf.util.ReferenceBounds referenceBounds
+    ) {
+        for (int localZ = requestedLocalZ; localZ <= 0; localZ++) {
+            EndCityPiece ship = EndCityPieces.addPiece(
+                structureTemplateManager,
+                parent,
+                new BlockPos(localX, localY, localZ),
+                "ship",
+                rotation,
+                true
+            );
+
+            if (
+                referenceBounds.contains(ship.getBoundingBox())
+                    && StructurePiece.findCollisionPiece(currentBranchPieces, ship.getBoundingBox()) == null
+            ) {
+                return ship;
+            }
+        }
+
+        return null;
+    }
+    // Leaf end - Fix MC-152094
+
     static boolean recursiveChildren(
         StructureTemplateManager structureTemplateManager,
         EndCityPieces.SectionGenerator sectionGenerator,
@@ -422,5 +698,19 @@ public class EndCityPieces {
