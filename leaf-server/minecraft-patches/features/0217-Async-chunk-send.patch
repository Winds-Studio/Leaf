-        packetListener.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify));
+        // Leaf start - Async chunk send
+        if (org.dreeam.leaf.config.modules.async.AsyncChunkSend.enabled) {
