diff --git a/net/minecraft/server/network/EventLoopGroupHolder.java b/net/minecraft/server/network/EventLoopGroupHolder.java
index 9dd4ee9e126f3fcbba7b05e0d5ea79d300323cff..d276f1475ab770aa104a46ad14fed9379d61883c 100644
--- a/net/minecraft/server/network/EventLoopGroupHolder.java
+++ b/net/minecraft/server/network/EventLoopGroupHolder.java
@@ -70,6 +70,14 @@ public abstract class EventLoopGroupHolder {
         }
     };
     // Leaf end - Add io_uring support
+    // Leaf start - Add IOCP support
+    private static final EventLoopGroupHolder IOCP = new EventLoopGroupHolder("IOCP", org.dreeam.leaf.netty.iocp.IocpSocketChannel.class, org.dreeam.leaf.netty.iocp.IocpServerSocketChannel.class) {
+        @Override
+        protected IoHandlerFactory ioHandlerFactory() {
+            return org.dreeam.leaf.netty.iocp.IocpIoHandler.newFactory();
+        }
+    };
+    // Leaf end - Add IOCP support
     private final String type;
     private final Class<? extends Channel> channelCls;
     private final Class<? extends ServerChannel> serverChannelCls;
@@ -83,6 +91,13 @@ public abstract class EventLoopGroupHolder {
     public static EventLoopGroupHolder remote(final java.net.@Nullable SocketAddress address, final boolean allowNativeTransport) {
         // Paper end - Unix domain socket support
         if (allowNativeTransport) {
+            // Leaf start - Add IOCP support
+            if (org.dreeam.leaf.util.LeafConstants.ENABLE_IOCP && (address == null || address instanceof java.net.InetSocketAddress)) {
+                if (org.dreeam.leaf.netty.iocp.Iocp.isAvailable()) {
+                    return IOCP;
+                }
+            }
+            // Leaf end - Add IOCP support
             // Leaf start - Add io_uring support
             if (org.dreeam.leaf.util.LeafConstants.ENABLE_IO_URING && io.netty.channel.uring.IoUring.isAvailable()) {
                 if (address instanceof io.netty.channel.unix.DomainSocketAddress) {
