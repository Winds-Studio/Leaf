From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dreeam <61569423+Dreeam-qwq@users.noreply.github.com>
Date: Mon, 16 Nov 2026 08:59:22 -0500
Subject: [PATCH] Paper: Fix tree capture state leak

Original license: GPL-3.0-only
Original project: https://github.com/PaperMC/Paper
Paper commit: https://github.com/PaperMC/Paper/pull/14001/changes/7b66699b70792643d6a89ca6d72b1ba46effb179

Backported from Paper 26.2

Always reset captureTreeGeneration in finally so an exception during bone meal use (e.g. lone upper half small dripleaf)
can't leave tree capture enabled and dupe items.

diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index dca53271eb2deec06ff96bffeb6667387990fbdf..d1734f9618e684de6748a9a7362593ea98593010 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -387,6 +387,7 @@ public final class ItemStack implements DataComponentHolder, net.caffeinemc.mods
             DataComponentPatch previousPatch = this.components.asPatch();
             int oldCount = this.getCount();
             ServerLevel serverLevel = (ServerLevel) context.getLevel();
+            final boolean captureTreeGeneration = item == Items.BONE_MEAL; // Leaf - Paper: Fix tree capture state leak
 
             if (!(item instanceof BucketItem/* || item instanceof SolidBucketItem*/)) { // if not bucket // Paper - Fix cancelled powdered snow bucket placement
                 serverLevel.captureBlockStates = true;
@@ -407,6 +408,7 @@ public final class ItemStack implements DataComponentHolder, net.caffeinemc.mods
                 interactionResult = item.useOn(context);
             } finally {
                 serverLevel.captureBlockStates = false;
+                serverLevel.captureTreeGeneration = false; // Leaf - Paper: Fix tree capture state leak
                 // Paper start - Fix cancelled rooted dirt drops being duped
                 if (capturedDrops != null) {
                     serverLevel.captureDrops = null;
@@ -417,8 +419,7 @@ public final class ItemStack implements DataComponentHolder, net.caffeinemc.mods
             int newCount = this.getCount();
             this.setCount(oldCount);
             this.restorePatch(previousPatch);
-            if (interactionResult.consumesAction() && serverLevel.captureTreeGeneration && !serverLevel.capturedBlockStates.isEmpty()) {
-                serverLevel.captureTreeGeneration = false;
+            if (interactionResult.consumesAction() && captureTreeGeneration && !serverLevel.capturedBlockStates.isEmpty()) { // Leaf - Paper: Fix tree capture state leak
                 org.bukkit.Location location = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(clickedPos, serverLevel);
                 org.bukkit.TreeType treeType = net.minecraft.world.level.block.SaplingBlock.getTreeTypeRT(); // Leaf - SparklyPaper - parallel world ticking
                 net.minecraft.world.level.block.SaplingBlock.setTreeTypeRT(null); // Leaf - SparklyPaper - parallel world ticking
