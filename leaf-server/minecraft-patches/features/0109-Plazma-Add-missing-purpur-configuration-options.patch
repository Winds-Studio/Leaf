--- a/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java
+++ b/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java
@@ -31,7 +31,7 @@ import org.jspecify.annotations.Nullable;
 
 public abstract class AbstractChestBoat extends AbstractBoat implements HasCustomInventoryScreen, ContainerEntity {
     private static final int CONTAINER_SIZE = 27;
-    private NonNullList<ItemStack> itemStacks = NonNullList.withSize(27, ItemStack.EMPTY);
+    private NonNullList<ItemStack> itemStacks = NonNullList.withSize(org.purpurmc.purpur.PurpurConfig.chestBoatRows * 9, ItemStack.EMPTY); // Leaf - Plazma - Add missing purpur configuration options
     private @Nullable ResourceKey<LootTable> lootTable;
     private long lootTableSeed;
 
@@ -58,6 +58,17 @@ public abstract class AbstractChestBoat extends AbstractBoat implements HasCusto
     @Override
     protected void readAdditionalSaveData(final ValueInput input) {
         super.readAdditionalSaveData(input);
+        // Leaf start - Plazma - Add missing purpur configuration options
+        int containerRows = org.purpurmc.purpur.PurpurConfig.chestBoatRows;
+        // Keep occupied rows when the configured inventory shrinks
+        final ValueInput.TypedInputList<net.minecraft.world.ItemStackWithSlot> savedItems = input.listOrEmpty(net.minecraft.world.ContainerHelper.TAG_ITEMS, net.minecraft.world.ItemStackWithSlot.CODEC);
+        for (net.minecraft.world.ItemStackWithSlot item : savedItems) {
+            if (item.slot() >= 0 && item.slot() < 54) {
+                containerRows = Math.max(containerRows, item.slot() / 9 + 1);
+            }
+        }
+        this.itemStacks = NonNullList.withSize(containerRows * 9, ItemStack.EMPTY);
+        // Leaf end - Plazma - Add missing purpur configuration options
         this.readChestVehicleSaveData(input);
     }
 
@@ -112,7 +123,7 @@ public abstract class AbstractChestBoat extends AbstractBoat implements HasCusto
 
     @Override
     public int getContainerSize() {
-        return 27;
+        return this.itemStacks.size(); // Leaf - Plazma - Add missing purpur configuration options
     }
 
     @Override
@@ -156,7 +167,16 @@ public abstract class AbstractChestBoat extends AbstractBoat implements HasCusto
         }
 
         this.unpackLootTable(inventory.player);
-        return ChestMenu.threeRows(containerId, inventory, this);
+        // Leaf start - Plazma - Add missing purpur configuration options
+        return switch (this.getContainerSize() / 9) {
+            case 1 -> ChestMenu.oneRow(containerId, inventory, this);
+            case 2 -> ChestMenu.twoRows(containerId, inventory, this);
+            case 4 -> ChestMenu.fourRows(containerId, inventory, this);
+            case 5 -> ChestMenu.fiveRows(containerId, inventory, this);
+            case 6 -> ChestMenu.sixRows(containerId, inventory, this);
+            default -> ChestMenu.threeRows(containerId, inventory, this);
+        };
+        // Leaf end - Plazma - Add missing purpur configuration options
     }
 
     public void unpackLootTable(final @Nullable Player player) {
