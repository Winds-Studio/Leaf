Original project: https://github.com/PaperMC/Paper
Paper pull request: https://github.com/PaperMC/Paper/pull/13094

Related MC issue: https://mojira.dev/MC-297196

diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 20cf0022566bc1ba1c0b1ce5d749f61694cd6a15..cc1d86567653142f3466514cdc0cb1b613b88dc3 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -511,7 +511,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         if (tickChunks) {
             ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.level).moonrise$getPlayerChunkLoader().tick(); // Paper - rewrite chunk system
             this.tickChunks();
-            this.chunkMap.tick();
+            if (!org.dreeam.leaf.config.modules.gameplay.Knockback.useLegacyTrackerTicking) this.chunkMap.tick(); // Leaf - Use legacy tracker ticking
         }
 
         profilerFiller.popPush("unload");
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 0e382269d5c0ae85ccf424104e9fb404d9cc8ce0..acaaf7d8648bc9d55721ee35bcea619e63a26005 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1088,6 +1088,7 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         profilerFiller.push("entityManagement");
         // Paper - rewrite chunk system
         profilerFiller.pop();
+        if (org.dreeam.leaf.config.modules.gameplay.Knockback.useLegacyTrackerTicking) this.getChunkSource().chunkMap.tick(); // Leaf - Use legacy tracker ticking
         profilerFiller.push("debugSynchronizers");
         if (this.debugSynchronizers.hasAnySubscriberFor(DebugSubscriptions.NEIGHBOR_UPDATES)) {
             this.neighborUpdater
