@@ -1964,6 +1964,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         profiler.popPush("server gui refresh");
 
+        org.dreeam.leaf.protocol.Protocols.tickServer(this); // Leaf - Protocol core
+
         for (Runnable tickable : this.tickables) {
             tickable.run();
         }
