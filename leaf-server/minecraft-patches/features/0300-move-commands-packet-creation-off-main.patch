From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hayanesuru <hayanesuru@outlook.jp>
Date: Sun, 1 Mar 2026 19:50:15 +0900
Subject: [PATCH] move commands packet creation off-main


diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index d9283f8d24bf7c28f9b123e9e58dc535003a13c3..a218a5dd84437cec5a77b68c61bd6998dcfcc98a 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -518,7 +518,8 @@ public class Commands {
         }
         // CraftBukkit end
         } // Gale - Purpur - skip PlayerCommandSendEvent if there are no listeners
-        player.connection.send(new ClientboundCommandsPacket(rootCommandNode, COMMAND_NODE_INSPECTOR));
+        net.minecraft.server.network.ServerGamePacketListenerImpl connection = player.connection;
+        io.papermc.paper.util.MCUtil.scheduleAsyncTask(() -> connection.send(new ClientboundCommandsPacket(rootCommandNode, COMMAND_NODE_INSPECTOR)));
     }
 
     // Paper PR start - Fix async command building throwing CME in some cases
