diff --git a/net/minecraft/world/inventory/ItemCombinerMenu.java b/net/minecraft/world/inventory/ItemCombinerMenu.java
index 84e19afd9b790c2ac449afabf734ed85d16c669e..8fb0cc1c914ba03730b113acc176305c46a9b29c 100644
--- a/net/minecraft/world/inventory/ItemCombinerMenu.java
+++ b/net/minecraft/world/inventory/ItemCombinerMenu.java
@@ -124,6 +124,7 @@ public abstract class ItemCombinerMenu extends AbstractContainerMenu {
         if (slot != null && slot.hasItem()) {
             ItemStack stack = slot.getItem();
             clicked = stack.copy();
+            ItemStack clickedCopy = clicked.copy(); // Leaf - Fix MC-65198
             int inventorySlotStart = this.getInventorySlotStart();
             int useRowSlotEnd = this.getUseRowEnd();
             if (slotIndex == this.getResultSlot()) {
@@ -161,7 +162,7 @@ public abstract class ItemCombinerMenu extends AbstractContainerMenu {
             }
 
             this.activeQuickItem = clicked; // Purpur - Anvil API
-            slot.onTake(player, stack);
+            slot.onTake(player, clickedCopy); // Leaf - Fix MC-65198
             this.activeQuickItem = null; // Purpur - Anvil API
         }
 
diff --git a/net/minecraft/world/inventory/ResultSlot.java b/net/minecraft/world/inventory/ResultSlot.java
