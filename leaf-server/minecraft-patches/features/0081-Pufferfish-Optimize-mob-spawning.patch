+    // Leaf start - Pufferfish - async mob spawning
+    public EnvironmentAttributeReader captureMobSpawnSettings(final BiomeManager biomeManager) {
+        ValueSampler<net.minecraft.world.level.biome.MobSpawnSettings> sampler = this.getValueSampler(EnvironmentAttributes.NATURAL_MOB_SPAWNS);
+        if (sampler == null) {
+            return EnvironmentAttributeReader.EMPTY;
+        }
+        Builder builder = builder();
+        net.minecraft.world.level.biome.MobSpawnSettings baseValue = sampler.baseValue;
+        builder.addConstantLayer(EnvironmentAttributes.NATURAL_MOB_SPAWNS, value -> baseValue);
+        for (EnvironmentAttributeLayer<net.minecraft.world.level.biome.MobSpawnSettings> layer : sampler.layers) {
+            switch (layer) {
+                case EnvironmentAttributeLayer.Constant<net.minecraft.world.level.biome.MobSpawnSettings> constant ->
+                    builder.addConstantLayer(EnvironmentAttributes.NATURAL_MOB_SPAWNS, constant);
+                case EnvironmentAttributeLayer.Positional<net.minecraft.world.level.biome.MobSpawnSettings> ignored ->
+                    addBiomeLayerForAttribute(builder, EnvironmentAttributes.NATURAL_MOB_SPAWNS, biomeManager);
+                case EnvironmentAttributeLayer.TimeBased<net.minecraft.world.level.biome.MobSpawnSettings> timeBased ->
+                    builder.addConstantLayer(EnvironmentAttributes.NATURAL_MOB_SPAWNS,
+                        ((net.minecraft.world.timeline.AttributeTrackSampler<net.minecraft.world.level.biome.MobSpawnSettings, ?>)timeBased).capture(sampler.cacheTickId));
+            }
+        }
+        return builder.build();
+    }
+    // Leaf end - Pufferfish - async mob spawning
