+    // Leaf start - Pufferfish - async mob spawning
+    public static SpawnState createStateAsync(
+        final int spawnableChunkCount, final Iterable<Entity> entities, final ServerLevel level, final EnvironmentAttributeReader environmentAttributes, final boolean countAllMobsForSpawning
+    ) {
+        PotentialCalculator spawnPotential = new PotentialCalculator();
+        Object2IntOpenHashMap<MobCategory> mobCounts = new Object2IntOpenHashMap<>();
+        it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<int[]> chunkCap = new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+        for (Entity entity : entities) {
+            if (entity instanceof Mob mob && (mob.isPersistenceRequired() || mob.requiresCustomPersistence())) {
+                continue;
+            }
+            MobCategory category = entity.getType().getCategory();
+            if (category == MobCategory.MISC) {
+                continue;
+            }
+            if (!countAllMobsForSpawning
+                && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
+                && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CHUNK_GEN) {
+                continue;
+            }
+            BlockPos pos = entity.blockPosition();
+            long chunkKey = ChunkPos.pack(pos);
+            LevelChunk chunk = level.getChunkSource().fullChunks.get(chunkKey);
+            if (chunk != null) {
+                MobSpawnSettings naturalMobSpawns = environmentAttributes.getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+                MobSpawnSettings.MobSpawnCost cost = naturalMobSpawns.getMobSpawnCost(entity.getType());
+                if (cost != null) {
+                    spawnPotential.addCharge(pos, cost.charge());
+                }
+                mobCounts.addTo(category, 1);
+                ++chunkCap.computeIfAbsent(chunkKey, key -> new int[net.minecraft.server.level.ServerPlayer.MOBCATEGORY_TOTAL_ENUMS])[category.ordinal()];
+            }
+        }
+        return new SpawnState(spawnableChunkCount, mobCounts, spawnPotential, null, chunkCap);
+    }
+
+    public static final class AsyncSpawnCostSampler {
+        private final ServerLevel level;
+        private final net.minecraft.world.level.biome.BiomeManager biomeManager;
+
+        public AsyncSpawnCostSampler(final ServerLevel level) {
+            this.level = level;
+            net.minecraft.world.level.biome.BiomeResolver fallback = level.getChunkSource().getGenerator().getBiomeSource().createUncachedResolver(level.getChunkSource().randomState());
+            this.biomeManager = level.getBiomeManager().withDifferentSource((quartX, quartY, quartZ) -> {
+                ChunkAccess chunk = level.getChunk(quartX >> 2, quartZ >> 2, net.minecraft.world.level.chunk.status.ChunkStatus.BIOMES, false);
+                return chunk != null ? chunk.getNoiseBiome(quartX, quartY, quartZ) : fallback.getNoiseBiome(quartX, quartY, quartZ);
+            });
+        }
+
+        public EnvironmentAttributeReader capture() {
+            return this.level.environmentAttributes().captureMobSpawnSettings(this.biomeManager);
+        }
+    }
+    // Leaf end - Pufferfish - async mob spawning
