+    private <U extends T> void getEntities(java.util.Collection<net.minecraft.world.level.entity.EntityAccess> collection, EntityTypeTest<T, U> filter, AbortableIterationConsumer<U> consumer) {
+        for (EntityAccess entityAccess : collection) {
+            T entity = (T) entityAccess;
+            U maybeEntity = filter.tryCast(entity);
+            if (maybeEntity != null && consumer.accept(maybeEntity).shouldAbort()) {
+                return;
+            }
+        }
+    }
