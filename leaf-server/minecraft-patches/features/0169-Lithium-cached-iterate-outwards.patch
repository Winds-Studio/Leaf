diff --git a/net/minecraft/core/BlockPos.java b/net/minecraft/core/BlockPos.java
index 97e890079a3b5277678c4f9cb1334a53646cb0e9..b37c7dd23b3b677bf88c222ee5b4eaf1e0789a7c 100644
--- a/net/minecraft/core/BlockPos.java
+++ b/net/minecraft/core/BlockPos.java
@@ -330,7 +330,22 @@ public class BlockPos extends Vec3i {
         };
     }
 
+    // JettPack start - lithium: cached iterate outwards
+    private static final org.dreeam.leaf.util.cache.IterateOutwardsCache ITERATE_OUTWARDS_CACHE = new org.dreeam.leaf.util.cache.IterateOutwardsCache(50);
+    private static final it.unimi.dsi.fastutil.longs.LongList HOGLIN_PIGLIN_CACHE = ITERATE_OUTWARDS_CACHE.getOrCompute(8, 4, 8);
+    // JettPack end - lithium: cached iterate outwards
+
     public static Iterable<BlockPos> withinManhattan(final BlockPos origin, final int reachX, final int reachY, final int reachZ) {
+        // JettPack start - lithium: cached iterate outwards
+        if (origin != org.dreeam.leaf.util.cache.IterateOutwardsCache.POS_ZERO) {
+            final it.unimi.dsi.fastutil.longs.LongList positions = reachX == 8 && reachY == 4 && reachZ == 8 ? HOGLIN_PIGLIN_CACHE : ITERATE_OUTWARDS_CACHE.getOrCompute(reachX, reachY, reachZ);
+            return new org.dreeam.leaf.util.cache.LongList2BlockPosMutableIterable(origin, positions);
+        }
+        // JettPack end - lithium: cached iterate outwards
+        return withinManhattanUncached(origin, reachX, reachY, reachZ); // Leaf - Lithium - cached iterate outwards
+    }
+
+    public static Iterable<BlockPos> withinManhattanUncached(final BlockPos origin, final int reachX, final int reachY, final int reachZ) { // Leaf - Lithium - cached iterate outwards
         int maxDepth = reachX + reachY + reachZ;
         int originX = origin.getX();
         int originY = origin.getY();
diff --git a/net/minecraft/world/level/levelgen/feature/DeltaFeature.java b/net/minecraft/world/level/levelgen/feature/DeltaFeature.java
index 1cd0f45ce5dca43dbde3f43ad552206be92fb0d2..cec27969b79e09d7167e73d42849806b0adffc42 100644
--- a/net/minecraft/world/level/levelgen/feature/DeltaFeature.java
+++ b/net/minecraft/world/level/levelgen/feature/DeltaFeature.java
@@ -38,7 +38,7 @@ public class DeltaFeature extends Feature<DeltaFeatureConfiguration> {
         int radiusZ = config.size().sample(random);
         int radiusLimit = Math.max(radiusX, radiusZ);
 
-        for (BlockPos pos : BlockPos.withinManhattan(origin, radiusX, 0, radiusZ)) {
+        for (BlockPos pos : BlockPos.withinManhattanUncached(origin, radiusX, 0, radiusZ)) { // Leaf - Lithium - cached iterate outwards
             if (pos.distManhattan(origin) > radiusLimit) {
                 break;
             }
diff --git a/net/minecraft/world/level/levelgen/feature/ReplaceBlobsFeature.java b/net/minecraft/world/level/levelgen/feature/ReplaceBlobsFeature.java
index 57193ef92a1caff21627034ad31af8d9e24ad07f..1506c05732c73c4eeb11bb1b1872533108cb03d9 100644
--- a/net/minecraft/world/level/levelgen/feature/ReplaceBlobsFeature.java
+++ b/net/minecraft/world/level/levelgen/feature/ReplaceBlobsFeature.java
@@ -33,7 +33,7 @@ public class ReplaceBlobsFeature extends Feature<ReplaceSphereConfiguration> {
         int maximumRadius = Math.max(radiusX, Math.max(radiusY, radiusZ));
         boolean replacedAny = false;
 
-        for (BlockPos pos : BlockPos.withinManhattan(centerPos, radiusX, radiusY, radiusZ)) {
+        for (BlockPos pos : BlockPos.withinManhattanUncached(centerPos, radiusX, radiusY, radiusZ)) { // Leaf - Lithium - cached iterate outwards
             if (pos.distManhattan(centerPos) > maximumRadius) {
                 break;
             }
