From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jonax1337 <jonas.laux@hotmail.com>
Date: Mon, 26 Oct 2026 23:16:38 +0100
Subject: [PATCH] Compute only the 5-second TPS for the lagging check


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 1762520cf455b304a3f34aec73d46bdf1dd3ca67..7ef9cfced23dae6f7de85fb2aaa2af878df20fbc 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -441,6 +441,14 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
     }
 
+    // Leaf start - Compute only the 5-second TPS for the lagging check
+    private double getTPS5s() {
+        synchronized (this.statsLock) {
+            return getTPS(this.tickTimes5s, this.tickRateManager().nanosecondsPerTick());
+        }
+    }
+    // Leaf end - Compute only the 5-second TPS for the lagging check
+
     public double[] getTPSIncluding5SecondsReadOnly() {
         synchronized (this.statsLock) {
             double[] tps5s = this.tps5s;
@@ -1393,7 +1401,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                         io.papermc.paper.configuration.GlobalConfiguration.get().misc.catchupTicks.or(5)
                     );
 
-                    lagging = getTPSIncluding5SecondsReadOnly()[0] < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold // Gale - Purpur - 5-second TPS average
+                    lagging = this.getTPS5s() < org.purpurmc.purpur.PurpurConfig.laggingThreshold; // Purpur - Lagging threshold // Gale - Purpur - 5-second TPS average // Leaf - Compute only the 5-second TPS for the lagging check
 
                     // adjust ticksBehind so that it is not greater-than catchup
                     if (ticksBehind - catchup > 0L) {
