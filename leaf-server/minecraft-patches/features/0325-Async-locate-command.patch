Subject: [PATCH] Async locate command

Offloads /locate structure and biome search computations to async worker thread.

diff --git a/net/minecraft/server/commands/LocateCommand.java b/net/minecraft/server/commands/LocateCommand.java
index d018ec1c7876ddc883223d548fbe6a513e14bcfe..366b6640b045271e0e0365b2f617f91959ec67ba 100644
--- a/net/minecraft/server/commands/LocateCommand.java
+++ b/net/minecraft/server/commands/LocateCommand.java
@@ -93,6 +93,31 @@ public class LocateCommand {
     }
 
     private static int locateStructure(final CommandSourceStack source, final ResourceOrTagKeyArgument.Result<Structure> resourceOrTag) throws CommandSyntaxException {
+        // Leaf start - Async locate command
+        if (org.dreeam.leaf.config.modules.async.AsyncLocate.enabled) {
+            io.papermc.paper.util.MCUtil.scheduleAsyncTask(() -> {
+                Registry<Structure> registry = source.getLevel().registryAccess().lookupOrThrow(Registries.STRUCTURE);
+                HolderSet<Structure> target;
+                try {
+                    target = getHolders(resourceOrTag, registry)
+                        .orElseThrow(() -> ERROR_STRUCTURE_INVALID.create(resourceOrTag.asPrintable()));
+                } catch (CommandSyntaxException e) {
+                    source.sendFailure(Component.literal(e.getMessage()));
+                    return;
+                }
+                BlockPos sourcePos = BlockPos.containing(source.getPosition());
+                ServerLevel serverLevel = source.getLevel();
+                Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
+                Pair<BlockPos, Holder<Structure>> nearest = serverLevel.getChunkSource().getGenerator().findNearestMapStructure(serverLevel, target, sourcePos, 100, false);
+                stopwatch.stop();
+                if (nearest == null) {
+                    source.sendFailure(Component.literal(ERROR_STRUCTURE_NOT_FOUND.create(resourceOrTag.asPrintable()).getMessage()));
+                } else {
+                    showLocateResult(source, resourceOrTag, sourcePos, nearest, "commands.locate.structure.success", false, stopwatch.elapsed());
+                }
+            });
+            return 0;
+        }
         Registry<Structure> registry = source.getLevel().registryAccess().lookupOrThrow(Registries.STRUCTURE);
         HolderSet<Structure> target = (HolderSet<Structure>)getHolders(resourceOrTag, registry)
             .orElseThrow(() -> ERROR_STRUCTURE_INVALID.create(resourceOrTag.asPrintable()));
@@ -108,9 +133,25 @@ public class LocateCommand {
         } else {
             return showLocateResult(source, resourceOrTag, sourcePos, nearest, "commands.locate.structure.success", false, stopwatch.elapsed());
         }
+        // Leaf end - Async locate command
     }
 
     private static int locateBiome(final CommandSourceStack source, final ResourceOrTagArgument.Result<Biome> elementOrTag) throws CommandSyntaxException {
+        // Leaf start - Async locate command
+        if (org.dreeam.leaf.config.modules.async.AsyncLocate.enabled) {
+            io.papermc.paper.util.MCUtil.scheduleAsyncTask(() -> {
+                BlockPos sourcePos = BlockPos.containing(source.getPosition());
+                Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
+                Pair<BlockPos, Holder<Biome>> nearest = source.getLevel().findClosestBiome3d(elementOrTag, sourcePos, 6400, 32, 64);
+                stopwatch.stop();
+                if (nearest == null) {
+                    source.sendFailure(Component.literal(ERROR_BIOME_NOT_FOUND.create(elementOrTag.asPrintable()).getMessage()));
+                } else {
+                    showLocateResult(source, elementOrTag, sourcePos, nearest, "commands.locate.biome.success", true, stopwatch.elapsed());
+                }
+            });
+            return 0;
+        }
         BlockPos sourcePos = BlockPos.containing(source.getPosition());
         Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
         Pair<BlockPos, Holder<Biome>> nearest = source.getLevel().findClosestBiome3d(elementOrTag, sourcePos, 6400, 32, 64);
@@ -120,6 +161,7 @@ public class LocateCommand {
         } else {
             return showLocateResult(source, elementOrTag, sourcePos, nearest, "commands.locate.biome.success", true, stopwatch.elapsed());
         }
+        // Leaf end - Async locate command
     }
 
