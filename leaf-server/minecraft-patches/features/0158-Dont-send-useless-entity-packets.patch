diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index 1824735ea6b9fa870432e9c041f5c124de0cc2ba..c0cae97d81e29911ec7f95a51a6d597604252e40 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -190,6 +190,8 @@ public class ServerEntity {
                     packet = this.createMovePacket(position, yRotn, xRotn, shouldSendPosition, shouldSendRotation);
                 }
 
+                if (org.dreeam.leaf.config.modules.opt.ReduceUselessPackets.reduceUselessEntityMovePackets && isUselessMoveEntityPacket(packet, shouldSendRotation)) packet = null; // Leaf - Dont send useless entity packets
+
                 if (this.entity.needsSync || this.trackDelta || this.entity instanceof LivingEntity livingEntity && livingEntity.isFallFlying()) {
                     Vec3 movement = this.entity.getDeltaMovement();
                     if (movement != this.lastSentMovement) { // SparklyPaper start - skip distanceToSqr call in ServerEntity#sendChanges if the delta movement hasn't changed
@@ -312,6 +314,17 @@ public class ServerEntity {
         return false;
     }
 
+    // Leaf start - Dont send useless entity packets
+    private boolean isUselessMoveEntityPacket(final @Nullable MovementPacket<?> packet, final boolean shouldSendRotation) {
+        // Preserve rotation changes (including a turn back to zero), stepped paths and full state resyncs.
+        // On-ground changes are sent by createMovePacket as full state resyncs.
+        return !shouldSendRotation
+            && packet instanceof ClientboundMoveEntityPacket moveEntityPacket
+            && moveEntityPacket.getPositionDelta() instanceof VecDelta.Linear delta
+            && delta.xa() == 0 && delta.ya() == 0 && delta.za() == 0;
+    }
+    // Leaf end - Dont send useless entity packets
+
     private void handleMinecartPosRot(final NewMinecartBehavior newMinecartBehavior, final byte yRotn, final byte xRotn, final boolean shouldSendRotation) {
         this.sendDirtyEntityData();
         if (newMinecartBehavior.lerpSteps.isEmpty()) {
