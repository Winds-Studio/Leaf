+    private void processPacketBatch() {
+        // Collect packets from queue
+        int maxBatchSize = org.dreeam.leaf.config.modules.async.QueuedPacketSending.batchSize;
+        java.util.List<PacketEntry> batch = new java.util.ArrayList<>(
+            Math.min(packetQueue.size(), maxBatchSize)
+        );
+        PacketEntry entry;
+        boolean needsFlush = false;
+        while ((entry = packetQueue.poll()) != null && batch.size() < maxBatchSize) {
+            batch.add(entry);
+            needsFlush |= entry.flush;
+        }
+        if (batch.isEmpty()) {
+            return;
+        }
+        // Submit batch to event loop for processing
+        final boolean finalNeedsFlush = needsFlush;
+        this.channel.eventLoop().execute(() -> {
+            if (!this.channel.isOpen()) {
+                // Clean up if channel was closed
+                for (PacketEntry e : batch) {
+                    final net.minecraft.server.level.ServerPlayer player = this.getPlayer();
+                    if (e.packet.hasFinishListener()) {
+                        e.packet.onPacketDispatchFinish(player, null);
+                    }
+                }
+                return;
+            }
+            for (int i = 0; i < batch.size() - 1; i++) {
+                PacketEntry e = batch.get(i);
+                ChannelFuture writeFuture = this.channel.write(e.packet);
+                writeFuture.addListener(future -> {
+                    if (e.listener != null) {
+                        if (future.isSuccess()) {
+                            e.listener.onSuccess();
+                        } else {
+                            Packet<?> failurePacket = e.listener.onFailure();
+                            if (failurePacket != null) {
+                                ChannelFuture failureFuture = this.channel.writeAndFlush(failurePacket);
+                                failureFuture.addListener(ChannelFutureListener.FIRE_EXCEPTION_ON_FAILURE);
+                            }
+                        }
+                    }
+
+                    if (e.packet.hasFinishListener()) {
+                        e.packet.onPacketDispatchFinish(this.getPlayer(), (ChannelFuture)future);
+                    }
+                });
+            }
+            // Handle the last packet with flush if needed
+            if (!batch.isEmpty()) {
+                PacketEntry last = batch.get(batch.size() - 1);
+                ChannelFuture future = finalNeedsFlush ?
+                    this.channel.writeAndFlush(last.packet) :
+                    this.channel.write(last.packet);
+
+                future.addListener(f -> {
+                    if (last.listener != null) {
+                        if (f.isSuccess()) {
+                            last.listener.onSuccess();
+                        } else {
+                            Packet<?> failurePacket = last.listener.onFailure();
+                            if (failurePacket != null) {
+                                ChannelFuture failureFuture = this.channel.writeAndFlush(failurePacket);
+                                failureFuture.addListener(ChannelFutureListener.FIRE_EXCEPTION_ON_FAILURE);
+                            }
+                        }
+                    }
+
+                    if (last.packet.hasFinishListener()) {
+                        last.packet.onPacketDispatchFinish(this.getPlayer(), (ChannelFuture)f);
+                    }
+                });
+            }
+
+            // If we didn't flush on the last packet but need to flush, do it now
+            if (finalNeedsFlush && batch.size() > 1) {
+                this.channel.flush();
+            }
+        });
+    }
