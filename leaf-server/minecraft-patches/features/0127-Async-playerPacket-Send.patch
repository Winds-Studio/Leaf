+    private void processFastQueue() {
+        synchronized (fastPacketQueue) {
+            if (fastPacketQueue.isEmpty()) {
+                return;
+            }
+            int processedCount = 0;
+            Packet<?> packet;
+            while ((packet = fastPacketQueue.poll()) != null) {
+                boolean shouldFlush = flushFlags.get(processedCount);
+                PacketSendListener listener = listenerMap.remove(packet);
+                this.sendPacket(packet, listener, shouldFlush);
+                processedCount++;
+            }
+            queueSize = 0;
+            flushFlags.clear();
+        }
+    }
