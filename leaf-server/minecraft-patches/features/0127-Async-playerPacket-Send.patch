From: Taiyou06 <kaandindar21@gmail.com>
Date: Wed, 5 Mar 2025 16:01:11 +0100
Subject: [PATCH] Async playerPacket Send


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 5a8133497d9c1260a3bba7e9dc7f3b059bbe6b1a..99599a765ecfcda383e7a232136ba39c651c17aa 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -474,9 +474,39 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
 
     private void sendPacket(Packet<?> packet, @Nullable PacketSendListener sendListener, boolean flush) {
         this.sentPackets++;
+
+        // If we're already in the event loop, just execute directly
         if (this.channel.eventLoop().inEventLoop()) {
             this.doSendPacket(packet, sendListener, flush);
+            return;
+        }
+
+        // Check if async sending is enabled
+        if (org.dreeam.leaf.config.modules.async.AsyncPacketSending.enabled && io.papermc.paper.util.MCUtil.isMainThread()) {
+
+            try {
+                // Use the packet thread pool to offload the packet submission task
+                org.dreeam.leaf.config.modules.async.AsyncPacketSending.getPacketThreadExecutor().execute(() -> {
+                    if (this.channel.isOpen()) {
+                        // Submit to the event loop from our thread pool
+                        this.channel.eventLoop().execute(() -> this.doSendPacket(packet, sendListener, flush));
+                    } else {
+                        // If channel is closed while in the thread pool queue, ensure cleanup happens
+                        final net.minecraft.server.level.ServerPlayer player = this.getPlayer();
+                        if (packet.hasFinishListener()) {
+                            packet.onPacketDispatchFinish(player, null);
+                        }
+                    }
+                });
+            } catch (Throwable e) {
+                // Fall back to direct submission if the thread pool fails
+                if (LOGGER.isDebugEnabled()) {
+                    LOGGER.debug("Packet thread pool error, falling back to direct submission", e);
+                }
+                this.channel.eventLoop().execute(() -> this.doSendPacket(packet, sendListener, flush));
+            }
         } else {
+            // Original behavior - execute on the event loop
             this.channel.eventLoop().execute(() -> this.doSendPacket(packet, sendListener, flush));
         }
     }
