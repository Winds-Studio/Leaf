+                }
+                experienceOrb.leaf$skipInitialMerge = false;
+                this.player.giveExperiencePoints(-experienceToRemove);
+                experienceOrb.leaf$playerTouchInstantly(this.player);
+                // Leaf end - Fix Pufferfish and Purpur patches - Improve Purpur shift-click mending
                 return true;
             }
         }
