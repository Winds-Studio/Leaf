+++ b/net/minecraft/server/MinecraftServer.java
@@ -1965,6 +1965,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         profiler.popPush("server gui refresh");
 
+        org.dreeam.leaf.protocol.Protocols.tickServer(this); // Leaf - Protocol core
+
         for (Runnable tickable : this.tickables) {
             tickable.run();
         }
