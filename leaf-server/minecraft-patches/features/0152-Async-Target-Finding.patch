+        if (this.tamableMob.isTame()) {
+            return false;
+        }
+        LivingEntity currentTarget = this.target;
+        if (currentTarget == null || !currentTarget.isAlive() || currentTarget.isRemoved()) {
+            return false;
+        }
+
+        ServerLevel serverLevel = getServerLevel(this.mob);
