         super(mob, mustSee, mustReach);
         this.targetType = targetType;
         this.randomInterval = reducedTickDelay(interval);
+        this.originalSelector = selector; // Store the selector
         this.setFlags(EnumSet.of(Goal.Flag.TARGET));
-        this.targetConditions = TargetingConditions.forCombat().range(this.getFollowDistance()).selector(selector);
     }
 
     @Override
@@ -46,8 +85,23 @@ public class NearestAttackableTargetGoal<T extends LivingEntity> extends TargetG
         if (this.randomInterval > 0 && this.mob.getRandom().nextInt(this.randomInterval) != 0) {
             return false;
         } else {
-            this.findTarget();
-            return this.target != null;
+            // Process any pending target from the last async run (on main thread)
+            LivingEntity potentialTarget = this.pendingTarget.getAndSet(null);
+            if (potentialTarget != null && potentialTarget.isAlive() && !potentialTarget.isRemoved()) {
+                // Get ServerLevel safely on the main thread
+                ServerLevel serverLevel = getServerLevel(this.mob);
+                // Perform the final TargetingConditions check on the main thread
+                // Check if serverLevel is valid before testing
+                if (serverLevel != null && this.getTargetConditions().test(serverLevel, this.mob, potentialTarget)) { // Correct arguments for test
+                    this.validatedTarget = potentialTarget; // Mark as validated
+                } else {
+                    this.validatedTarget = null; // Failed validation or null level
+                }
+            }
+
+            this.findTarget(); // Start a new search if needed (or run sync)
+            // Check validatedTarget's status again as it might have changed between ticks
+            return this.validatedTarget != null && this.validatedTarget.isAlive() && !this.validatedTarget.isRemoved();
         }
     }
 
@@ -55,33 +109,239 @@ public class NearestAttackableTargetGoal<T extends LivingEntity> extends TargetG
         return this.mob.getBoundingBox().inflate(targetDistance, targetDistance, targetDistance);
     }
 
+    // Starts the target finding process (async or sync)
     protected void findTarget() {
-        ServerLevel serverLevel = getServerLevel(this.mob);
-        if (this.targetType != Player.class && this.targetType != ServerPlayer.class) {
-            this.target = serverLevel.getNearestEntity(
-                this.mob.level().getEntitiesOfClass(this.targetType, this.getTargetSearchArea(this.getFollowDistance()), entity -> true),
-                this.getTargetConditions(),
-                this.mob,
-                this.mob.getX(),
-                this.mob.getEyeY(),
-                this.mob.getZ()
-            );
-        } else {
-            this.target = serverLevel.getNearestPlayer(this.getTargetConditions(), this.mob, this.mob.getX(), this.mob.getEyeY(), this.mob.getZ());
+        // If async is disabled or we're already searching, use sync method
+        if (!AsyncTargetFinding.enabled || !this.isSearching.compareAndSet(false, true)) {
+            findTargetSync();
+            return;
+        }
+
+        // Capture mutable state to avoid race conditions
+        final Mob mob = this.mob;
+
+        // Safety check
+        if (mob == null || mob.isRemoved() || !mob.isAlive()) {
+            this.isSearching.set(false); // Ensure flag is reset
+            return;
+        }
+
+        final double x = mob.getX();
+        final double y = mob.getEyeY();
+        final double z = mob.getZ();
+        final double followDistance = this.getFollowDistance();
+        // We only need the distance check part for the async task
+        final double maxDistSqr = followDistance * followDistance;
+        final Class<T> targetType = this.targetType;
+
+        // Start async search: Find the *closest* entity matching basic criteria.
+        CompletableFuture.supplyAsync(() -> {
+            try {
+                ServerLevel serverLevel = getServerLevel(mob);
+                if (serverLevel == null) {
+                    return null;
+                }
+                // Re-check mob validity inside async task
+                if (mob.isRemoved() || !mob.isAlive()) {
+                    return null;
+                }
+
+                LivingEntity closestCandidate = null;
+
+                try {
+                    AABB searchArea = getTargetSearchArea(followDistance); // Use method to get area
+                    if (targetType != Player.class && targetType != ServerPlayer.class) {
+                        List<T> entities = null;
+                        try {
+                            // Pass predicate to avoid unnecessary checks later
+                            entities = serverLevel.getEntitiesOfClass(targetType, searchArea, entity -> // Use serverLevel here
+                                entity != null && entity != mob && entity.isAlive() && !entity.isRemoved()
+                            );
+                        } catch (Exception e) {
+                            System.err.println("Error getting entities: " + e.getMessage());
+                            return null; // Early exit on error
+                        }
+
+                        if (entities != null && !entities.isEmpty()) {
+                            closestCandidate = findNearestCandidate(entities, mob, x, y, z, maxDistSqr);
+                        }
+                    } else {
+                        // For players, get the list and filter similarly
+                        List<? extends Player> players = serverLevel.players();
+                        closestCandidate = findNearestCandidate(players, mob, x, y, z, maxDistSqr);
+                    }
+                } catch (Exception e) {
+                    System.err.println("Error finding entities in async target finder: " + e.getMessage());
+                    // closestCandidate remains null
+                }
+
+                return closestCandidate; // Return the candidate found (or null)
+            } catch (Exception e) {
+                System.err.println("Error during async target finding: " + e.getMessage());
+                return null;
+            } finally {
+                // IMPORTANT: Set searching to false *before* scheduling the main thread task
+                this.isSearching.set(false);
+            }
+        }, TARGET_FINDER_EXECUTOR).thenAccept(result -> {
+            // This runs after the async task completes (potentially on async thread)
+            // We just store the result; validation happens on the main thread in canUse()
+            if (result != null && result.isAlive() && !result.isRemoved()) {
+                this.pendingTarget.set(result);
+            }
+        });
+    }
+
+    // Async-safe method to find the closest valid candidate based on basic checks
+    @Nullable
+    private <E extends LivingEntity> E findNearestCandidate(
+        List<? extends E> entities, // Use generic type E
+        Mob source,
+        double x,
+        double y,
+        double z,
+        double maxDistSqr) {
+
+        if (entities == null || entities.isEmpty()) {
+            return null;
+        }
+
+        try {
+            double closestDistSq = maxDistSqr; // Start with max distance squared
+            E closest = null; // Use generic type E
+
+            // Iterate backwards for potential minor efficiency if list is ArrayList
+            for (int i = entities.size() - 1; i >= 0; i--) {
+                try {
+                    E entity = entities.get(i); // Use generic type E
+                    // Basic checks safe for async thread (already partially done in getEntitiesOfClass)
+                    // Redundant checks here are minimal overhead vs potential issues if list source changes
+                    if (entity == null || entity == source || entity.isRemoved() || !entity.isAlive()) {
+                        continue;
+                    }
+
+                    double dx = entity.getX() - x;
+                    double dy = entity.getEyeY() - y; // Compare eye heights
+                    double dz = entity.getZ() - z;
+                    double distSq = dx * dx + dy * dy + dz * dz;
+
+                    // Check distance (already squared) and if it's closer than current best
+                    // No TargetingConditions.test() here!
+                    if (distSq <= closestDistSq) {
+                        closestDistSq = distSq;
+                        closest = entity;
+                    }
+                } catch (IndexOutOfBoundsException e) {
+                    // Should not happen with backwards iteration if list isn't modified concurrently
+                    break;
+                } catch (Exception e) {
+                    System.err.println("Error processing entity in findNearestCandidate: " + e.getMessage());
+                    continue; // Skip problematic entity
+                }
+            }
+
+            return closest; // Return type E
+        } catch (Exception e) {
+            System.err.println("Error in findNearestCandidate: " + e.getMessage());
+            return null;
+        }
+    }
+
+
+    // Synchronous fallback method
+    private void findTargetSync() {
+        try {
+            ServerLevel serverLevel = getServerLevel(this.mob);
+            if (serverLevel == null) {
+                this.validatedTarget = null; // Ensure cleared if level is null
+                this.target = null;
+                return;
+            }
+            // Reset validated target if running sync
+            this.validatedTarget = null;
+            LivingEntity foundTarget = null;
+            TargetingConditions conditions = this.getTargetConditions(); // Get conditions with correct range
+
+            if (this.targetType != Player.class && this.targetType != ServerPlayer.class) {
+                try {
+                    // Pass predicate to filter basic validity
+                    foundTarget = serverLevel.getNearestEntity(
+                        serverLevel.getEntitiesOfClass(this.targetType, this.getTargetSearchArea(this.getFollowDistance()), entity -> // Use serverLevel here
+                            entity != null && entity.isAlive() && !entity.isRemoved()
+                        ),
+                        conditions, // Use conditions with correct range
+                        this.mob,
+                        this.mob.getX(),
+                        this.mob.getEyeY(),
+                        this.mob.getZ()
+                    );
+                } catch (Exception e) {
+                    System.err.println("Error in sync entity finding: " + e.getMessage());
+                    foundTarget = null;
+                }
+            } else {
+                try {
+                    foundTarget = serverLevel.getNearestPlayer(conditions, this.mob, this.mob.getX(), this.mob.getEyeY(), this.mob.getZ());
+                } catch (Exception e) {
+                    System.err.println("Error in sync player finding: " + e.getMessage());
+                    foundTarget = null;
+                }
+            }
+            // Set the validated target directly in sync mode
+            if (foundTarget != null && foundTarget.isAlive() && !foundTarget.isRemoved()) {
+                // Double check with test() even in sync mode for consistency, though getNearest* should already use it
+                if (conditions.test(serverLevel, this.mob, foundTarget)) {
+                    this.validatedTarget = foundTarget;
+                }
+            }
+            // Also update the main target field for consistency in sync mode
+            this.target = this.validatedTarget;
+
+        } catch (Exception e) {
+            System.err.println("Error in findTargetSync: " + e.getMessage());
+            this.validatedTarget = null;
+            this.target = null;
         }
     }
 
     @Override
     public void start() {
-        this.mob.setTarget(this.target, this.target instanceof ServerPlayer ? org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_PLAYER : org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_ENTITY, true); // CraftBukkit - reason
+        // Use the validated target found in canUse() or findTargetSync()
+        this.target = this.validatedTarget; // Update the actual target field
+        LivingEntity targetEntity = this.target;
+        if (targetEntity != null && !targetEntity.isRemoved() && targetEntity.isAlive()) {
+            try {
+                this.mob.setTarget(targetEntity, targetEntity instanceof ServerPlayer ?
+                    org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_PLAYER :
+                    org.bukkit.event.entity.EntityTargetEvent.TargetReason.CLOSEST_ENTITY, true); // CraftBukkit - reason
+            } catch (Exception e) {
+                System.err.println("Error in setTarget: " + e.getMessage());
+                this.target = null; // Clear target on error
+                this.validatedTarget = null;
+            }
+        }
         super.start();
     }
 
+    // Keep original setTarget method if needed externally
     public void setTarget(@Nullable LivingEntity target) {
+        // Note: This bypasses the async validation logic. Use with caution.
         this.target = target;
+        this.validatedTarget = target; // Assume it's valid if set externally
+        this.pendingTarget.set(null); // Clear pending if set manually
+    }
+
+    public TargetingConditions getTargetConditions() {
+        // Create a new instance or update the existing one to refresh the range
+        // Creating new is safer if TargetingConditions is mutable internally regarding range
+        return TargetingConditions.forCombat().range(this.getFollowDistance()).selector(this.originalSelector);
     }
 
-    private TargetingConditions getTargetConditions() {
-        return this.targetConditions.range(this.getFollowDistance());
+    @Override
+    public void stop() {
+        this.target = null;
+        this.validatedTarget = null;
+        this.pendingTarget.set(null);
+        super.stop();
     }
 }
