@@ -232,29 +267,100 @@ public abstract class AbstractContainerMenu {
 
     public void broadcastChanges() {
         for (int i = 0; i < this.slots.size(); i++) {
-            ItemStack item = this.slots.get(i).getItem();
-            Supplier<ItemStack> supplier = Suppliers.memoize(item::copy);
-            this.triggerSlotListeners(i, item, supplier);
-            this.synchronizeSlotToRemote(i, item, supplier);
+            ItemStack currentItemInSlot = this.slots.get(i).getItem();
+            // Supplier that captures a copy of currentItemInSlot at this moment for listeners
+            Supplier<ItemStack> currentItemCopierForListener = Suppliers.memoize(currentItemInSlot::copy);
+
+            this.triggerSlotListeners(i, currentItemInSlot, currentItemCopierForListener);
+
+            // Asynchronous synchronization path
+            if (AsyncContainerUpdates.enabled && !this.suppressRemoteUpdates && this.synchronizer != null) {
+                final int slotIndex = i;
+                // Capture the snapshot of the item for async processing.
+                // If currentItemInSlot is EMPTY, captured can be EMPTY directly.
+                final ItemStack capturedSlotItemSnapshot = currentItemInSlot.isEmpty() ? ItemStack.EMPTY : currentItemInSlot.copy();
+
+                CompletableFuture.runAsync(() -> {
+                    // Re-check suppressRemoteUpdates in async task as it could change
+                    // Also re-check synchronizer as it's used for sending
+                    if (this.suppressRemoteUpdates || this.synchronizer == null) return;
+ 
+                    ItemStack remoteSlotItem = this.remoteSlots.get(slotIndex);
+                    // Compare remote state with the captured snapshot
+                    if (!this.matchesRemote(remoteSlotItem, capturedSlotItemSnapshot)) {
+                        // If different, create a new copy from the snapshot to set and send
+                        // This mirrors the original logic where supplier.get() creates a new copy
+                        ItemStack itemToSetAndSend = capturedSlotItemSnapshot.copy();
+                        this.remoteSlots.set(slotIndex, itemToSetAndSend);
+                        this.synchronizer.sendSlotChange(this, slotIndex, itemToSetAndSend);
+                    }
+                }, ASYNC_TASK_EXECUTOR);
+            } else {
+                // Synchronous path: call original method with a fresh supplier based on the current live item
+                this.synchronizeSlotToRemote(i, currentItemInSlot, currentItemCopierForListener);
+            }
         }
 
-        this.synchronizeCarriedToRemote();
+        // Carried item update
+        if (AsyncContainerUpdates.enabled && !this.suppressRemoteUpdates && this.synchronizer != null) {
+            final ItemStack currentCarried = this.getCarried(); // Get live carried item
+            // Capture a snapshot of the carried item for async processing
+            final ItemStack snapshotOfCarried = currentCarried.isEmpty() ? ItemStack.EMPTY : currentCarried.copy();
+
+            CompletableFuture.runAsync(() -> {
+                // Re-check suppressRemoteUpdates and synchronizer
+                if (this.suppressRemoteUpdates || this.synchronizer == null) return;
+ 
+                // Perform comparison using the snapshot against the current remoteCarried
+                final boolean matchResult = org.dreeam.leaf.config.modules.gameplay.HideItemComponent.enabled
+                    ? !org.dreeam.leaf.util.item.ItemStackStripper.matchesStripped(snapshotOfCarried, this.remoteCarried)
+                    : !this.matchesRemote(snapshotOfCarried, this.remoteCarried);
+
+                if (matchResult) {
+                    // If different, create a new copy from the snapshot to be the new remoteCarried and send it
+                    ItemStack newRemoteCarried = snapshotOfCarried.copy();
+                    this.remoteCarried = newRemoteCarried;
+                    this.synchronizer.sendCarriedChange(this, newRemoteCarried);
+                }
+            }, ASYNC_TASK_EXECUTOR);
+        } else {
+            // Synchronous path: call original method
+            this.synchronizeCarriedToRemote();
+        }
 
+        // Data slot updates
         for (int i = 0; i < this.dataSlots.size(); i++) {
             DataSlot dataSlot = this.dataSlots.get(i);
-            int i1 = dataSlot.get();
+            int currentValue = dataSlot.get();
             if (dataSlot.checkAndClearUpdateFlag()) {
-                this.updateDataSlotListeners(i, i1);
+                this.updateDataSlotListeners(i, currentValue); // Notify listeners synchronously
             }
 
-            this.synchronizeDataSlotToRemote(i, i1);
+            if (AsyncContainerUpdates.enabled && !this.suppressRemoteUpdates && this.synchronizer != null) {
+                final int dataSlotIndex = i;
+                final int capturedValue = currentValue; // int is a value type, so this is a copy
+
+                CompletableFuture.runAsync(() -> {
+                    // Re-check suppressRemoteUpdates and synchronizer
+                    if (this.suppressRemoteUpdates || this.synchronizer == null) return;
+ 
+                    int remoteIntValue = this.remoteDataSlots.getInt(dataSlotIndex);
+                    if (remoteIntValue != capturedValue) {
+                        this.remoteDataSlots.set(dataSlotIndex, capturedValue);
+                        this.synchronizer.sendDataChange(this, dataSlotIndex, capturedValue);
+                    }
+                }, ASYNC_TASK_EXECUTOR);
+            } else {
+                // Synchronous path: call original method
+                this.synchronizeDataSlotToRemote(i, currentValue);
+            }
         }
     }
 
     public void broadcastFullState() {
         for (int i = 0; i < this.slots.size(); i++) {
             ItemStack item = this.slots.get(i).getItem();
-            this.triggerSlotListeners(i, item, item::copy);
+            this.triggerSlotListeners(i, item, Suppliers.memoize(item::copy));
         }
 
         for (int i = 0; i < this.dataSlots.size(); i++) {
