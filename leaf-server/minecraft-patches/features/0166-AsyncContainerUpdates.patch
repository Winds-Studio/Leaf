@@ -93,6 +101,33 @@ public abstract class AbstractContainerMenu {
     public void startOpen() {}
     // CraftBukkit end
     public Throwable containerCreationStacktrace; // SparklyPaper - parallel world ticking (debugging)
+    private static final ExecutorService ASYNC_TASK_EXECUTOR;
+
+    static {
+        ExecutorService selectedExecutor = Util.backgroundExecutor().service();
+
+        // Only attempt to use virtual threads if async updates are enabled AND configured to attempt VTs
+        if (AsyncContainerUpdates.enabled && AsyncContainerUpdates.attemptVirtualThreads) {
+            VirtualThreadService vts = VirtualThreadService.get();
+            if (vts != null) {
+                try {
+                    ThreadFactory virtualThreadFactory = vts.createFactory();
+                    Thread testThread = virtualThreadFactory.newThread(() -> {});
+                    if (testThread.isVirtual()) {selectedExecutor = Executors.newThreadPerTaskExecutor(virtualThreadFactory);
+                    } else {
+                         LOGGER.warn("Async Container Updates: VirtualThreadService factory did not produce a virtual thread as expected. Falling back to platform threads.");
+                    }
+                } catch (Throwable t) {
+                    LOGGER.warn("Async Container Updates: Error initializing virtual thread executor. Falling back to platform threads.", t);
+                }
+            } else {
+                LOGGER.info("Async Container Updates: Virtual threads not supported by the runtime. Using platform threads for async container updates (if enabled).");
+            }
+        } else if (AsyncContainerUpdates.enabled) {
+            LOGGER.info("Async Container Updates: Configured to use platform threads for async container updates (if enabled).");
+        }
+        ASYNC_TASK_EXECUTOR = selectedExecutor;
+    }
 
     protected AbstractContainerMenu(@Nullable MenuType<?> menuType, int containerId) {
