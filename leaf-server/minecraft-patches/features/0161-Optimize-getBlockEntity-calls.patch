     public Map<BlockPos, BlockEntity> getBlockEntities() {
-        return this.blockEntities;
+        // Build map dynamically from section arrays and pending NBT
+        Map<BlockPos, BlockEntity> map = Maps.newHashMap();
+        for (LevelChunkSection section : this.sections) {
+            if (section != null) { // Check if section itself is null
+                BlockEntity[] sectionEntities = section.getBlockEntityArray();
+                if (sectionEntities != null) {
+                    for (BlockEntity blockEntity : sectionEntities) {
+                        if (blockEntity != null && !blockEntity.isRemoved()) {
+                            map.put(blockEntity.getBlockPos(), blockEntity);
+                        }
+                    }
+                }
+            }
+        }
+
+        // Add pending entities that might not have been promoted yet
+        for (Map.Entry<BlockPos, CompoundTag> entry : this.pendingBlockEntities.entrySet()) {
+            BlockPos pos = entry.getKey();
+            if (!map.containsKey(pos)) { // Only add if not already present as a loaded BE
+                CompoundTag tag = entry.getValue();
+                if (tag != null) {
+                    // Attempt to promote - this might return null but we still need the NBT represented
+                    // We cannot fully create the BE here as it might cause issues,
+                    // but getBlockEntities() needs to represent its *potential* existence.
+                    // This part is tricky - returning a placeholder might be wrong.
+                    // Perhaps getBlockEntities() should only return fully loaded entities?
+                    // Let's stick to only loaded entities for now.
+                    BlockEntity be = this.promotePendingBlockEntity(pos, tag);
+                    if (be != null && !be.isRemoved()) {
+                        map.put(pos, be);
+                    }
+                }
+            }
+        }
+
+        // Ensure the inherited map is cleared (if it wasn't already empty)
+        // This prevents stale data if other code accidentally uses it.
+        this.blockEntities.clear();
+
+        return Collections.unmodifiableMap(map);
     }
 
