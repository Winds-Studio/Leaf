From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Tue, 9 Nov 2077 00:00:00 +0800
Subject: [PATCH] Short-circuit isOnFire checks

Reorder checks to short-circuit earlier and skip client-side checks.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 3abef66dc0558b5fede9362d01ca8a01068f9c77..c29650a3ef509157619209178c5d7df4062aceb8 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -3839,8 +3839,10 @@ public abstract class Entity
     }
 
     public boolean isOnFire() {
-        boolean isClientSide = this.level() != null && this.level().isClientSide();
-        return !this.fireImmune() && (this.remainingFireTicks > 0 || isClientSide && this.getSharedFlag(FLAG_ONFIRE));
+        // Leaf start - Short-circuit isOnFire checks
+        //boolean isClientSide = this.level() != null && this.level().isClientSide();
+        return (this.remainingFireTicks > 0 /*|| isClientSide && this.getSharedFlag(FLAG_ONFIRE)*/) && !this.fireImmune();
+        // Leaf end - Short-circuit isOnFire checks
     }
 
     public boolean isPassenger() {
