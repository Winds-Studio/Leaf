From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: muwenyan521 <119822522+muwenyan521@users.noreply.github.com>
Date: Sun, 11 Oct 2026 01:26:56 +0800
Subject: [PATCH] Fix Lithium hopper amount


diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 537d9a91ae5b9a54ee69cbafc90d5ce21c80b3b9..e89e930b1ac30c17e09a9bdf43f266780f078b44 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -1588,20 +1588,38 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
                     }
                 }
                 //calling removeStack is necessary due to its side effects (markDirty in LootableContainerBlockEntity)
-                ItemStack takenItem = from.removeItem(fromSlot, 1);
+                int transferCount = Math.min(world.spigotConfig.hopperAmount, itemStack.getCount());
+                ItemStack takenItem = from.removeItem(fromSlot, transferCount);
                 assert !takenItem.isEmpty();
-                boolean transferSuccess = net.caffeinemc.mods.lithium.common.hopper.HopperHelper.tryMoveSingleItem(to, takenItem, null);
-                if (transferSuccess) {
+                int takenCount = takenItem.getCount();
+                int remainingCount = takenCount;
+                while (remainingCount > 0) {
+                    ItemStack singleItem = takenItem.copyWithCount(1);
+                    if (!net.caffeinemc.mods.lithium.common.hopper.HopperHelper.tryMoveSingleItem(to, singleItem, null)) {
+                        break;
+                    }
+                    remainingCount--;
+                }
+                if (remainingCount < takenCount) {
+                    if (remainingCount > 0) {
+                        ItemStack restoredStack = fromStackList.get(fromSlot);
+                        if (restoredStack.isEmpty()) {
+                            restoredStack = takenItem.copyWithCount(remainingCount);
+                        } else {
+                            restoredStack.grow(remainingCount);
+                        }
+                        //calling setStack is necessary due to its side effects (markDirty in LootableContainerBlockEntity)
+                        from.setItem(fromSlot, restoredStack);
+                    }
                     to.setChanged();
                     from.setChanged();
                     return true;
                 }
-                //put the item back similar to vanilla
                 ItemStack restoredStack = fromStackList.get(fromSlot);
                 if (restoredStack.isEmpty()) {
                     restoredStack = takenItem;
                 } else {
-                    restoredStack.grow(1);
+                    restoredStack.grow(takenCount);
                 }
                 //calling setStack is necessary due to its side effects (markDirty in LootableContainerBlockEntity)
                 from.setItem(fromSlot, restoredStack);
