From: Manere <133597204+Manered@users.noreply.github.com>
Date: Sat, 25 Apr 2026 22:20:28 +0200
Subject: [PATCH] disable world data saving

Skip persistence for worlds in misc.disable-world-data-saving.worlds (leaf-global.yml):
ServerLevel full and incremental saves, and Moonrise chunk/entity/POI writes (including unload).
Shutdown closes the chunk system without flushing saves.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/NewChunkHolder.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/NewChunkHolder.java
index 7a0006f9b56d1e43b06f9f7452e1b5bb0ec53e72..d651e131f5a6cf5e566af50b15694b0cc0c0c6b0 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/NewChunkHolder.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/NewChunkHolder.java
@@ -1708,6 +1708,14 @@ public final class NewChunkHolder {
     });
 
     private boolean saveChunk(final ChunkAccess chunk, final boolean unloading, final Completable<CompoundTag>[] chunkSave) {
+        // Leaf start - disable world data saving
+        if (org.dreeam.leaf.config.modules.misc.DisableWorldDataSaving.shouldSkipSave(this.world)) {
+            if (chunk.isUnsaved()) {
+                chunk.tryMarkSaved();
+            }
+            return false;
+        }
+        // Leaf end - disable world data saving
         if (!chunk.isUnsaved()) {
             return false;
         }
@@ -1765,6 +1773,7 @@ public final class NewChunkHolder {
 
     private boolean lastEntitySaveNull;
     private boolean saveEntities(final ChunkEntitySlices entities, final boolean unloading, final Completable<CompoundTag>[] entitySave) {
+        if (org.dreeam.leaf.config.modules.misc.DisableWorldDataSaving.shouldSkipSave(this.world)) return false; // Leaf - disable world data saving
         try {
             if (entities.isTransient()) {
                 if (!unloading) {
@@ -1821,6 +1830,14 @@ public final class NewChunkHolder {
 
     private boolean lastPoiSaveNull;
     private boolean savePOI(final PoiChunk poi, final boolean unloading, final Completable<CompoundTag>[] poiSave) {
+        // Leaf start - disable world data saving
+        if (org.dreeam.leaf.config.modules.misc.DisableWorldDataSaving.shouldSkipSave(this.world)) {
+            if (poi.isDirty()) {
+                poi.setDirty(false);
+            }
+            return false;
+        }
+        // Leaf end - disable world data saving
         try {
             final CompoundTag save = poi.save();
             poi.setDirty(false);
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index aaf031daf62f5c832f9c11f9d1cbd28117dc076a..02f0d56bcf0fd48a48058895a0ac3c654ab0510c 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1753,6 +1753,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     }
     // Paper start - Incremental chunk and player saving
     public void saveIncrementally(final boolean doFull) {
+        if (org.dreeam.leaf.config.modules.misc.DisableWorldDataSaving.shouldSkipSave(this)) return; // Leaf - disable world data saving
         if (doFull) {
             org.bukkit.Bukkit.getPluginManager().callEvent(new org.bukkit.event.world.WorldSaveEvent(this.getWorld()));
             this.saveLevelData(false);
@@ -1768,6 +1769,18 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public void save(final @Nullable ProgressListener progressListener, final boolean flush, final boolean noSave, final boolean close) {
         // Paper end - add close param
         ServerChunkCache chunkSource = this.getChunkSource();
+        // Leaf start - disable world data saving
+        if (org.dreeam.leaf.config.modules.misc.DisableWorldDataSaving.shouldSkipSave(this)) {
+            if (close) {
+                try {
+                    chunkSource.close(false);
+                } catch (IOException never) {
+                    throw new RuntimeException(never);
+                }
+            }
+            return;
+        }
+        // Leaf end - disable world data saving
         if (!noSave) {
             new org.bukkit.event.world.WorldSaveEvent(this.getWorld()).callEvent(); // CraftBukkit
             if (progressListener != null) {
