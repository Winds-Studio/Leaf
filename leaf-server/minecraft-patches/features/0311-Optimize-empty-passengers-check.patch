@@ -251,6 +251,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     private int id = ENTITY_COUNTER.incrementAndGet();
     public boolean blocksBuilding;
     public ImmutableList<Entity> passengers = ImmutableList.of();
+    public static final ImmutableList<Entity> EMPTY_PASSENGERS = ImmutableList.of(); // Leaf - Optimize empty passengers check
     protected int boardingCooldown;
     private @Nullable Entity vehicle;
     private Level level;
@@ -477,7 +478,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
 
     @Override
     public final boolean moonrise$hasAnyPlayerPassengers() {
-        if (this.passengers.isEmpty()) {
