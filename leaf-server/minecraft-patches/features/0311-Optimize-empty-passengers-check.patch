             return false;
         }
         return this.getIndirectPassengersStream().anyMatch((entity) -> entity instanceof Player);
@@ -3513,7 +3514,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         if (passenger.getVehicle() != this) {
             throw new IllegalStateException("Use x.startRiding(y), not y.addPassenger(x)");
         } else {
-            if (this.passengers.isEmpty()) {
+            if (this.passengers == Entity.EMPTY_PASSENGERS) { // Leaf - Optimize empty passengers check
                 this.passengers = ImmutableList.of(passenger);
             } else {
                 List<Entity> list = Lists.newArrayList(this.passengers);
@@ -3592,7 +3593,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     }
 
     protected boolean canAddPassenger(Entity passenger) {
-        return this.passengers.isEmpty();
+        return this.passengers == Entity.EMPTY_PASSENGERS; // Leaf - Optimize empty passengers check
     }
 
     protected boolean couldAcceptPassenger() {
@@ -3780,7 +3781,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     }
 
     public boolean isVehicle() {
-        return !this.passengers.isEmpty();
+        return this.passengers != Entity.EMPTY_PASSENGERS; // Leaf - Optimize empty passengers check
     }
 
     public boolean dismountsUnderwater() {
@@ -4789,11 +4790,11 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     }
 
     public @Nullable Entity getFirstPassenger() {
-        return this.passengers.isEmpty() ? null : this.passengers.get(0);
+        return this.passengers == Entity.EMPTY_PASSENGERS ? null : this.passengers.get(0); // Leaf - Optimize empty passengers check
     }
 
     public boolean hasPassenger(Entity entity) {
-        return !passengers.isEmpty() && this.passengers.contains(entity); // Leaf - Optimize map lookups with isEmpty check
+        return passengers != Entity.EMPTY_PASSENGERS && this.passengers.contains(entity); // Leaf - Optimize empty passengers check
     }
 
     public boolean hasPassenger(Predicate<Entity> predicate) {
@@ -4807,19 +4808,19 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     }
 
     private Stream<Entity> getIndirectPassengersStream() {
-        if (this.passengers.isEmpty()) { return Stream.of(); } // Paper - Optimize indirect passenger iteration
+        if (this.passengers == Entity.EMPTY_PASSENGERS) { return Stream.of(); } // Paper - Optimize indirect passenger iteration // Leaf - Optimize empty passengers check
         return this.passengers.stream().flatMap(Entity::getSelfAndPassengers);
     }
 
     @Override
     public Stream<Entity> getSelfAndPassengers() {
-        if (this.passengers.isEmpty()) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration
+        if (this.passengers == Entity.EMPTY_PASSENGERS) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration // Leaf - Optimize empty passengers check
         return Stream.concat(Stream.of(this), this.getIndirectPassengersStream());
     }
 
     @Override
     public Stream<Entity> getPassengersAndSelf() {
-        if (this.passengers.isEmpty()) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration
+        if (this.passengers == Entity.EMPTY_PASSENGERS) { return Stream.of(this); } // Paper - Optimize indirect passenger iteration // Leaf - Optimize empty passengers check
         return Stream.concat(this.passengers.stream().flatMap(Entity::getPassengersAndSelf), Stream.of(this));
     }
 
@@ -4827,7 +4828,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         // Paper start - optimise entity tracker
         final List<Entity> ret = new ArrayList<>();
 
-        if (this.passengers.isEmpty()) {
+        if (this.passengers == Entity.EMPTY_PASSENGERS) { // Leaf - Optimize empty passengers check
             return ret;
         }
 
@@ -4842,7 +4843,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     }
 
     public boolean hasExactlyOnePlayerPassenger() {
-        if (this.passengers.isEmpty()) { return false; } // Paper - Optimize indirect passenger iteration
+        if (this.passengers == Entity.EMPTY_PASSENGERS) { return false; } // Paper - Optimize indirect passenger iteration // Leaf - Optimize empty passengers check
         return this.countPlayerPassengers() == 1;
     }
 
