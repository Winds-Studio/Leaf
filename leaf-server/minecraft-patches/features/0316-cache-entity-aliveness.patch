Subject: [PATCH] cache entity aliveness


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index a9e39e90216a057fc2ea3f2650bb78f81f790a80..1213f2251e28ed9db53d42fa782a642cf34128f3 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -502,6 +502,8 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         this.bukkitPickUpLoot = true;
         this.maxHealthCache = this.getMaxHealth();
         // CraftBukkit end
+        getHealth(); // Leaf - cache entity aliveness
+        leaf$onAliveDirty(); // Leaf - cache entity aliveness
     }
 
     @Override
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 42b99ddade93be2901199fae53161a4942062a03..1943fd6d5974944b539b9f67ab2fd4ea1461abfd 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -403,6 +403,7 @@ public abstract class Entity
     public long activatedTick = Integer.MIN_VALUE;
     public boolean isTemporarilyActive;
     public long activatedImmunityTick = Integer.MIN_VALUE;
+    public boolean leaf$isAlive = true; // Leaf - cache entity aliveness
 
     public void inactiveTick() {
     }
@@ -5620,6 +5621,7 @@ public abstract class Entity
             this.removalReason = reason;
             this.removeEventCause = cause; // Paper
         }
+        this.leaf$onAliveDirty(); // Leaf - cache entity aliveness
 
         if (this.removalReason.shouldDestroy()) {
             this.stopRiding();
@@ -5642,6 +5644,7 @@ public abstract class Entity
         this.removeEventCause = null;
         this.pluginRemoved = false;
         // Paper end
+        this.leaf$onAliveDirty(); // Leaf - cache entity aliveness
     }
 
     // Paper start - Folia schedulers
@@ -5906,6 +5909,18 @@ public abstract class Entity
     @Nullable
     private Player rider = null;
 
+
+    // Leaf start - cache entity aliveness
+    /// player need initialized bukkit entity
+    ///
+    /// see [LivingEntity#LivingEntity(EntityType, Level)]
+    public final void leaf$onAliveDirty() {
+        if (!(this instanceof ServerPlayer) || this.getBukkitEntityRaw() != null) {
+            this.leaf$isAlive = this.isAlive();
+        }
+    }
+    // Leaf end - cache entity aliveness
+
     @Nullable
     public Player getRider() {
         return rider;
diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 1fb657e90e7b27d0eb66f369f1711a298489fb1e..2cac690da5430838970e72b8bb56d4d887646e03 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -1957,6 +1957,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                     this.dead = false;
                     this.postDeathEventTasks.clear();
                     this.setHealth((float) deathEvent.getReviveHealth());
+                    this.leaf$onAliveDirty(); // Leaf - cache entity aliveness
                     return;
                 }
 
@@ -1979,6 +1980,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
 
     protected void handleKillingBlow() {
         this.dead = true;
+        this.leaf$onAliveDirty(); // Leaf - cache entity aliveness
     }
 
     protected void createWitherRose(final @Nullable LivingEntity killer) {
@@ -4496,7 +4498,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 this.eatStartTime = -1L;
                 // Paper end - lag compensate eating
             }
-        }
+        } else if (DATA_HEALTH_ID.equals(accessor)) { this.leaf$onAliveDirty(); } // Leaf - cache entity aliveness
     }
 
     @Override
diff --git a/net/minecraft/world/entity/monster/Creeper.java b/net/minecraft/world/entity/monster/Creeper.java
index 4127adba5d5efe4c2a85055ea478c8c946d920f3..0314d2c9d13fcf9b5b5e372287cdd0e2175f0cb6 100644
--- a/net/minecraft/world/entity/monster/Creeper.java
