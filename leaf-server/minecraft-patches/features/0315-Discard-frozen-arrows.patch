+    public void leaf$clearWeakEntities() {
+        for (int i = 0, size = this.weakEntityList.size(); i < size; i++) {
+            this.weakEntityList.get(i).leaf$isWeakLoaded = false;
+        }
+        this.weakEntityList.clear();
