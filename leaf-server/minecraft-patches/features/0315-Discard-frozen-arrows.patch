     }
 
+    // Leaf start - Discard frozen arrows
+    @Override
+    public boolean leaf$shouldDiscardOnUnload() {
+        org.dreeam.leaf.config.modules.fixes.DiscardFrozenArrows.Mode mode = org.dreeam.leaf.config.modules.fixes.DiscardFrozenArrows.mode;
+        if (mode == org.dreeam.leaf.config.modules.fixes.DiscardFrozenArrows.Mode.OFF || this instanceof ThrownTrident) {
+            return false;
+        }
+        if (this.pickup != AbstractArrow.Pickup.ALLOWED) {
+            return true;
+        }
+        return mode == org.dreeam.leaf.config.modules.fixes.DiscardFrozenArrows.Mode.UNPICKABLE_AND_IN_FLIGHT && !this.isInGround() && !this.isNoPhysics();
+    }
+
+    @Override
+    public boolean shouldBeSaved() {
+        if (!super.shouldBeSaved()) {
+            return false;
+        }
+        if (!this.leaf$shouldDiscardOnUnload()) {
+            return true;
+        }
+        final net.minecraft.server.level.FullChunkStatus status = this.moonrise$getChunkStatus();
+        return status != null && status.isOrAfter(net.minecraft.server.level.FullChunkStatus.ENTITY_TICKING);
+    }
+    // Leaf end - Discard frozen arrows
+
     @Override
