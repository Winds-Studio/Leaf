From: MrlingXD <90316914+wling-art@users.noreply.github.com>
Date: Sat, 8 Aug 2026 04:12:31 +0800
Subject: [PATCH] Short-circuit InventoryChangeTrigger without listeners

Skip the full inventory slot scan when the player has no
pending advancement listener for this trigger.

diff --git a/net/minecraft/advancements/triggers/InventoryChangeTrigger.java b/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
index db51d57ea1333d2f5c839a8a4df05e276fb15acd..5d46b283c3cb441485b74e0e30968986d83fb9f8 100644
--- a/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
+++ b/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
@@ -24,6 +24,13 @@ public class InventoryChangeTrigger extends SimpleCriterionTrigger<InventoryChan
     }
 
     public void trigger(final ServerPlayer player, final Inventory inventory, final ItemStack changedItem) {
+        // Leaf start - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+        var listeners = player.getAdvancements().getTriggerMapForType(this);
+        if (listeners == null || listeners.isEmpty()) {
+            return;
+        }
+        // Leaf end - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+
         int slotsFull = 0;
         int slotsEmpty = 0;
         int slotsOccupied = 0;
