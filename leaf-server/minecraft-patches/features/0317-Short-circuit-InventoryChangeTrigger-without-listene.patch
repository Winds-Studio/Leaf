From: MrlingXD <90316914+wling-art@users.noreply.github.com>
Date: Sat, 8 Aug 2026 04:12:31 +0800
Subject: [PATCH] Short-circuit InventoryChangeTrigger without listeners

Skip the full inventory slot scan when the player has no
pending advancement listener for this trigger.

diff --git a/net/minecraft/advancements/triggers/InventoryChangeTrigger.java b/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
index db51d57ea1333d2f5c839a8a4df05e276fb15acd..a17e9acff9be836d2aa3886686dd3f1514417665 100644
--- a/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
+++ b/net/minecraft/advancements/triggers/InventoryChangeTrigger.java
@@ -24,6 +24,13 @@ public class InventoryChangeTrigger extends SimpleCriterionTrigger<InventoryChan
     }
 
     public void trigger(final ServerPlayer player, final Inventory inventory, final ItemStack changedItem) {
+        // Leaf start - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+        var listeners = player.getAdvancements().getTriggerMapForType(this);
+        if (listeners == null || listeners.isEmpty()) {
+            return;
+        }
+        // Leaf end - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+
         int slotsFull = 0;
         int slotsEmpty = 0;
         int slotsOccupied = 0;
@@ -40,7 +47,7 @@ public class InventoryChangeTrigger extends SimpleCriterionTrigger<InventoryChan
             }
         }
 
-        this.trigger(player, inventory, changedItem, slotsFull, slotsEmpty, slotsOccupied);
+        this.trigger(player, inventory, changedItem, slotsFull, slotsEmpty, slotsOccupied, listeners);  // Leaf - skip slot scan when nobody has a pending InventoryChangeTrigger listener
     }
 
     private void trigger(
@@ -49,6 +56,14 @@ public class InventoryChangeTrigger extends SimpleCriterionTrigger<InventoryChan
         this.trigger(player, t -> t.matches(inventory, changedItem, slotsFull, slotsEmpty, slotsOccupied));
     }
 
+    // Leaf start - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+    private void trigger(
+        final ServerPlayer player, final Inventory inventory, final ItemStack changedItem, final int slotsFull, final int slotsEmpty, final int slotsOccupied, final java.util.Map<net.minecraft.server.PlayerAdvancements.TriggerInstanceKey, InventoryChangeTrigger.TriggerInstance> listeners
+    ) {
+        this.trigger(player, t -> t.matches(inventory, changedItem, slotsFull, slotsEmpty, slotsOccupied), listeners);
+    }
+    // Leaf end - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+
     public record TriggerInstance(
         @Override Optional<ContextAwarePredicate> player, InventoryChangeTrigger.TriggerInstance.Slots slots, List<ItemPredicate> items
     ) implements SimpleCriterionTrigger.SimpleInstance {
diff --git a/net/minecraft/advancements/triggers/SimpleCriterionTrigger.java b/net/minecraft/advancements/triggers/SimpleCriterionTrigger.java
index d76a338ab4f326e6105adc451eee3d4601403c98..4926a3d0324c217eef1e6b1db01315ea8707cdae 100644
--- a/net/minecraft/advancements/triggers/SimpleCriterionTrigger.java
+++ b/net/minecraft/advancements/triggers/SimpleCriterionTrigger.java
@@ -19,6 +19,12 @@ public abstract class SimpleCriterionTrigger<T extends SimpleCriterionTrigger.Si
     protected void trigger(final ServerPlayer player, final Predicate<T> matcher) {
         PlayerAdvancements advancements = player.getAdvancements();
         Map<PlayerAdvancements.TriggerInstanceKey, T> listenersForType = advancements.getTriggerMapForType(this);
+        // Leaf start - skip slot scan when nobody has a pending InventoryChangeTrigger listener
+        this.trigger(player, matcher, listenersForType);
+    }
+    protected void trigger(final ServerPlayer player, final Predicate<T> matcher, final @org.jspecify.annotations.Nullable Map<PlayerAdvancements.TriggerInstanceKey, T> listenersForType) {
+        PlayerAdvancements advancements = player.getAdvancements();
+        // Leaf end - skip slot scan when nobody has a pending InventoryChangeTrigger listener
         if (listenersForType != null && !listenersForType.isEmpty()) {
             LootContext playerContext = null; // EntityPredicate.createContext(player, player); // Paper - Perf: lazily create LootContext for criterions
             List<PlayerAdvancements.TriggerInstanceKey> matchedConditions = null;
