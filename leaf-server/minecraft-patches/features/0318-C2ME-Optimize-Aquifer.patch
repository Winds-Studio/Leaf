+            Aquifer.FluidStatus closestStatus2 = this.getAquiferStatus(c2me$unpackPosIdx(this.c2me$packed2));
+            double barrier12 = similarity12 * this.c2me$calculatePressure(blockX, blockY, blockZ, closestStatus1, closestStatus2);
+            if (density + barrier12 > 0.0) {
+                this.shouldScheduleFluidUpdate = false;
+                return null;
+            }
+
+            Aquifer.FluidStatus closestStatus3 = this.getAquiferStatus(c2me$unpackPosIdx(this.c2me$packed3));
+            int dist1 = c2me$unpackDist(this.c2me$packed1);
+            int dist2 = c2me$unpackDist(this.c2me$packed2);
+            int dist3 = c2me$unpackDist(this.c2me$packed3);
+            double similarity13 = similarity(dist1, dist3);
+            if (this.c2me$checkBarrier(blockX, blockY, blockZ, density, similarity12, similarity13, closestStatus1, closestStatus3)) {
+                return null;
+            }
+
+            double similarity23 = similarity(dist2, dist3);
+            if (this.c2me$checkBarrier(blockX, blockY, blockZ, density, similarity12, similarity23, closestStatus2, closestStatus3)) {
+                return null;
+            }
+
+            boolean mayFlow12 = !closestStatus1.equals(closestStatus2);
+            boolean mayFlow23 = similarity23 >= FLOWING_UPDATE_SIMULARITY && !closestStatus2.equals(closestStatus3);
+            boolean mayFlow13 = similarity13 >= FLOWING_UPDATE_SIMULARITY && !closestStatus1.equals(closestStatus3);
+            if (!mayFlow12 && !mayFlow23 && !mayFlow13) {
+                this.shouldScheduleFluidUpdate = similarity13 >= FLOWING_UPDATE_SIMULARITY
+                    && similarity(dist1, c2me$unpackDist(this.c2me$packed4)) >= FLOWING_UPDATE_SIMULARITY
+                    && !closestStatus1.equals(this.getAquiferStatus(c2me$unpackPosIdx(this.c2me$packed4)));
+            } else {
+                this.shouldScheduleFluidUpdate = true;
+            }
+
+            return actualFluidState;
+        }
