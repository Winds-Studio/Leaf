+        private @Nullable BlockState c2me$computeSubstancePost(final int blockX, final int blockY, final int blockZ, final double density) {
+            Aquifer.FluidStatus closestStatus1 = this.getAquiferStatus(c2me$unpackPosIdx(this.c2me$packed1));
+            double similarity12 = similarity(c2me$unpackDist(this.c2me$packed1), c2me$unpackDist(this.c2me$packed2));
+            BlockState fluidState = closestStatus1.at(blockY);
+            BlockState actualFluidState = SharedConstants.DEBUG_DISABLE_FLUID_GENERATION ? Blocks.AIR.defaultBlockState() : fluidState;
+            if (similarity12 <= 0.0) {
+                if (similarity12 >= FLOWING_UPDATE_SIMULARITY) {
+                    Aquifer.FluidStatus closestStatus2 = this.getAquiferStatus(c2me$unpackPosIdx(this.c2me$packed2));
+                    this.shouldScheduleFluidUpdate = !closestStatus1.equals(closestStatus2);
+                } else {
+                    this.shouldScheduleFluidUpdate = false;
+                }
+
+                return actualFluidState;
+            } else if (fluidState.is(Blocks.WATER) && this.globalFluidPicker.computeFluid(blockX, blockY - 1, blockZ).at(blockY - 1).is(Blocks.LAVA)) {
+                this.shouldScheduleFluidUpdate = true;
+                return actualFluidState;
+            }
+
