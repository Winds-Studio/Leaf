+        private boolean c2me$checkBarrier(
+            final int blockX, final int blockY, final int blockZ, final double density,
+            final double similarity12, final double similarity, final Aquifer.FluidStatus statusA, final Aquifer.FluidStatus statusB
+        ) {
+            if (similarity > 0.0) {
+                double barrier = similarity12 * similarity * this.c2me$calculatePressure(blockX, blockY, blockZ, statusA, statusB);
+                if (density + barrier > 0.0) {
+                    this.shouldScheduleFluidUpdate = false;
+                    return true;
+                }
+            }
+            return false;
+        }
