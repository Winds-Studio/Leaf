+        private double c2me$calculatePressure(
+            final int blockX, final int blockY, final int blockZ, final Aquifer.FluidStatus statusClosest1, final Aquifer.FluidStatus statusClosest2
+        ) {
+            BlockState type1 = statusClosest1.at(blockY);
+            BlockState type2 = statusClosest2.at(blockY);
+            if ((!type1.is(Blocks.LAVA) || !type2.is(Blocks.WATER)) && (!type1.is(Blocks.WATER) || !type2.is(Blocks.LAVA))) {
+                int fluidYDiff = Math.abs(statusClosest1.fluidLevel - statusClosest2.fluidLevel);
+                if (fluidYDiff == 0) {
+                    return 0.0;
+                }
+
+                double averageFluidY = 0.5 * (statusClosest1.fluidLevel + statusClosest2.fluidLevel);
+                double gradient = c2me$pressureGradient(blockY, averageFluidY, fluidYDiff);
+                double noiseValue;
+                if (!(gradient < -2.0) && !(gradient > 2.0)) {
+                    double cached = this.c2me$mutableDoubleThingy;
+                    if (Double.isNaN(cached)) {
+                        noiseValue = this.barrierNoise.sampleValue(blockX, blockY, blockZ);
+                        this.c2me$mutableDoubleThingy = noiseValue;
+                    } else {
+                        noiseValue = cached;
+                    }
+                } else {
+                    noiseValue = 0.0;
+                }
+
+                return 2.0 * (noiseValue + gradient);
+            } else {
+                return 2.0;
+            }
+        }
+
+        private static double c2me$pressureGradient(final int blockY, final double averageFluidY, final int fluidYDiff) {
+            double howFarAboveAverageFluidPoint = blockY + 0.5 - averageFluidY;
+            double distanceFromBarrierEdgeTowardsMiddle = fluidYDiff / 2.0 - Math.abs(howFarAboveAverageFluidPoint);
+            if (howFarAboveAverageFluidPoint > 0.0) {
+                return distanceFromBarrierEdgeTowardsMiddle > 0.0 ? distanceFromBarrierEdgeTowardsMiddle / 1.5 : distanceFromBarrierEdgeTowardsMiddle / 2.5;
+            } else {
+                double centerPoint = 3.0 + distanceFromBarrierEdgeTowardsMiddle;
+                return centerPoint > 0.0 ? centerPoint / 3.0 : centerPoint / 10.0;
+            }
+        }
+
+        private static int c2me$unpackX(final int packed) {
+            return packed >> 8;
+        }
+
+        private static int c2me$unpackY(final int packed) {
+            return (packed >> 4) & 0b1111;
+        }
+
+        private static int c2me$unpackZ(final int packed) {
+            return packed & 0b1111;
+        }
+
+        private static int c2me$unpackDist(final int packed) {
+            return packed >> 20;
+        }
+
+        private static int c2me$unpackPosIdx(final int packed) {
+            return packed & 0xffff;
+        }
