+        // Branchless 4-nearest search over the 12 candidate aquifer centers. Each candidate is packed as
+        // (distSqr << 20) | (tieBreak << 16) | posIdx so a single int min/max network keeps them sorted.
+        // tieBreak = 11 - (vanilla visit order), so on equal distance the later-visited sample wins, exactly like vanilla's ">=".
+        private void c2me$refreshClosest(final int blockX, final int blockY, final int blockZ) {
+            int gridX = gridX(blockX + -5);
+            int gridY = gridY(blockY + 1);
+            int gridZ = gridZ(blockZ + -5);
+            int closest1 = Integer.MAX_VALUE;
+            int closest2 = Integer.MAX_VALUE;
+            int closest3 = Integer.MAX_VALUE;
+            int closest4 = Integer.MAX_VALUE;
+
+            for (int offY = -1; offY <= 1; ++offY) {
+                int gridYBlockBase = (gridY + offY) * 12;
+                for (int offZ = 0; offZ <= 1; ++offZ) {
+                    int gridZBlockBase = (gridZ + offZ) << 4;
+                    int visitOrderYZ = (offY + 1) * 2 + offZ;
+
+                    int leftPosIdx = this.getIndex(gridX, gridY + offY, gridZ + offZ);
+                    int leftPacked = this.c2me$packedBlockPositions[leftPosIdx];
+                    int leftDx = (gridX << 4) + c2me$unpackX(leftPacked) - blockX;
+                    int leftDy = gridYBlockBase + c2me$unpackY(leftPacked) - blockY;
+                    int leftDz = gridZBlockBase + c2me$unpackZ(leftPacked) - blockZ;
+                    int leftKey = ((leftDx * leftDx + leftDy * leftDy + leftDz * leftDz) << 20) | ((11 - visitOrderYZ) << 16) | leftPosIdx;
+
+                    int rightPosIdx = leftPosIdx + 1;
+                    int rightPacked = this.c2me$packedBlockPositions[rightPosIdx];
+                    int rightDx = ((gridX + 1) << 4) + c2me$unpackX(rightPacked) - blockX;
+                    int rightDy = gridYBlockBase + c2me$unpackY(rightPacked) - blockY;
+                    int rightDz = gridZBlockBase + c2me$unpackZ(rightPacked) - blockZ;
+                    int rightKey = ((rightDx * rightDx + rightDy * rightDy + rightDz * rightDz) << 20) | ((5 - visitOrderYZ) << 16) | rightPosIdx;
+
+                    if (leftKey <= closest4) {
+                        int n1 = Math.max(closest1, leftKey);
+                        closest1 = Math.min(closest1, leftKey);
+                        int n2 = Math.max(closest2, n1);
+                        closest2 = Math.min(closest2, n1);
+                        int n3 = Math.max(closest3, n2);
+                        closest3 = Math.min(closest3, n2);
+                        closest4 = Math.min(closest4, n3);
+                    }
+
+                    if (rightKey <= closest4) {
+                        int n1 = Math.max(closest1, rightKey);
+                        closest1 = Math.min(closest1, rightKey);
+                        int n2 = Math.max(closest2, n1);
+                        closest2 = Math.min(closest2, n1);
+                        int n3 = Math.max(closest3, n2);
+                        closest3 = Math.min(closest3, n2);
+                        closest4 = Math.min(closest4, n3);
+                    }
+                }
+            }
+
+            this.c2me$packed1 = closest1;
+            this.c2me$packed2 = closest2;
+            this.c2me$packed3 = closest3;
+            this.c2me$packed4 = closest4;
+        }
