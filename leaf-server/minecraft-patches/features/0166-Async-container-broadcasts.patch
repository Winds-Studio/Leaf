+    private static final java.util.concurrent.ExecutorService ASYNC_TASK_EXECUTOR;
+
+    static {
+        java.util.concurrent.ExecutorService selectedExecutor = net.minecraft.Util.backgroundExecutor().service();
+
+        // Only attempt to use virtual threads if async updates are enabled AND configured to attempt VTs
+        if (org.dreeam.leaf.config.modules.async.AsyncContainerUpdates.enabled && org.dreeam.leaf.config.modules.async.AsyncContainerUpdates.attemptVirtualThreads) {
+            org.galemc.gale.virtualthread.VirtualThreadService vts = org.galemc.gale.virtualthread.VirtualThreadService.get();
+            if (vts != null) {
+                try {
+                    java.util.concurrent.ThreadFactory virtualThreadFactory = vts.createFactory();
+                    Thread testThread = virtualThreadFactory.newThread(() -> {});
+                    if (testThread.isVirtual()) {selectedExecutor = java.util.concurrent.Executors.newThreadPerTaskExecutor(virtualThreadFactory);
+                    } else {
+                         LOGGER.warn("Async Container Updates: VirtualThreadService factory did not produce a virtual thread as expected. Falling back to platform threads.");
+                    }
+                } catch (Throwable t) {
+                    LOGGER.warn("Async Container Updates: Error initializing virtual thread executor. Falling back to platform threads.", t);
+                }
+            } else {
+                LOGGER.info("Async Container Updates: Virtual threads not supported by the runtime. Using platform threads for async container updates (if enabled).");
+            }
+        } else if (org.dreeam.leaf.config.modules.async.AsyncContainerUpdates.enabled) {
+            LOGGER.info("Async Container Updates: Configured to use platform threads for async container updates (if enabled).");
+        }
+        ASYNC_TASK_EXECUTOR = selectedExecutor;
+    }
 
