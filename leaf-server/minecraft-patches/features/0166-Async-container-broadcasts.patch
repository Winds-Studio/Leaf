+                final int slotIndex = i;
+                ItemStack remoteSlotItem = this.remoteSlots.get(slotIndex);
+
+                // Pre-filter: Check if an update is needed before submitting the task
+                if (!this.matchesRemote(remoteSlotItem, currentItemInSlot)) {
+                    // Capture the snapshot of the item for async processing only if an update is likely.
+                    final ItemStack capturedItemForAsync = currentItemInSlot.isEmpty() ? ItemStack.EMPTY : currentItemInSlot.copy();
+                    java.util.concurrent.CompletableFuture.runAsync(() -> {
+                        // Re-check suppressRemoteUpdates and synchronizer in async task as state could change
+                        if (this.suppressRemoteUpdates || this.synchronizer == null) return;
+
+                        // Create a new copy from the captured snapshot to set and send.
+                        // This ensures the ItemStack instance set in remoteSlots and sent is consistent
+                        // and isolated from further changes to capturedItemForAsync if it were mutable and shared.
+                        ItemStack itemToSetAndSend = capturedItemForAsync.copy();
+                        this.remoteSlots.set(slotIndex, itemToSetAndSend);
+                        this.synchronizer.sendSlotChange(this, slotIndex, itemToSetAndSend);
+                    }, ASYNC_TASK_EXECUTOR);
+                }
+            } else {
+                // Synchronous path: call original method with a fresh supplier based on the current live item
+                this.synchronizeSlotToRemote(i, currentItemInSlot, currentItemCopierForListener);
+            }
         }
 
