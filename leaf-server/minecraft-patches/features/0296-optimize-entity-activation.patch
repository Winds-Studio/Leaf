+    // Leaf start - SparklyPaper - parallel world ticking - per-call activation bounds
+    // Mirrors AABB#inflate followed by the AABB constructor's min/max normalization.
+    private static void setActivationBounds(final double[] bounds, final ActivationType type, final AABB playerBox, final double range, final double height) {
+        final double minX = playerBox.minX - range;
+        final double minY = playerBox.minY - height;
+        final double minZ = playerBox.minZ - range;
+        final double maxX = playerBox.maxX + range;
+        final double maxY = playerBox.maxY + height;
+        final double maxZ = playerBox.maxZ + range;
+        final int i = type.ordinal() * 6;
+        bounds[i] = Math.min(minX, maxX);
+        bounds[i + 1] = Math.min(minY, maxY);
+        bounds[i + 2] = Math.min(minZ, maxZ);
+        bounds[i + 3] = Math.max(minX, maxX);
+        bounds[i + 4] = Math.max(minY, maxY);
+        bounds[i + 5] = Math.max(minZ, maxZ);
+    }
+    // Leaf end - SparklyPaper - parallel world ticking - per-call activation bounds
