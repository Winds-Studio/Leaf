+        // Leaf start - optimize entity activation
+        final boolean tickMarkers = world.paperConfig().entities.markers.tick;
+        final boolean dab = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.enabled;
+        final boolean dontEnableIfInWater = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.dontEnableIfInWater;
+        final double startSq = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.startDistanceSquared;
+        final double scale = Math.pow(2.0, -org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.activationDistanceMod);
+        final int maxPriority = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.maximumActivationPrio;
+        final boolean idleTimeoutTickNearbyEntities = world.purpurConfig.idleTimeoutTickNearbyEntities;
+        final boolean ignoreSpectatorActivation = world.spigotConfig.ignoreSpectatorActivation;
+        final long currentTick = MinecraftServer.currentTick;
+        it.unimi.dsi.fastutil.ints.IntOpenHashSet reset = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
+        // Leaf end - optimize entity activation
         final AABB[] activationBoxes = new AABB[ACTIVATION_TYPE_COUNT]; // Leaf - SparklyPaper - parallel world ticking
         for (final Player player : world.players()) {
-            player.activatedTick = MinecraftServer.currentTick;
-            if (world.spigotConfig.ignoreSpectatorActivation && player.isSpectator()) {
+            player.activatedTick = currentTick; // Leaf - optimize entity activation
+            if (ignoreSpectatorActivation && player.isSpectator()) { // Leaf - optimize entity activation
                 continue;
             }
 
-            if (!player.level().purpurConfig.idleTimeoutTickNearbyEntities && player.isAfk()) continue; // Purpur - AFK API
+            if (!idleTimeoutTickNearbyEntities && player.isAfk()) continue; // Purpur - AFK API // Leaf - optimize entity activation
 
             final int worldHeight = world.getHeight();
             // Leaf start - SparklyPaper - parallel world ticking
@@ -178,7 +191,7 @@ public final class ActivationRange {
 
             final List<Entity> entities = world.getEntities((Entity) null, maxBB, e -> true);
             // Leaf end - SparklyPaper - parallel world ticking
-            final boolean tickMarkers = world.paperConfig().entities.markers.tick;
+            reset.ensureCapacity(entities.size()); // Leaf - optimize entity activation
             for (final Entity entity : entities) {
                 if (!tickMarkers && entity instanceof Marker) {
                     continue;
@@ -186,21 +199,24 @@ public final class ActivationRange {
 
                 ActivationRange.activateEntity(entity, activationBoxes); // Leaf - SparklyPaper - parallel world ticking
 
+                // Leaf start - optimize entity activation
                 // Pufferfish start
-                if (org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.enabled && entity.getType().dabEnabled &&
-                        (!org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.dontEnableIfInWater || entity.is(net.minecraft.tags.EntityTypeTags.CAN_BREATHE_UNDER_WATER) || !entity.isInWater())) { // Leaf - Option for dontEnableIfInWater
-                    if (!entity.activatedPriorityReset) {
-                        entity.activatedPriorityReset = true;
-                        entity.activatedPriority = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.maximumActivationPrio;
-                    }
-                    int squaredDistance = (int) player.distanceToSqr(entity);
-                    entity.activatedPriority = squaredDistance > org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.startDistanceSquared ?
-                            Math.max(1, Math.min(squaredDistance >> org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.activationDistanceMod, entity.activatedPriority)) :
-                            1;
+                final int priority;
+                if (dab
+                    && entity.getType().dabEnabled
+                    && (!dontEnableIfInWater || !entity.isInWater() || entity.is(net.minecraft.tags.EntityTypeTags.CAN_BREATHE_UNDER_WATER))) { // Leaf - Option for dontEnableIfInWater
+                    int distSq = (int) player.distanceToSqr(entity);
+                    //noinspection MathClampMigration
+                    priority = distSq > startSq ?
+                        Math.min(maxPriority, Math.max((int) (distSq * scale), 1)) :
+                        1;
                 } else {
                     entity.activatedPriority = 1;
+                    priority = 1;
                 }
+                entity.activatedPriority = reset.add(entity.getId()) ? priority : Math.min(priority, entity.activatedPriority);
                 // Pufferfish end
+                // Leaf end - optimize entity activation
             }
         }
