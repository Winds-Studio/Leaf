diff --git a/net/minecraft/world/level/LevelWriter.java b/net/minecraft/world/level/LevelWriter.java
index dd58383b5838230c918c5754a213a6c7fcb3cd5d..0fe109564ca16c346f16eacaf55cd46c2ebdda27 100644
--- a/net/minecraft/world/level/LevelWriter.java
+++ b/net/minecraft/world/level/LevelWriter.java
@@ -29,6 +29,26 @@ public interface LevelWriter {
 
     boolean destroyBlock(BlockPos pos, boolean dropResources, @Nullable Entity breaker, int updateLimit);
 
+    // Leaf start - propagate block destruction cancellation
+    default DestroyBlockResult destroyBlockWithResult(final BlockPos pos, final boolean dropResources, final @Nullable Entity breaker, final int updateLimit) {
+        return this.destroyBlock(pos, dropResources, breaker, updateLimit) ? DestroyBlockResult.CHANGED : DestroyBlockResult.UNCHANGED;
+    }
+
+    enum DestroyBlockResult {
+        CANCELLED,
+        CHANGED,
+        UNCHANGED;
+
+        public boolean isCancelled() {
+            return this == CANCELLED;
+        }
+
+        public boolean isChanged() {
+            return this == CHANGED;
+        }
+    }
+    // Leaf end - propagate block destruction cancellation
+
     default boolean addFreshEntity(final Entity entity) {
         return false;
     }
