diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 84ea591ecd4f42383f69525f32b748d15497cfed..92cefd0cb6a1f959f19218942bc412f0dea61def 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -1079,6 +1079,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     }
 
     public void trackStartFallingPosition() {
+        if (org.dreeam.leaf.config.modules.fixes.MCBugFix.mc270656) this.resetImpulseImpactIfNeeded(); // Leaf - Fix MC-270656
         if (this.fallDistance > 0.0 && this.startingToFallPosition == null) {
             this.startingToFallPosition = this.position();
             if (this.currentImpulseImpactPos != null && this.currentImpulseImpactPos.y <= this.startingToFallPosition.y) {
@@ -1087,6 +1088,22 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
     }
 
+    // Leaf start - Fix MC-270656
+    private void resetImpulseImpactIfNeeded() {
+        if (this.currentImpulseImpactPos == null) return;
+        if (this.currentExplosionCause == null || this.currentExplosionCause.getType() != EntityType.WIND_CHARGE) return;
+
+        if (this.getAbilities().flying
+            || this.isFallFlying()
+            || this.onClimbable()
+            || this.isPassenger()
+            || this.hasEffect(MobEffects.LEVITATION)) {
+            this.currentImpulseImpactPos = null;
+            this.currentExplosionCause = null;
+        }
+    }
+    // Leaf end - Fix MC-270656
+
     public void trackEnteredOrExitedLavaOnVehicle() {
         if (this.getVehicle() != null && this.getVehicle().isInLava()) {
             if (this.enteredLavaOnVehiclePosition == null) {
