From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Naw0ke <nawoke@trprac.net>
Date: Sun, 17 May 2026 12:00:00 +0300
Subject: [PATCH] Optimize ThrownEnderpearl tick

Cache position and section coordinate lookups to avoid redundant calls
in the hot tick path.

diff --git a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
index 2fe748ab..7cefb2e5 100644
--- a/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
+++ b/net/minecraft/world/entity/projectile/throwableitemprojectile/ThrownEnderpearl.java
@@ -181,8 +181,9 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
     @Override
     public void tick() {
         if (this.level() instanceof ServerLevel serverLevel) {
-            int var7 = SectionPos.blockToSectionCoord(this.position().x());
-            int sectionPosZ = SectionPos.blockToSectionCoord(this.position().z());
+            Vec3 vec3 = this.position(); // Leaf - cache position
+            int var7 = SectionPos.blockToSectionCoord(vec3.x); // Leaf - use cached position
+            int sectionPosZ = SectionPos.blockToSectionCoord(vec3.z); // Leaf - use cached position
             Entity entity = this.owner != null ? findOwnerIncludingDeadPlayer(serverLevel, this.owner.getUUID()) : null;
             if (entity instanceof ServerPlayer serverPlayer
                 && !entity.isAlive()
@@ -195,10 +196,12 @@ public class ThrownEnderpearl extends ThrowableItemProjectile {
 
             if (this.isAlive()) {
                 BlockPos blockPos = BlockPos.containing(this.position());
+                int blockChunkX = SectionPos.blockToSectionCoord(blockPos.getX()); // Leaf - cache section coord
+                int blockChunkZ = SectionPos.blockToSectionCoord(blockPos.getZ()); // Leaf - cache section coord
                 if ((
                         --this.ticketTimer <= 0L
-                            || var7 != SectionPos.blockToSectionCoord(blockPos.getX())
-                            || sectionPosZ != SectionPos.blockToSectionCoord(blockPos.getZ())
+                            || var7 != blockChunkX // Leaf - use cached variable
+                            || sectionPosZ != blockChunkZ // Leaf - use cached variable
                     )
                     && entity instanceof ServerPlayer serverPlayer1) {
                     this.ticketTimer = serverPlayer1.registerAndUpdateEnderPearlTicket(this);
