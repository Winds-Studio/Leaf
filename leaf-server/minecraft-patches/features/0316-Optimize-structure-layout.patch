                                                 );
+                                                }
+                                            // Leaf end - StructureLayoutOptimizer - Optimize jigsaw placement
                                                 int sourceGroundLevelDelta = sourcePiece.getGroundLevelDelta();
                                                 int targetGroundLevelDelta;
                                                 if (targetRigid) {
