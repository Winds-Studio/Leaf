+                                        && (!octreeShape.boxOctree.boundaryContains(targetJigsawPos) || octreeShape.boxOctree.withinAnyBox(targetJigsawPos))) {
+                                        targetJigsaws = List.of();
+                                    }
+                                    // Leaf end - StructureLayoutOptimizer - Optimize jigsaw placement
                                     BoundingBox hackBox = targetElement.getBoundingBox(this.structureTemplateManager, BlockPos.ZERO, targetRotation);
                                     int expandTo;
                                     if (doExpansionHack && hackBox.getYSpan() <= 16) {
@@ -445,12 +483,20 @@ public class JigsawPlacement {
                                                 targetBB.encapsulate(new BlockPos(targetBB.minX(), targetBB.minY() + newSize, targetBB.minZ()));
                                             }
 
-                                            if (!Shapes.joinIsNotEmpty(
-                                                childrenFree.get(), Shapes.create(AABB.of(targetBB).deflate(0.25)), BooleanOp.ONLY_SECOND
-                                            )) {
+                                            // Leaf start - StructureLayoutOptimizer - Optimize jigsaw placement
+                                            final VoxelShape free = childrenFree.get();
+                                            final boolean fits = free instanceof org.dreeam.leaf.world.structure.OctreeVoxelShape octreeShape
+                                                ? octreeShape.boxOctree.withinBoundsButNotIntersectingChildren(AABB.of(targetBB).deflate(0.25))
+                                                : !Shapes.joinIsNotEmpty(free, Shapes.create(AABB.of(targetBB).deflate(0.25)), BooleanOp.ONLY_SECOND);
