+                                    continue;
+                                }
+
+                                for (Rotation targetRotation : targetRotations) {
+                                // Leaf end - StructureLayoutOptimizer - Optimize jigsaw placement
                                     List<StructureTemplate.JigsawBlockInfo> targetJigsaws = targetElement.getShuffledJigsawBlocks(
