Subject: [PATCH] Optimize structure layout

License: MIT (https://opensource.org/licenses/MIT)
StructureLayoutOptimizer - https://github.com/TelepathicGrunt/StructureLayoutOptimizer

Use an octree instead of voxel shapes to track the free space of jigsaw
structures, skip pool elements that were already attempted while consuming
the same random values, and skip rigid placements whose target jigsaw is
known to be blocked. Keeps vanilla seed parity.

diff --git a/net/minecraft/world/level/levelgen/structure/pools/JigsawPlacement.java b/net/minecraft/world/level/levelgen/structure/pools/JigsawPlacement.java
index a0410363384f0286eaa4d3f2774d10b740b0db44..29977e2837e3cf5705ac8e2d4bebf86ff07439c9 100644
--- a/net/minecraft/world/level/levelgen/structure/pools/JigsawPlacement.java
+++ b/net/minecraft/world/level/levelgen/structure/pools/JigsawPlacement.java
@@ -148,7 +148,16 @@ public class JigsawPlacement {
                                 Math.min(centerY + maxDistanceFromCenter.vertical() + 1, heightAccessor.getMaxY() + 1 - dimensionPadding.top()),
                                 centerZ + maxDistanceFromCenter.horizontal() + 1
                             );
-                            VoxelShape shape = Shapes.join(Shapes.create(aabb), Shapes.create(AABB.of(box)), BooleanOp.ONLY_FIRST);
+                            // Leaf start - StructureLayoutOptimizer - Optimize jigsaw placement
+                            VoxelShape shape;
+                            if (org.dreeam.leaf.config.modules.opt.OptimizeStructureLayout.enabled) {
+                                org.dreeam.leaf.world.structure.BoxOctree octree = new org.dreeam.leaf.world.structure.BoxOctree(aabb);
+                                octree.addBox(AABB.of(box));
+                                shape = new org.dreeam.leaf.world.structure.OctreeVoxelShape(octree);
+                            } else {
+                                shape = Shapes.join(Shapes.create(aabb), Shapes.create(AABB.of(box)), BooleanOp.ONLY_FIRST);
+                            }
+                            // Leaf end - StructureLayoutOptimizer - Optimize jigsaw placement
                             addPieces(
                                 context.randomState(),
                                 maxDepth,
@@ -356,7 +365,13 @@ public class JigsawPlacement {
                             if (attachInsideSource) {
