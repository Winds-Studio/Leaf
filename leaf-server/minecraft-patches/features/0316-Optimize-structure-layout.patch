                             targetPieces.addAll(fallback.value().getShuffledTemplates(this.random));
                             int placementPriority = sourceJigsaw.placementPriority();
+                            final java.util.Set<StructurePoolElement> attemptedElements = org.dreeam.leaf.config.modules.opt.OptimizeStructureLayout.enabled ? new it.unimi.dsi.fastutil.objects.ReferenceOpenHashSet<>() : null; // Leaf - StructureLayoutOptimizer - Optimize jigsaw placement
 
                             for (StructurePoolElement targetElement : targetPieces) {
                                 if (targetElement == EmptyPoolElement.INSTANCE) {
                                     break;
                                 }
 
-                                for (Rotation targetRotation : Rotation.getShuffled(this.random)) {
+                                // Leaf start - StructureLayoutOptimizer - Optimize jigsaw placement
