From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Fri, 21 Feb 2025 21:05:43 +0300
Subject: [PATCH] Nether Portal Search Prefetcher

Prefetches nether portal search asynchronously when entity enters portal.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 2eba34f2cde75733dbf5a72cfb751030d28f7710..3514d47b5a78d7c1c7d5a6d9544de1b86741136c 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -3875,6 +3875,7 @@ public abstract class Entity
         } else if (this.level.purpurConfig.entitiesCanUsePortals || this instanceof ServerPlayer) { // Purpur - Entities can use portals
             if (this.portalProcess == null || !this.portalProcess.isSamePortal(portal)) {
                 this.portalProcess = new PortalProcessor(portal, pos.immutable());
+                org.dreeam.leaf.async.world.PortalSearchPrefetcher.onPortalEnter(this, portal); // Leaf - Async portal pre-search
             } else if (!this.portalProcess.isInsidePortalThisTick()) {
                 this.portalProcess.updateEntryPosition(pos.immutable());
                 this.portalProcess.setAsInsidePortalThisTick(true);
