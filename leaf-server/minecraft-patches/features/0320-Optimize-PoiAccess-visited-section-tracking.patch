From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Tue, 9 Nov 2077 00:00:00 +0800
Subject: [PATCH] Optimize PoiAccess visited section tracking

Replace LongOpenHashSet used for tracking sections visited with bit set, avoid rehash overhead.
Manually unroll the six neighbor checks, eliminate the 3x3x3 loop.

Co-authored-by: MrlingXD <90316914+wling-art@users.noreply.github.com>

diff --git a/ca/spottedleaf/moonrise/patches/poi_lookup/PoiAccess.java b/ca/spottedleaf/moonrise/patches/poi_lookup/PoiAccess.java
index 85d80b3952a76b0ca7f67401a659cf35dd55b082..ddf8c374dd8ecdbb73408021186ace62957c0d1d 100644
--- a/ca/spottedleaf/moonrise/patches/poi_lookup/PoiAccess.java
+++ b/ca/spottedleaf/moonrise/patches/poi_lookup/PoiAccess.java
@@ -117,8 +117,13 @@ public final class PoiAccess {
         final long centerKey = CoordinateUtils.getChunkSectionKey(centerX, centerY, centerZ);
 
         final LongArrayFIFOQueue queue = new LongArrayFIFOQueue();
-        final LongOpenHashSet seen = new LongOpenHashSet();
-        seen.add(centerKey);
+        // Leaf start - Optimize PoiAccess visited section tracking
+        final org.dreeam.leaf.util.map.SectionVisitSet seen = new org.dreeam.leaf.util.map.SectionVisitSet(
+            lowerX, lowerY, lowerZ,
+            upperX, upperY, upperZ
+        );
+        seen.mark(centerX, centerY, centerZ);
+        // Leaf end - Optimize PoiAccess visited section tracking
         queue.enqueue(centerKey);
 
         while (!queue.isEmpty()) {
@@ -127,10 +132,11 @@ public final class PoiAccess {
             final int sectionY = CoordinateUtils.getChunkSectionY(key);
             final int sectionZ = CoordinateUtils.getChunkSectionZ(key);
 
+            /* 这个 不需要了 (指bound check) // Leaf - Optimize PoiAccess visited section tracking
             if (sectionX < lowerX || sectionX > upperX || sectionY < lowerY || sectionY > upperY || sectionZ < lowerZ || sectionZ > upperZ) {
                 // out of bound chunk
                 continue;
-            }
+            }*/ // Leaf - Optimize PoiAccess visited section tracking
 
             final double sectionDistanceSquared = getSmallestDistanceSquared(
                     (double)(sectionX << 4),
@@ -145,27 +151,73 @@ public final class PoiAccess {
                 continue;
             }
 
-            // queue all neighbours
-            for (int dz = -1; dz <= 1; ++dz) {
-                for (int dx = -1; dx <= 1; ++dx) {
-                    for (int dy = -1; dy <= 1; ++dy) {
-                        // -1 and 1 have the 1st bit set. so just add up the first bits, and it will tell us how many
-                        // values are set. we only care about cardinal neighbours, so, we only care if one value is set
-                        if ((dx & 1) + (dy & 1) + (dz & 1) != 1) {
-                            continue;
-                        }
+            // Leaf start - Optimize PoiAccess visited section tracking
+            // Z-
+            if (sectionZ > lowerZ && seen.mark(sectionX, sectionY, sectionZ - 1)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY,
+                        sectionZ - 1
+                    )
+                );
+            }
 
-                        final int neighbourX = sectionX + dx;
-                        final int neighbourY = sectionY + dy;
-                        final int neighbourZ = sectionZ + dz;
+            // X-
+            if (sectionX > lowerX && seen.mark(sectionX - 1, sectionY, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX - 1,
+                        sectionY,
+                        sectionZ
+                    )
+                );
+            }
 
-                        final long neighbourKey = CoordinateUtils.getChunkSectionKey(neighbourX, neighbourY, neighbourZ);
-                        if (seen.add(neighbourKey)) {
-                            queue.enqueue(neighbourKey);
-                        }
-                    }
-                }
+            // Y-
+            if (sectionY > lowerY && seen.mark(sectionX, sectionY - 1, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY - 1,
+                        sectionZ
+                    )
+                );
+            }
+
+            // Y+
+            if (sectionY < upperY && seen.mark(sectionX, sectionY + 1, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY + 1,
+                        sectionZ
+                    )
+                );
+            }
+
+            // X+
+            if (sectionX < upperX && seen.mark(sectionX + 1, sectionY, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX + 1,
+                        sectionY,
+                        sectionZ
+                    )
+                );
+            }
+
+            // Z+
+            if (sectionZ < upperZ && seen.mark(sectionX, sectionY, sectionZ + 1)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY,
+                        sectionZ + 1
+                    )
+                );
             }
+            // Leaf end - Optimize PoiAccess visited section tracking
 
             final Optional<PoiSection> poiSectionOptional = load ? poiStorage.getOrLoad(key) : poiStorage.get(key);
 
@@ -360,8 +412,13 @@ public final class PoiAccess {
         final long centerKey = CoordinateUtils.getChunkSectionKey(centerX, centerY, centerZ);
 
         final LongArrayFIFOQueue queue = new LongArrayFIFOQueue();
-        final LongOpenHashSet seen = new LongOpenHashSet();
-        seen.add(centerKey);
+        // Leaf start - Optimize PoiAccess visited section tracking
+        final org.dreeam.leaf.util.map.SectionVisitSet seen = new org.dreeam.leaf.util.map.SectionVisitSet(
+            lowerX, lowerY, lowerZ,
+            upperX, upperY, upperZ
+        );
+        seen.mark(centerX, centerY, centerZ);
+        // Leaf end - Optimize PoiAccess visited section tracking
         queue.enqueue(centerKey);
 
         while (!queue.isEmpty()) {
@@ -370,10 +427,11 @@ public final class PoiAccess {
             final int sectionY = CoordinateUtils.getChunkSectionY(key);
             final int sectionZ = CoordinateUtils.getChunkSectionZ(key);
 
+            /* 这个 不需要了 (指bound check) // Leaf - Optimize PoiAccess visited section tracking
             if (sectionX < lowerX || sectionX > upperX || sectionY < lowerY || sectionY > upperY || sectionZ < lowerZ || sectionZ > upperZ) {
                 // out of bound chunk
                 continue;
-            }
+            }*/ // Leaf - Optimize PoiAccess visited section tracking
 
             final double sectionDistanceSquared = getSmallestDistanceSquared(
                     (double)(sectionX << 4),
@@ -389,27 +447,85 @@ public final class PoiAccess {
                 continue;
             }
 
-            // queue all neighbours
-            for (int dz = -1; dz <= 1; ++dz) {
-                for (int dx = -1; dx <= 1; ++dx) {
-                    for (int dy = -1; dy <= 1; ++dy) {
-                        // -1 and 1 have the 1st bit set. so just add up the first bits, and it will tell us how many
-                        // values are set. we only care about cardinal neighbours, so, we only care if one value is set
-                        if ((dx & 1) + (dy & 1) + (dz & 1) != 1) {
-                            continue;
-                        }
+            // Leaf start - Optimize PoiAccess visited section tracking
+            /*
+             * unroll the loop
+             *
+             * for (dz = -1..1)
+             *   for (dx = -1..1)
+             *     for (dy = -1..1)
+             *
+             * is unrolled to
+             *
+             * Z-, X-, Y-, Y+, X+, Z+
+             */
+
+            // Z-
+            if (sectionZ > lowerZ && seen.mark(sectionX, sectionY, sectionZ - 1)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY,
+                        sectionZ - 1
+                    )
+                );
+            }
 
-                        final int neighbourX = sectionX + dx;
-                        final int neighbourY = sectionY + dy;
-                        final int neighbourZ = sectionZ + dz;
+            // X-
+            if (sectionX > lowerX && seen.mark(sectionX - 1, sectionY, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX - 1,
+                        sectionY,
+                        sectionZ
+                    )
+                );
+            }
 
-                        final long neighbourKey = CoordinateUtils.getChunkSectionKey(neighbourX, neighbourY, neighbourZ);
-                        if (seen.add(neighbourKey)) {
-                            queue.enqueue(neighbourKey);
-                        }
-                    }
-                }
+            // Y-
+            if (sectionY > lowerY && seen.mark(sectionX, sectionY - 1, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY - 1,
+                        sectionZ
+                    )
+                );
+            }
+
+            // Y+
+            if (sectionY < upperY && seen.mark(sectionX, sectionY + 1, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY + 1,
+                        sectionZ
+                    )
+                );
+            }
+
+            // X+
+            if (sectionX < upperX && seen.mark(sectionX + 1, sectionY, sectionZ)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX + 1,
+                        sectionY,
+                        sectionZ
+                    )
+                );
+            }
+
+            // Z+
+            if (sectionZ < upperZ && seen.mark(sectionX, sectionY, sectionZ + 1)) {
+                queue.enqueue(
+                    CoordinateUtils.getChunkSectionKey(
+                        sectionX,
+                        sectionY,
+                        sectionZ + 1
+                    )
+                );
             }
+            // Leaf end - Optimize PoiAccess visited section tracking
 
             final Optional<PoiSection> poiSectionOptional = load ? poiStorage.getOrLoad(key) : poiStorage.get(key);
 
