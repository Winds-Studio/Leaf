-            FluidState fluidState = this.level().getFluidState(blockPos);
-            double d = blockPos.getY() + fluidState.getHeight(this.level(), blockPos);
+            // Leaf start - optimize eye block position
+            int blockX = this.blockPosition.getX();
+            int blockZ = this.blockPosition.getZ();
+            int blockY = Mth.floor(eyeY);
+            Level world = this.level();
+            FluidState fluidState = world.getFluidStateIfLoadedUnchecked(blockX, blockY, blockZ); // Leaf
+            if (fluidState == null) { fluidState = world.getFluidState(new BlockPos(blockX, blockY, blockZ)); }
+            double d = fluidState.isEmpty() ? blockY : blockY + fluidState.getHeight(world, new BlockPos(blockX, blockY, blockZ));
+            // Leaf end - optimize eye block position
             if (d > eyeY) {
                 // Leaf start - Optimize isEyeInFluid
                 this.isInWaterOrLava = fluidState.isEmpty() ? 0 : fluidState.is(FluidTags.WATER) ? 1 : 2;
@@ -2272,22 +2270,24 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
         }
     }
 
+    // Leaf start - optimize eye block position
     @Deprecated
     public float getLightLevelDependentMagicValue() {
-        return this.getLightLevelDependentMagicValue(BlockPos.containing(this.getX(), this.getEyeY(), this.getZ())); // Gale - JettPack - optimize sun burn tick - allow passing BlockPos to getLightLevelDependentMagicValue
+        Level world = this.level();
+        int blockX = this.getBlockX();
+        int blockZ = this.getBlockZ();
+        return world.hasChunkAt(blockX, blockZ)
+            ? world.getLightLevelDependentMagicValue(new BlockPos(blockX, Mth.floor(this.getEyeY()), blockZ))
+            : 0.0F;
     }
-
-    // Gale start - JettPack - optimize sun burn tick - allow passing BlockPos to getLightLevelDependentMagicValue
-    /**
-     * @deprecated
-     */
     @Deprecated
     public float getLightLevelDependentMagicValue(BlockPos pos) {
-        return this.level().hasChunkAt(this.getBlockX(), this.getBlockZ())
-            ? this.level.getLightLevelDependentMagicValue(pos)
+        Level world = this.level();
+        return world.hasChunkAt(pos.getX(), pos.getZ())
+            ? world.getLightLevelDependentMagicValue(pos)
             : 0.0F;
     }
-    // Gale end - JettPack - optimize sun burn tick - allow passing BlockPos to getLightLevelDependentMagicValue
