diff --git a/src/main/java/org/bukkit/craftbukkit/util/DelegatedGeneratorAccess.java b/src/main/java/org/bukkit/craftbukkit/util/DelegatedGeneratorAccess.java
index 514ef7471b8da5fd8538f251c46ab215a3e7a48f..f5b670da0ce3ffc548a0a8b1cbcec02e78bf6a8e 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/DelegatedGeneratorAccess.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/DelegatedGeneratorAccess.java
@@ -698,6 +698,13 @@ public abstract class DelegatedGeneratorAccess implements WorldGenLevel {
         return this.delegate.destroyBlock(pos, dropBlock, entity, recursionLeft);
     }
 
+    // Leaf start - propagate block destruction cancellation
+    @Override
+    public net.minecraft.world.level.LevelWriter.DestroyBlockResult destroyBlockWithResult(BlockPos pos, boolean dropBlock, Entity entity, int recursionLeft) {
+        return this.delegate.destroyBlockWithResult(pos, dropBlock, entity, recursionLeft);
+    }
+    // Leaf end - propagate block destruction cancellation
+
     @Override
     public boolean addFreshEntity(Entity entity) {
         return this.delegate.addFreshEntity(entity);
