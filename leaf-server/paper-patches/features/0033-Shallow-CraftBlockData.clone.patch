From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taiyou06 <kaandindar21@gmail.com>
Date: Sat, 22 Mar 2025 22:28:45 +0100
Subject: [PATCH] Shallow CraftBlockData.clone


diff --git a/src/main/java/org/bukkit/craftbukkit/block/data/CraftBlockData.java b/src/main/java/org/bukkit/craftbukkit/block/data/CraftBlockData.java
index 66e40149a59c4bd5d5ca3b5a69c733eea49fb86b..57db4291f649e0b9a6ad42efb4e9f9d3c7949446 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/data/CraftBlockData.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/data/CraftBlockData.java
@@ -224,15 +224,19 @@ public class CraftBlockData implements BlockData {
         return (hideUnspecified && this.parsedStates != null) ? this.toString(this.parsedStates) : this.getAsString();
     }
 
+    protected CraftBlockData(CraftBlockData original) {
+        this.state = original.state; // BlockState is immutable; no deep copy needed
+        if (original.parsedStates != null) {
+            this.parsedStates = new HashMap<>(original.parsedStates); // Shallow copy (entries are immutable)
+        }
+    }
+
     @Override
     public BlockData clone() {
-        try {
-            return (BlockData) super.clone();
-        } catch (CloneNotSupportedException ex) {
-            throw new AssertionError("Clone not supported", ex);
-        }
+        return new CraftBlockData(this); // Delegate to the copy constructor
     }
 
+
     @Override
     public String toString() {
         return "CraftBlockData{" + this.getAsString() + "}";
