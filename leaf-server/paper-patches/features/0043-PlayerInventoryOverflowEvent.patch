index 24198f00ebe679ab19c2d30d6b30474dd99fb2a7..a783b52daf0b3bbae8233de4dcd09a0ae9161ce3 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventory.java
