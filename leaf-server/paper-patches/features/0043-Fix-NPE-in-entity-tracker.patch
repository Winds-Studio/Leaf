From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: c0re <c0re@valx.pw>
Date: Thu, 26 Dec 2024 00:00:00 +0300
Subject: [PATCH] Fix NPE in entity tracker

Fixes NullPointerException that occurs when getChunk() returns null
in MultithreadedTracker methods.

diff --git a/src/main/java/org/dreeam/leaf/async/tracker/MultithreadedTracker.java b/src/main/java/org/dreeam/leaf/async/tracker/MultithreadedTracker.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/org/dreeam/leaf/async/tracker/MultithreadedTracker.java
+++ b/src/main/java/org/dreeam/leaf/async/tracker/MultithreadedTracker.java
@@ -80,7 +80,10 @@ public class MultithreadedTracker {
 
                 synchronized (tracker) {
                     var trackedChunk = nearbyPlayers.getChunk(entity.chunkPosition());
-                    tracker.moonrise$tick(trackedChunk);
+                    if (trackedChunk != null) { // Leaf - Fix NPE when tracked chunk is null
+                        tracker.moonrise$tick(trackedChunk);
+                    }
                     tracker.serverEntity.sendChanges();
                 }
             }
@@ -104,7 +107,10 @@ public class MultithreadedTracker {
             if (tracker == null) continue;
 
             synchronized (tracker) {
-                tickTask[index] = tracker.leafTickCompact(nearbyPlayers.getChunk(entity.chunkPosition()));
+                var trackedChunk = nearbyPlayers.getChunk(entity.chunkPosition());
+                if (trackedChunk != null) { // Leaf - Fix NPE when tracked chunk is null
+                    tickTask[index] = tracker.leafTickCompact(trackedChunk);
+                }
                 sendChangesTasks[index] = () -> tracker.serverEntity.sendChanges(); // Collect send changes to task array
             }
             index++;
@@ -138,7 +144,12 @@ public class MultithreadedTracker {
             if (tracker == null) {
                 continue;
             }
-            ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity) tracker).moonrise$tick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity) entity).moonrise$getChunkData().nearbyPlayers);
+            // Leaf - Fix NPE when chunk data is null
+            var chunkData = ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity) entity).moonrise$getChunkData();
+            if (chunkData != null) {
+                ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity) tracker).moonrise$tick(chunkData.nearbyPlayers);
+            }
+            // Leaf end - Fix NPE when chunk data is null
             if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity) tracker).moonrise$hasPlayers()
                 || ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity) entity).moonrise$getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
                 tracker.serverEntity.sendChanges();
``` 