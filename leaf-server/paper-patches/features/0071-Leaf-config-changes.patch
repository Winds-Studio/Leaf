+package org.dreeam.leaf.config.migration;
+
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.IOException;
+import java.lang.reflect.Constructor;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("LeafTest")
+class ConfigBackupSessionTest {
+
+    @TempDir
+    Path temp;
+
+    private static ConfigBackupSession sessionAt(Path directory) throws Exception {
+        Constructor<ConfigBackupSession> constructor = ConfigBackupSession.class.getDeclaredConstructor(Path.class);
+        constructor.setAccessible(true);
+        return constructor.newInstance(directory);
+    }
+
+    @Test
+    void noDirectoryIsCreatedUntilSomethingIsMoved() throws Exception {
+        Path config = temp.resolve("config");
+        Files.createDirectories(config);
+        ConfigBackupSession.create(config);
+        try (Stream<Path> entries = Files.list(config)) {
+            assertEquals(0, entries.count());
+        }
+    }
+
+    @Test
+    void createdDirectoryIsNamedAfterTheStartAndLivesInTheConfigDirectory() throws Exception {
+        Path config = temp.resolve("config");
+        ConfigBackupSession session = ConfigBackupSession.create(config);
+        assertEquals(config, session.directory().getParent());
+        assertTrue(session.directory().getFileName().toString().matches("backup-\\d{6}-\\d{6}"));
+    }
+
+    @Test
+    void everyMoveSharesOneBackupRoot() throws Exception {
+        Path root = temp.resolve("backup-test");
+        ConfigBackupSession session = sessionAt(root);
+        Path first = Files.writeString(temp.resolve("first.yml"), "a: 1\n");
+        Path second = Files.writeString(temp.resolve("second.yml"), "b: 2\n");
+
+        session.move(first, Path.of("first.yml"));
+        session.move(second, Path.of("nested/dir/second.yml"));
+
+        assertFalse(Files.exists(first));
+        assertFalse(Files.exists(second));
+        assertEquals("a: 1\n", Files.readString(root.resolve("first.yml")));
+        assertEquals("b: 2\n", Files.readString(root.resolve("nested/dir/second.yml")));
+        assertEquals(root, session.directory());
+    }
+
+    @Test
+    void existingDirectoryGetsASuffix() throws Exception {
+        Path root = temp.resolve("backup-test");
+        Files.createDirectories(root);
+        Files.createDirectories(temp.resolve("backup-test-1"));
+        ConfigBackupSession session = sessionAt(root);
+        Path source = Files.writeString(temp.resolve("source.yml"), "a: 1\n");
+
+        session.move(source, Path.of("source.yml"));
+
+        assertEquals(temp.resolve("backup-test-2"), session.directory());
+        assertTrue(Files.isRegularFile(temp.resolve("backup-test-2/source.yml")));
+        // The directory is chosen once, later moves keep using it.
+        Path other = Files.writeString(temp.resolve("other.yml"), "b: 2\n");
+        session.move(other, Path.of("other.yml"));
+        assertTrue(Files.isRegularFile(temp.resolve("backup-test-2/other.yml")));
+    }
+
+    @Test
+    void invalidTargetsAreRejectedAndTheSourceStays() throws Exception {
+        ConfigBackupSession session = sessionAt(temp.resolve("backup-test"));
+        Path source = Files.writeString(temp.resolve("source.yml"), "a: 1\n");
+
+        assertThrows(IOException.class, () -> session.move(source, Path.of("..").resolve("escape.yml")));
+        assertThrows(IOException.class, () -> session.move(source, temp.resolve("absolute.yml").toAbsolutePath()));
+        assertTrue(Files.isRegularFile(source));
+        assertFalse(Files.exists(temp.resolve("escape.yml")));
+    }
+
+    @Test
+    void failedMoveKeepsTheSource() throws Exception {
+        Path root = temp.resolve("backup-test");
+        ConfigBackupSession session = sessionAt(root);
+        Path source = Files.writeString(temp.resolve("source.yml"), "a: 1\n");
+        Path first = Files.writeString(temp.resolve("first.yml"), "b: 2\n");
+        session.move(first, Path.of("target.yml"));
+
+        assertThrows(IOException.class, () -> session.move(source, Path.of("target.yml"))); // already exists
+        assertEquals("a: 1\n", Files.readString(source));
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/migration/LeafConfigMigrationTest.java b/src/test/java/org/dreeam/leaf/config/migration/LeafConfigMigrationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..5f9173febe8f2e1cedc1c09487138a0bdf6902b2
--- /dev/null
+++ b/src/test/java/org/dreeam/leaf/config/migration/LeafConfigMigrationTest.java
@@ -0,0 +1,263 @@
+package org.dreeam.leaf.config.migration;
+
+import io.github.classgraph.ClassGraph;
+import io.github.classgraph.ClassInfo;
+import io.github.classgraph.ScanResult;
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.dreeam.leaf.config.LogCapture;
+import org.dreeam.leaf.config.migration.ConfigMigrationContext.Scope;
+import org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities;
+import org.dreeam.leaf.config.util.ConfigVersion;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Version comparison, the migration declarations of the real modules, and how declarations are applied. */
+@Tag("LeafTest")
+class LeafConfigMigrationTest {
+
+    private static final ConfigVersion OLD = ConfigVersion.parse("0");
+
+    @TempDir
+    Path temp;
+
+    private int fileCounter;
+
+    private File file(String content) throws Exception {
+        File file = temp.resolve("config-" + this.fileCounter++ + ".yml").toFile();
+        Files.writeString(file.toPath(), content);
+        return file;
+    }
+
+    private ConfigFile load(String content) throws Exception {
+        return ConfigFile.loadConfig(file(content));
+    }
+
+    // ---- Versions
+
+    @Test
+    void versionsCompareByNumber() {
+        assertTrue(ConfigVersion.parse("3.9").compareTo(ConfigVersion.parse("3.10")) < 0);
+        assertEquals(0, ConfigVersion.parse("3").compareTo(ConfigVersion.parse("3.0")));
+        assertTrue(ConfigVersion.parse("3.1.1").compareTo(ConfigVersion.parse("3.1")) > 0);
+        assertThrows(IllegalArgumentException.class, () -> ConfigVersion.parse("3.x"));
+        assertThrows(IllegalArgumentException.class, () -> ConfigVersion.parse("3..1"));
+        assertThrows(IllegalArgumentException.class, () -> ConfigVersion.parse("-1"));
+        assertThrows(IllegalArgumentException.class, () -> ConfigVersion.parse(" "));
+        assertTrue(ConfigVersion.isBefore("3.9", "3.10"));
+        assertTrue(ConfigVersion.isAtLeast("3.10", "3.9"));
+    }
+
+    // ---- Declarations of the real modules
+
+    private static List<Class<?>> realModules() {
+        List<Class<?>> modules = new ArrayList<>();
+        try (ScanResult scan = new ClassGraph().acceptPackages("org.dreeam.leaf.config.modules").enableClassInfo().scan()) {
+            for (ClassInfo info : scan.getAllClasses()) {
+                if (!info.isInterface() && !info.isAbstract() && !info.isInnerClass()) {
+                    modules.add(info.loadClass());
+                }
+            }
+        }
+        return modules;
+    }
+
+    private record Endpoint(Scope scope, String path) {
+
+        boolean overlaps(Endpoint other) {
+            return this.scope == other.scope
+                && (this.path.equals(other.path) || this.path.startsWith(other.path + ".") || other.path.startsWith(this.path + "."));
+        }
+    }
+
+    /** Declarations are not checked at runtime; this is where a wrong one is found. */
+    @Test
+    void declaredMigrationsAreConsistent() throws Exception {
+        List<ConfigMigrationContext.Operation> operations = LeafConfigMigration.collect(OLD, realModules()).operations();
+        assertFalse(operations.isEmpty());
+
+        Map<Endpoint, Endpoint> targetOfSource = new HashMap<>();
+        for (ConfigMigrationContext.Operation operation : operations) {
+            assertFalse(operation.oldPath().isBlank());
+            assertFalse(operation.newPath().isBlank());
+            Endpoint source = new Endpoint(operation.source(), operation.oldPath());
+            Endpoint target = new Endpoint(operation.target(), operation.newPath());
+            assertFalse(source.equals(target), "A migration must change the file or the path: " + operation);
+            assertFalse(source.overlaps(target), "Paths of one migration must not overlap: " + operation);
+            Endpoint previous = targetOfSource.putIfAbsent(source, target);
+            assertTrue(previous == null || previous.equals(target), "One source has two targets: " + source);
+        }
+        for (int first = 0; first < operations.size(); first++) {
+            for (int second = first + 1; second < operations.size(); second++) {
+                ConfigMigrationContext.Operation one = operations.get(first);
+                ConfigMigrationContext.Operation two = operations.get(second);
+                Endpoint[] oneEnds = {new Endpoint(one.source(), one.oldPath()), new Endpoint(one.target(), one.newPath())};
+                Endpoint[] twoEnds = {new Endpoint(two.source(), two.oldPath()), new Endpoint(two.target(), two.newPath())};
+                for (Endpoint a : oneEnds) {
+                    for (Endpoint b : twoEnds) {
+                        // Equal endpoints chain or share one operation, only partial overlaps are wrong
+                        assertFalse(a.overlaps(b) && !a.equals(b), "Paths of two migrations overlap: " + one + " and " + two);
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void migrationsOnlyRunForOlderFiles() throws Exception {
+        assertEquals(2, LeafConfigMigration.collect(ConfigVersion.parse("3.0"), List.of(OptimizeBlockEntities.class, org.dreeam.leaf.config.modules.opt.OptimizeRandomTick.class)).operations().size());
+        assertEquals(0, LeafConfigMigration.collect(ConfigVersion.parse("3.1"), realModules()).operations().size());
+        assertEquals(0, LeafConfigMigration.collect(ConfigVersion.parse("3.10"), realModules()).operations().size());
+    }
+
+    // ---- Applying migrations
+
+    public static final class RenameModule {
+
+        public static void migrate(ConfigMigrationContext migrations) {
+            if (migrations.isBefore("2.0")) {
+                migrations.migrate(Scope.GLOBAL, "a.old", Scope.GLOBAL, "a.new");
+                migrations.migrate(Scope.GLOBAL, "defaults.old", Scope.WORLD_DEFAULTS, "defaults.new");
+                migrations.migrate(Scope.WORLD_DEFAULTS, "toGlobal.old", Scope.GLOBAL, "toGlobal.new");
+                migrations.migrate(Scope.WORLD_DEFAULTS, "worldA.old", Scope.WORLD_DEFAULTS, "worldA.new");
+            }
+        }
+    }
+
+    public static final class ChainModule {
+
+        // Chains work in the order they are declared.
+        public static void migrate(ConfigMigrationContext migrations) {
+            migrations.migrate(Scope.GLOBAL, "chain.a", Scope.GLOBAL, "chain.b");
+            migrations.migrate(Scope.GLOBAL, "chain.b", Scope.GLOBAL, "chain.c");
+        }
+    }
+
+    public static final class SectionSourceModule {
+
+        public static void migrate(ConfigMigrationContext migrations) {
+            migrations.migrate(Scope.GLOBAL, "section", Scope.GLOBAL, "target");
+        }
+    }
+
+    public static final class SectionTargetModule {
+
+        public static void migrate(ConfigMigrationContext migrations) {
+            migrations.migrate(Scope.GLOBAL, "source", Scope.GLOBAL, "target");
+        }
+    }
+
+    @Test
+    void movesOptionsBetweenFilesWhenTheVersionIsOlder() throws Exception {
+        ConfigFile global = load("a:\n  old: 1\ndefaults:\n  old: 2\n");
+        ConfigFile defaults = load("toGlobal:\n  old: 3\nworldA:\n  old: 4\n");
+        LeafConfigMigration.migrate(global, defaults, List.of(RenameModule.class), ConfigVersion.parse("1.9"), ConfigVersion.parse("1.9"));
+
+        assertEquals(1, global.get("a.new"));
+        assertEquals(2, defaults.get("defaults.new"));
+        assertEquals(3, global.get("toGlobal.new"));
+        assertEquals(4, defaults.get("worldA.new"));
+    }
+
+    @Test
+    void everyFileIsMigratedByItsOwnVersion() throws Exception {
+        // Global is current, the defaults are old (for example a restored backup): only what starts in the defaults moves.
+        ConfigFile global = load("a:\n  old: 1\ndefaults:\n  old: 2\n");
+        ConfigFile defaults = load("toGlobal:\n  old: 3\nworldA:\n  old: 4\n");
+        LeafConfigMigration.migrate(global, defaults, List.of(RenameModule.class), ConfigVersion.parse("2.0"), ConfigVersion.parse("1.0"));
+        assertFalse(global.contains("a.new"));
+        assertFalse(defaults.contains("defaults.new"));
+        assertEquals(3, global.get("toGlobal.new"));
+        assertEquals(4, defaults.get("worldA.new"));
+
+        // And the other way round: the global file is old, the defaults are current.
+        ConfigFile oldGlobal = load("a:\n  old: 1\ndefaults:\n  old: 2\n");
+        ConfigFile currentDefaults = load("toGlobal:\n  old: 3\nworldA:\n  old: 4\n");
+        LeafConfigMigration.migrate(oldGlobal, currentDefaults, List.of(RenameModule.class), ConfigVersion.parse("1.0"), ConfigVersion.parse("2.0"));
+        assertEquals(1, oldGlobal.get("a.new"));
+        assertEquals(2, currentDefaults.get("defaults.new"));
+        assertFalse(oldGlobal.contains("toGlobal.new"));
+        assertFalse(currentDefaults.contains("worldA.new"));
+    }
+
+    @Test
+    void doesNothingWhenTheVersionIsCurrent() throws Exception {
+        ConfigFile global = load("a:\n  old: 1\n");
+        ConfigFile defaults = load("");
+        LeafConfigMigration.migrate(global, defaults, List.of(RenameModule.class), ConfigVersion.parse("2.0"), ConfigVersion.parse("2.0"));
+        assertFalse(global.contains("a.new"));
+        LeafConfigMigration.migrate(global, defaults, List.of(RenameModule.class), ConfigVersion.parse("2.1"), ConfigVersion.parse("2.1"));
+        assertFalse(global.contains("a.new"));
+    }
+
+    @Test
+    void worldOverridesOnlyGetOptionsMovedWithinTheWorldDefaults() throws Exception {
+        File file = file("worldA:\n  old: 4\na:\n  old: 1\ntoGlobal:\n  old: 3\n");
+        ConfigFile override = ConfigFile.loadConfig(file);
+        try (LogCapture log = new LogCapture("LeafConfigMigration")) {
+            assertTrue(LeafConfigMigration.migrateWorldOverride(override, ConfigVersion.parse("1.0"), List.of(RenameModule.class)));
+            // The option that moved to the global file can no longer be overridden and is reported
+            assertEquals(1, log.warnings().size());
+            assertTrue(log.warnings().get(0).contains("toGlobal.old"), log.warnings().get(0));
+        }
+        assertEquals(4, override.get("worldA.new"));
+        assertFalse(override.contains("a.new"));
+
+        ConfigFile current = load("worldA:\n  old: 4\n");
+        assertFalse(LeafConfigMigration.migrateWorldOverride(current, ConfigVersion.parse("2.0"), List.of(RenameModule.class)));
+    }
+
+    @Test
+    void chainedMigrationsRunInOrderAndKeepOnlyTheLastOption() throws Exception {
+        File file = file("chain:\n  a: 42\n");
+        ConfigFile global = ConfigFile.loadConfig(file);
+        LeafConfigMigration.migrate(global, load(""), List.of(ChainModule.class), OLD, OLD);
+        global.save();
+
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(42, saved.get("chain.c"));
+        assertFalse(saved.contains("chain.a"));
+        assertFalse(saved.contains("chain.b"));
+    }
+
+    @Test
+    void newOptionWinsAndOnlyADifferentOldValueIsReported() throws Exception {
+        ConfigFile different = load("a:\n  old: 1\n  new: 2\n");
+        try (LogCapture log = new LogCapture("LeafConfigMigration")) {
+            LeafConfigMigration.migrate(different, load(""), List.of(RenameModule.class), OLD, OLD);
+            assertEquals(2, different.get("a.new"));
+            assertEquals(1, log.warnings().size());
+            assertTrue(log.warnings().get(0).contains("a.old") && log.warnings().get(0).contains("a.new"), log.warnings().get(0));
+        }
+
+        ConfigFile same = load("a:\n  old: 2\n  new: 2\n");
+        try (LogCapture log = new LogCapture("LeafConfigMigration")) {
+            LeafConfigMigration.migrate(same, load(""), List.of(RenameModule.class), OLD, OLD);
+            assertEquals(2, same.get("a.new"));
+            assertEquals(List.of(), log.warnings());
+        }
+    }
+
+    @Test
+    void rejectsOldOptionsThatAreNullOrSectionsAndTargetsThatAreSections() throws Exception {
+        assertThrows(IllegalStateException.class, () -> LeafConfigMigration.migrate(
+            load("source:\n"), load(""), List.of(SectionTargetModule.class), OLD, OLD));
+        assertThrows(IllegalStateException.class, () -> LeafConfigMigration.migrate(
+            load("section:\n  inner: 1\n"), load(""), List.of(SectionSourceModule.class), OLD, OLD));
+        assertThrows(IllegalStateException.class, () -> LeafConfigMigration.migrate(
+            load("source: 1\ntarget:\n  inner: 1\n"), load(""), List.of(SectionTargetModule.class), OLD, OLD));
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/migration/gale/GaleConfigMigrationTest.java b/src/test/java/org/dreeam/leaf/config/migration/gale/GaleConfigMigrationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d91377a84c018a78af5e41b9a0ade3d1f1de261a
--- /dev/null
+++ b/src/test/java/org/dreeam/leaf/config/migration/gale/GaleConfigMigrationTest.java
@@ -0,0 +1,198 @@
+package org.dreeam.leaf.config.migration.gale;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.dreeam.leaf.config.LogCapture;
+import org.dreeam.leaf.config.migration.ConfigBackupSession;
+import org.dreeam.leaf.config.util.ConfigPaths;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** The Gale global and world defaults stages (Gale world overrides are covered by LeafWorldOverrideMigrationTest). */
+@Tag("LeafTest")
+class GaleConfigMigrationTest {
+
+    // Gale option -> Leaf option, one boolean, one int and one world option
+    private static final String BOOK_GALE = "gameplay-mechanics.enable-book-writing";
+    private static final String BOOK_LEAF = "gameplay-mechanisms.book-writing.enabled";
+    private static final String TIMEOUT_GALE = "misc.premium-account-slow-login-timeout";
+    private static final String TIMEOUT_LEAF = "network.premium-account-slow-login-timeout";
+    private static final String PER_TICK_GALE = "small-optimizations.max-projectile-chunk-loads.per-tick";
+    private static final String PER_TICK_LEAF = "performance.max-projectile-chunk-loads.per-tick";
+
+    @TempDir
+    Path temp;
+
+    private Path galeGlobal(String content) throws Exception {
+        Path path = temp.resolve("gale-global.yml");
+        Files.writeString(path, content);
+        return path;
+    }
+
+    private ConfigFile leaf(String name, String content) throws Exception {
+        File file = temp.resolve(name).toFile();
+        Files.writeString(file.toPath(), content);
+        return ConfigFile.loadConfig(file);
+    }
+
+    private void migrate(ConfigFile global, ConfigFile defaults) {
+        GaleConfigMigration.migrate(temp, global, defaults, ConfigBackupSession.create(temp));
+    }
+
+    // ---- Definitions
+
+    private static Map<String, String> targets(List<GaleConfigMigration.Mapping> mappings) throws Exception {
+        Map<String, String> targets = new HashMap<>();
+        for (GaleConfigMigration.Mapping mapping : mappings) {
+            Field field = mapping.moduleClass().getDeclaredField(mapping.fieldName());
+            String target = ConfigPaths.fieldPath(mapping.moduleClass(), field);
+            String previous = targets.putIfAbsent(mapping.oldPath(), target);
+            // The same registration twice is harmless, a source with two targets is not
+            assertTrue(previous == null || previous.equals(target), "Gale option " + mapping.oldPath() + " has two targets");
+        }
+        return targets;
+    }
+
+    @Test
+    void registeredMappingsHaveOneTargetPerSource() throws Exception {
+        assertFalse(targets(GaleConfigMigration.registerGlobalMappings()).isEmpty());
+        assertFalse(targets(GaleConfigMigration.registerWorldMappings()).isEmpty());
+    }
+
+    @Test
+    void definitionCheckSeesTwoTargetsOfOneSourceEvenWhenTheResolvedMapWouldHideIt() {
+        List<GaleConfigMigration.Mapping> mappings = List.of(
+            new GaleConfigMigration.Mapping("a.b", org.dreeam.leaf.config.modules.gameplay.BookWriting.class, "enabled"),
+            new GaleConfigMigration.Mapping("a.b", org.dreeam.leaf.config.modules.network.Keepalive.class, "sendMultiple")
+        );
+        assertThrows(AssertionError.class, () -> targets(mappings));
+    }
+
+    @Test
+    void everyMappingTargetResolvesWhenMigrating() throws Exception {
+        // migrate() resolves all targets even when there is nothing to import; a defective target throws
+        migrate(leaf("global.yml", ""), leaf("defaults.yml", ""));
+    }
+
+    // ---- Values
+
+    @Test
+    void importsMissingValuesConvertedToTheirOptionType() throws Exception {
+        galeGlobal("gameplay-mechanics:\n  enable-book-writing: 'no'\nmisc:\n  premium-account-slow-login-timeout: 40.0\n");
+        ConfigFile global = leaf("global.yml", "");
+        migrate(global, leaf("defaults.yml", ""));
+
+        assertEquals(false, global.get(BOOK_LEAF)); // "no" is a valid false
+        assertEquals(40, global.get(TIMEOUT_LEAF));
+    }
+
+    @Test
+    void worldDefaultsAreImportedFromTheirOwnFile() throws Exception {
+        Files.writeString(temp.resolve("gale-world-defaults.yml"),
+            "small-optimizations:\n  max-projectile-chunk-loads:\n    per-tick: 3\n");
+        ConfigFile global = leaf("global.yml", "");
+        ConfigFile defaults = leaf("defaults.yml", "");
+        migrate(global, defaults);
+
+        assertEquals(3, defaults.get(PER_TICK_LEAF));
+        assertFalse(global.contains(PER_TICK_LEAF));
+    }
+
+    @Test
+    void nullValuesAreMissingValues() throws Exception {
+        galeGlobal("gameplay-mechanics:\n  enable-book-writing:\nmisc:\n  premium-account-slow-login-timeout: ~\n");
+        ConfigFile global = leaf("global.yml", "");
+        migrate(global, leaf("defaults.yml", ""));
+
+        assertFalse(global.contains(BOOK_LEAF));
+        assertFalse(global.contains(TIMEOUT_LEAF));
+    }
+
+    @Test
+    void invalidMappedValueFailsAndNothingIsImported() throws Exception {
+        Path gale = galeGlobal("gameplay-mechanics:\n  enable-book-writing: false\nmisc:\n  premium-account-slow-login-timeout: abc\n");
+        ConfigFile global = leaf("global.yml", "");
+        IllegalArgumentException exception = assertThrows(IllegalArgumentException.class,
+            () -> migrate(global, leaf("defaults.yml", "")));
+
+        assertTrue(exception.getMessage().contains(TIMEOUT_GALE), exception.getMessage());
+        assertTrue(exception.getMessage().contains("gale-global.yml"), exception.getMessage());
+        assertFalse(global.contains(BOOK_LEAF), "values of the same file are not imported partially");
+        assertTrue(Files.exists(gale));
+
+        // "maybe" is no boolean either
+        galeGlobal("gameplay-mechanics:\n  enable-book-writing: maybe\n");
+        assertThrows(IllegalArgumentException.class, () -> migrate(leaf("global2.yml", ""), leaf("defaults2.yml", "")));
+    }
+
+    @Test
+    void existingLeafValuesWinAndOnlyDifferentGaleValuesAreReported() throws Exception {
+        galeGlobal("gameplay-mechanics:\n  enable-book-writing: false\nmisc:\n  premium-account-slow-login-timeout: 40\n");
+        ConfigFile global = leaf("global.yml", "gameplay-mechanisms:\n  book-writing:\n    enabled: true\nnetwork:\n  premium-account-slow-login-timeout: 40\n");
+        try (LogCapture log = new LogCapture("GaleConfigMigration")) {
+            migrate(global, leaf("defaults.yml", ""));
+
+            assertEquals(true, global.get(BOOK_LEAF));
+            assertEquals(40, global.get(TIMEOUT_LEAF));
+            assertEquals(1, log.warnings().size(), log.warnings().toString());
+            assertTrue(log.warnings().get(0).contains(BOOK_LEAF), log.warnings().get(0));
+        }
+
+        // Running it again, as after a failed archive, changes nothing
+        migrate(global, leaf("defaults.yml", ""));
+        assertEquals(true, global.get(BOOK_LEAF));
+    }
+
+    @Test
+    void valueWrittenByLeafMigrationCountsAsALeafValue() throws Exception {
+        galeGlobal("gameplay-mechanics:\n  enable-book-writing: false\n");
+        ConfigFile global = leaf("global.yml", "");
+        global.set(BOOK_LEAF, true); // as a Leaf rename that ran earlier does
+        migrate(global, leaf("defaults.yml", ""));
+        assertEquals(true, global.get(BOOK_LEAF));
+    }
+
+    // ---- Unmapped options
+
+    @Test
+    void unmappedOptionsAreListedInOneWarning() throws Exception {
+        galeGlobal("_version: 1\ngameplay-mechanics:\n  enable-book-writing: true\n  unknown-option: 1\nsomething:\n  else:\n    deep: 2\n");
+        try (LogCapture log = new LogCapture("GaleConfigMigration")) {
+            migrate(leaf("global.yml", ""), leaf("defaults.yml", ""));
+            assertEquals(1, log.warnings().size(), log.warnings().toString());
+            String warning = log.warnings().get(0);
+            assertTrue(warning.contains("gameplay-mechanics.unknown-option") && warning.contains("something.else.deep"), warning);
+            assertFalse(warning.contains("_version") || warning.contains("enable-book-writing"), warning);
+        }
+    }
+
+    @Test
+    void versionOnlyOrFullyMappedFilesDoNotWarn() throws Exception {
+        galeGlobal("_version: 1\ngameplay-mechanics:\n  enable-book-writing: true\n");
+        try (LogCapture log = new LogCapture("GaleConfigMigration")) {
+            migrate(leaf("global.yml", ""), leaf("defaults.yml", ""));
+            assertEquals(List.of(), log.warnings());
+        }
+    }
+
+    @Test
+    void missingSourcesDoNothing() throws Exception {
+        ConfigFile global = leaf("global.yml", "");
+        migrate(global, leaf("defaults.yml", ""));
+        assertNull(global.get(BOOK_LEAF));
+    }
+}
