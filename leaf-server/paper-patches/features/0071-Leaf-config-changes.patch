+++ b/src/test/java/org/dreeam/leaf/config/LeafConfigReloadTransactionTest.java
@@ -0,0 +1,300 @@
+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.bukkit.support.environment.LeafTest;
+import org.dreeam.leaf.config.annotations.ConfigClassInfo;
+import org.dreeam.leaf.config.annotations.ConfigInfo;
+import org.dreeam.leaf.config.modules.async.AsyncPathfinding;
+import org.dreeam.leaf.config.modules.gameplay.IceAndSnowChance;
+import org.dreeam.leaf.config.util.ConfigFileIO;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * {@link LeafConfig#reloadConfigs(List)}: the candidate is read and checked before anything changes, callbacks
+ * run before the files are saved, and there is no rollback. The server and its levels are replaced by the
+ * list of loaded levels.
+ */
+@LeafTest
+class LeafConfigReloadTransactionTest {
+
+    private static final Path CONFIG = Path.of("config");
+    private static final Path GLOBAL = CONFIG.resolve("leaf-global.yml");
+    private static final Path DEFAULTS = CONFIG.resolve("leaf-world-defaults.yml");
+    private static final Path WORLDS = Path.of("reload-test-worlds");
+    private static final String ICE = "gameplay-mechanisms.ice-and-snow-chance";
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "reload-callback-first")
+    public static final class FirstCallbackModule implements ConfigModule {
+
+        static boolean fail;
+        static int calls;
+        @ConfigInfo(name = "value")
+        public static int value = 1;
+
+        @Override
+        public void onLoaded() {
+            calls++;
+            if (fail) {
+                throw new IllegalStateException("callback failed");
+            }
+        }
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "reload-callback-second")
+    public static final class SecondCallbackModule implements ConfigModule {
+
+        static int calls;
+        @ConfigInfo(name = "value")
+        public static int value = 1;
+
+        @Override
+        public void onLoaded() {
+            calls++;
+        }
+    }
+
+    @BeforeEach
+    @AfterEach
+    void clean() throws Exception {
+        delete(CONFIG);
+        delete(WORLDS);
+        for (String name : List.of("GLOBAL_MODULES", "WORLD_MODULES")) {
+            Field field = LeafConfig.class.getDeclaredField(name);
+            field.setAccessible(true);
+            ((List<?>) field.get(null)).clear();
+        }
+        FirstCallbackModule.fail = false;
+        FirstCallbackModule.calls = 0;
+        SecondCallbackModule.calls = 0;
+        IceAndSnowChance.rawIceAndSnowChance = 48;
+    }
+
+    private static void delete(Path path) throws IOException {
+        if (Files.notExists(path, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try (Stream<Path> files = Files.walk(path)) {
+            for (Path file : (Iterable<Path>) files.sorted(Comparator.reverseOrder())::iterator) {
+                file.toFile().setWritable(true);
+                Files.delete(file);
+            }
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void registerCallbackModules() throws Exception {
+        Field field = LeafConfig.class.getDeclaredField("GLOBAL_MODULES");
+        field.setAccessible(true);
+        ((List<ConfigModule>) field.get(null)).addAll(List.of(new FirstCallbackModule(), new SecondCallbackModule()));
+    }
+
+    /** Starts the server configuration and returns the levels that are loaded. */
+    private static List<LeafConfig.LoadedLevel> start(String... worldNames) throws Exception {
+        LeafConfig.loadConfig();
+        registerCallbackModules();
+        LeafConfig.loadAfterBootstrap();
+        List<LeafConfig.LoadedLevel> levels = new ArrayList<>();
+        for (String name : worldNames) {
+            Path world = Files.createDirectories(WORLDS.resolve(name));
+            levels.add(new LeafConfig.LoadedLevel(world, LeafConfig.initWorldConfig(world)));
+        }
+        return levels;
+    }
+
+    private static void write(Path path, String content) throws IOException {
+        Files.writeString(path, content);
+    }
+
+    @Test
+    void reloadAppliesValuesRunsCallbacksAndSavesBeforeReturning() throws Exception {
+        start();
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 7\n");
+
+        LeafConfig.reloadConfigs(List.of());
+        assertEquals(7, IceAndSnowChance.rawIceAndSnowChance);
+        assertEquals(7, IceAndSnowChance.iceAndSnowChance);
+        assertEquals(7, ConfigFile.loadConfig(GLOBAL.toFile()).get(ICE));
+
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 9\n");
+        LeafConfig.reloadConfigs(List.of());
+        assertEquals(9, IceAndSnowChance.rawIceAndSnowChance);
+    }
+
+    @Test
+    void invalidCandidateChangesNothingAndWritesNothing() throws Exception {
+        start();
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 5\n  book-writing:\n    enabled: oops\n");
+        byte[] before = Files.readAllBytes(GLOBAL);
+        Files.delete(DEFAULTS); // missing, and must not appear
+
+        LeafConfig.ReloadException exception = assertThrows(LeafConfig.ReloadException.class, () -> LeafConfig.reloadConfigs(List.of()));
+
+        assertEquals(LeafConfig.ReloadStage.CANDIDATE, exception.stage());
+        assertEquals(48, IceAndSnowChance.rawIceAndSnowChance);
+        assertArrayEquals(before, Files.readAllBytes(GLOBAL));
+        assertFalse(Files.exists(DEFAULTS));
+        assertEquals(0, FirstCallbackModule.calls, "no callback ran");
+    }
+
+    @Test
+    void optionDeletedFromTheFileKeepsTheRunningValueAndIsWrittenBack() throws Exception {
+        start();
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 6\n");
+        LeafConfig.reloadConfigs(List.of());
+
+        write(GLOBAL, "config-version: '3.1'\n");
+        LeafConfig.reloadConfigs(List.of());
+
+        assertEquals(6, IceAndSnowChance.rawIceAndSnowChance);
+        assertEquals(6, ConfigFile.loadConfig(GLOBAL.toFile()).get(ICE));
+    }
+
+    @Test
+    void optionsThatCannotBeReloadedKeepTheirValueButAreSavedForTheNextStart() throws Exception {
+        start();
+        int keepalive = AsyncPathfinding.keepalive;
+        int calls = AsyncPathfinding.queueSize;
+        write(GLOBAL, "async:\n  async-pathfinding:\n    keepalive: " + (keepalive + 40) + "\n");
+
+        LeafConfig.reloadConfigs(List.of());
+
+        assertEquals(keepalive, AsyncPathfinding.keepalive);
+        assertEquals(calls, AsyncPathfinding.queueSize);
+        assertEquals(keepalive + 40, ConfigFile.loadConfig(GLOBAL.toFile()).get("async.async-pathfinding.keepalive"));
+    }
+
+    @Test
+    void firstFailingCallbackStopsTheCallbacksAndTheSave() throws Exception {
+        start();
+        FirstCallbackModule.calls = 0;
+        SecondCallbackModule.calls = 0;
+        FirstCallbackModule.fail = true;
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 8\nmisc:\n  reload-callback-first:\n    value: 5\n");
+        byte[] before = Files.readAllBytes(GLOBAL);
+
+        LeafConfig.ReloadException exception = assertThrows(LeafConfig.ReloadException.class, () -> LeafConfig.reloadConfigs(List.of()));
+
+        assertEquals(LeafConfig.ReloadStage.CALLBACK, exception.stage());
+        assertInstanceOf(IllegalStateException.class, exception.getCause());
+        assertEquals(1, FirstCallbackModule.calls);
+        assertEquals(0, SecondCallbackModule.calls, "callbacks after the failing one do not run");
+        assertArrayEquals(before, Files.readAllBytes(GLOBAL), "nothing is saved");
+        // Fields that were applied stay applied
+        assertEquals(8, IceAndSnowChance.rawIceAndSnowChance);
+        assertEquals(5, FirstCallbackModule.value);
+    }
+
+    @Test
+    void accessDeniedKeepsTheReloadActiveAndIsReported() throws Exception {
+        start();
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 11\n");
+        if (!GLOBAL.toFile().setReadOnly() || Files.isWritable(GLOBAL)) {
+            return; // permissions are not enforced here
+        }
+
+        ConfigFileIO.SaveReport report = LeafConfig.reloadConfigs(List.of());
+
+        assertEquals(11, IceAndSnowChance.rawIceAndSnowChance);
+        assertTrue(report.hasAccessDenied());
+        assertTrue(report.describe().contains("leaf-global.yml"), report.describe());
+    }
+
+    // ---- World overrides
+
+    private static Path override(String world, String content) throws IOException {
+        Path file = WORLDS.resolve(world).resolve("leaf-world.yml");
+        Files.createDirectories(file.getParent());
+        write(file, content);
+        return file;
+    }
+
+    @Test
+    void overridesOfLoadedWorldsAreMigratedByTheirOwnVersionAndOthersAreLeftAlone() throws Exception {
+        List<LeafConfig.LoadedLevel> started = start();
+        assertTrue(started.isEmpty());
+        // A world whose override went back to an old version after it was loaded, and one that is not loaded
+        Path loadedFile = override("loaded", "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+        Path unloadedFile = override("unloaded", "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+        LeafWorldConfig loadedConfig = LeafConfig.initWorldConfig(WORLDS.resolve("loaded"));
+        write(loadedFile, "config-version: '3.0'\nperformance:\n  save-fireworks: true\n"); // edited meanwhile
+        byte[] unloadedBytes = Files.readAllBytes(unloadedFile);
+
+        LeafConfig.reloadConfigs(List.of(new LeafConfig.LoadedLevel(WORLDS.resolve("loaded"), loadedConfig)));
+
+        assertTrue(loadedConfig.saveFireworks.enabled, "the edited override is read");
+        ConfigFile saved = ConfigFile.loadConfig(loadedFile.toFile());
+        assertEquals("3.1", String.valueOf(saved.get("config-version")));
+        assertEquals(true, saved.get("performance.save-fireworks"));
+        assertArrayEquals(unloadedBytes, Files.readAllBytes(unloadedFile));
+    }
+
+    @Test
+    void currentOverrideIsNotRewrittenAndNoFileIsCreatedForWorldsWithoutOne() throws Exception {
+        override("current", "config-version: '3.1'\nperformance:\n  save-fireworks: false\n");
+        List<LeafConfig.LoadedLevel> levels = start("current", "plain");
+        Path currentFile = WORLDS.resolve("current").resolve("leaf-world.yml");
+        byte[] before = Files.readAllBytes(currentFile);
+
+        LeafConfig.reloadConfigs(levels);
+
+        assertArrayEquals(before, Files.readAllBytes(currentFile));
+        assertFalse(Files.exists(WORLDS.resolve("plain").resolve("leaf-world.yml")));
+        assertFalse(levels.get(0).config().saveFireworks.enabled);
+        assertTrue(levels.get(1).config().saveFireworks.enabled);
+    }
+
+    @Test
+    void overrideThatCannotBeSavedDoesNotStopTheOtherFiles() throws Exception {
+        List<LeafConfig.LoadedLevel> started = start();
+        assertTrue(started.isEmpty());
+        Path file = override("denied", "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+        LeafWorldConfig config = LeafConfig.initWorldConfig(WORLDS.resolve("denied")); // rewrites the version
+        write(file, "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 13\n");
+        if (!file.toFile().setReadOnly() || Files.isWritable(file)) {
+            return; // permissions are not enforced here
+        }
+
+        ConfigFileIO.SaveReport report = LeafConfig.reloadConfigs(List.of(new LeafConfig.LoadedLevel(WORLDS.resolve("denied"), config)));
+
+        assertTrue(report.hasAccessDenied());
+        assertFalse(config.saveFireworks.enabled, "the migrated override is active in memory");
+        assertEquals("3.0", String.valueOf(ConfigFile.loadConfig(file.toFile()).get("config-version")));
+        assertEquals(13, ConfigFile.loadConfig(GLOBAL.toFile()).get(ICE));
+    }
+
+    @Test
+    void invalidOverrideVersionFailsTheReloadBeforeAnythingChanges() throws Exception {
+        start();
+        Path file = override("broken", "config-version: banana\n");
+        write(GLOBAL, "gameplay-mechanisms:\n  ice-and-snow-chance: 15\n");
+        byte[] before = Files.readAllBytes(file);
+        LeafWorldConfig config = new LeafWorldConfig(LeafConfig.worldDefaultsConfig().configFile, LeafWorldConfig.Source.WORLD_OVERRIDE);
+
+        LeafConfig.ReloadException exception = assertThrows(LeafConfig.ReloadException.class,
+            () -> LeafConfig.reloadConfigs(List.of(new LeafConfig.LoadedLevel(WORLDS.resolve("broken"), config))));
+
+        assertEquals(LeafConfig.ReloadStage.CANDIDATE, exception.stage());
+        assertEquals(48, IceAndSnowChance.rawIceAndSnowChance);
+        assertArrayEquals(before, Files.readAllBytes(file));
+    }
+}
