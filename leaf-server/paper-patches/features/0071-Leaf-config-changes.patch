+package org.dreeam.leaf.config;
+
+import org.bukkit.support.environment.LeafTest;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.file.FileAlreadyExistsException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Startup behavior of {@link LeafConfig#loadConfig()} that does not depend on config versions. The
+ * test works in the working directory of the test task, which is where the server reads {@code config/}.
+ */
+@LeafTest
+class LeafConfigInitializationTest {
+
+    private static final Path CONFIG = Path.of("config");
+    private static final List<Path> LEGACY = List.of(Path.of("pufferfish.yml"), Path.of("leaf.yml"), Path.of("leaf_config"));
+
+    @BeforeEach
+    @AfterEach
+    void clean() throws Exception {
+        delete(CONFIG);
+        for (Path legacy : LEGACY) {
+            delete(legacy);
+        }
+        clearList("GLOBAL_MODULES");
+        clearList("WORLD_MODULES");
+    }
+
+    private static void delete(Path path) throws IOException {
+        if (Files.notExists(path, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try (Stream<Path> files = Files.walk(path)) {
+            for (Path file : (Iterable<Path>) files.sorted(Comparator.reverseOrder())::iterator) {
+                Files.delete(file);
+            }
+        }
+    }
+
+    // loadConfig() registers the modules once per process; a test starts from an empty registry.
+    private static void clearList(String name) throws Exception {
+        Field field = LeafConfig.class.getDeclaredField(name);
+        field.setAccessible(true);
+        ((List<?>) field.get(null)).clear();
+    }
+
+    private static IllegalStateException loadFailure() {
+        return assertThrows(IllegalStateException.class, LeafConfig::loadConfig);
+    }
+
+    private static String messages(Throwable throwable) {
+        StringBuilder messages = new StringBuilder();
+        for (; throwable != null; throwable = throwable.getCause()) {
+            messages.append(throwable.getMessage()).append('\n');
+        }
+        return messages.toString();
+    }
+
+    @Test
+    void firstStartLoadsDefaultsWithoutCreatingFiles() {
+        LeafConfig.loadConfig();
+
+        // The files are written once the server has finished loading its registries.
+        assertFalse(Files.exists(CONFIG.resolve("leaf-global.yml")));
+        assertFalse(Files.exists(CONFIG.resolve("leaf-world-defaults.yml")));
+        assertTrue(LeafConfig.globalConfig().configFile.contains("config-version"));
+        assertTrue(LeafConfig.worldDefaultsConfig() != null);
+    }
+
+    @Test
+    void invalidScalarStopsStartupAndCreatesNothing() throws Exception {
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("leaf-global.yml"), "config-version: '3.1'\nasync:\n  parallel-world-ticking:\n    threads: abc\n");
+
+        IllegalStateException exception = loadFailure();
+        assertTrue(messages(exception).contains("async.parallel-world-ticking.threads"), messages(exception));
+        assertTrue(messages(exception).contains("leaf-global.yml"), messages(exception));
+        assertFalse(Files.exists(CONFIG.resolve("leaf-world-defaults.yml")));
+    }
+
+    @Test
+    void malformedDefaultsStopStartupWithoutCreatingTheMissingGlobalFile() throws Exception {
+        Files.createDirectories(CONFIG);
+        byte[] malformed = "a: [unterminated\nb: : :\n".getBytes();
+        Files.write(CONFIG.resolve("leaf-world-defaults.yml"), malformed);
+
+        IllegalStateException exception = loadFailure();
+        assertInstanceOf(IOException.class, exception.getCause());
+        assertFalse(Files.exists(CONFIG.resolve("leaf-global.yml")));
+        assertArrayEquals(malformed, Files.readAllBytes(CONFIG.resolve("leaf-world-defaults.yml")));
+    }
+
+    @Test
+    void configPathThatIsAFileIsNotDeleted() throws Exception {
+        Files.writeString(CONFIG, "not a directory");
+
+        IllegalStateException exception = loadFailure();
+        assertInstanceOf(FileAlreadyExistsException.class, exception.getCause());
+        assertEquals("not a directory", Files.readString(CONFIG));
+    }
+
+    @Test
+    void legacyFilesThatCannotBeMovedAreKeptAndOnlyWarn() throws Exception {
+        // config/ is a file, so the backup directory cannot be created. Moving the legacy file fails,
+        // which is not fatal; the start only stops because config/ itself is unusable.
+        Files.writeString(CONFIG, "not a directory");
+        Files.writeString(Path.of("leaf.yml"), "legacy: true\n");
+
+        IllegalStateException exception = loadFailure();
+        assertInstanceOf(FileAlreadyExistsException.class, exception.getCause());
+        assertEquals("legacy: true\n", Files.readString(Path.of("leaf.yml")));
+    }
+
+    @Test
+    void legacyFilesAreMovedToTheBackupDirectory() throws Exception {
+        Files.writeString(Path.of("pufferfish.yml"), "puffer: true\n");
+        Files.createDirectories(Path.of("leaf_config"));
+        Files.writeString(Path.of("leaf_config/old.yml"), "old: true\n");
+
+        LeafConfig.loadConfig();
+
+        assertFalse(Files.exists(Path.of("pufferfish.yml")));
+        assertFalse(Files.exists(Path.of("leaf_config")));
+        try (Stream<Path> backups = Files.list(CONFIG)) {
+            List<Path> directories = backups.filter(path -> path.getFileName().toString().startsWith("backup-")).toList();
+            assertEquals(1, directories.size());
+            assertTrue(Files.isRegularFile(directories.get(0).resolve("pufferfish.yml")));
+            assertTrue(Files.isRegularFile(directories.get(0).resolve("leaf_config/old.yml")));
+        }
+    }
+
+    @Test
+    void noBackupDirectoryWithoutLegacyFiles() throws Exception {
+        LeafConfig.loadConfig();
+        try (Stream<Path> entries = Files.list(CONFIG)) {
+            assertEquals(0, entries.filter(path -> path.getFileName().toString().startsWith("backup-")).count());
+        }
+        assertEquals(new File("config").getName(), CONFIG.getFileName().toString());
+    }
+
+    // ---- Saving after the registries are loaded
+
+    @Test
+    void savingWritesDefaultsAndGlobalWithTheCurrentVersion() throws Exception {
+        LeafConfig.loadConfig();
+        LeafConfig.loadAfterBootstrap();
+
+        Path global = CONFIG.resolve("leaf-global.yml");
+        assertTrue(Files.isRegularFile(global));
+        assertTrue(Files.isRegularFile(CONFIG.resolve("leaf-world-defaults.yml")));
+        String yaml = Files.readString(global);
+        assertTrue(yaml.contains("config-version: '3.1'") || yaml.contains("config-version: \"3.1\"") || yaml.contains("config-version: 3.1"), yaml);
+        assertTrue(yaml.contains("Leaf Config"), yaml);
+    }
+
+    @Test
+    void defaultsThatCannotBeSavedKeepTheirOwnVersionAndDoNotHoldBackTheGlobalFile() throws Exception {
+        Files.createDirectories(CONFIG);
+        Path global = CONFIG.resolve("leaf-global.yml");
+        Path defaults = CONFIG.resolve("leaf-world-defaults.yml");
+        Files.writeString(global, "config-version: '3.0'\n");
+        String defaultsContent = "config-version: '3.0'\nperformance:\n  save-fireworks: false\n";
+        Files.writeString(defaults, defaultsContent);
+        File defaultsFile = defaults.toFile();
+        if (!defaultsFile.setReadOnly() || Files.isWritable(defaults)) {
+            return; // permissions are not enforced here, for example when running as root
+        }
+
+        try {
+            LeafConfig.loadConfig();
+            LeafConfig.loadAfterBootstrap();
+
+            // Each file records its own progress: the defaults stay as they were and are migrated again next start.
+            assertEquals(defaultsContent, Files.readString(defaults));
+            assertTrue(Files.readString(global).contains("3.1"));
+            // The configuration in memory is complete and current
+            assertEquals("3.1", String.valueOf(LeafConfig.worldDefaultsConfig().configFile.get("config-version")));
+            assertFalse(LeafConfig.worldDefaultsConfig().saveFireworks.enabled);
+        } finally {
+            defaultsFile.setWritable(true);
+        }
+    }
+
+    // ---- Version of the world defaults
+
+    private static final String DEFAULTS_BODY = "performance:\n  save-fireworks: false\n";
+
+    private static List<String> defaultsWarnings(LogCapture log) {
+        return log.warnings().stream().filter(warning -> warning.contains("leaf-world-defaults.yml")).toList();
+    }
+
+    private static Path defaultsWith(String content) throws IOException {
+        Files.createDirectories(CONFIG);
+        return Files.writeString(CONFIG.resolve("leaf-world-defaults.yml"), content);
+    }
+
+    @Test
+    void defaultsGetTheCurrentVersionWhenSaved() throws Exception {
+        LeafConfig.loadConfig();
+        LeafConfig.loadAfterBootstrap();
+        String yaml = Files.readString(CONFIG.resolve("leaf-world-defaults.yml"));
+        assertTrue(yaml.contains("config-version"), yaml);
+        assertEquals("3.1", String.valueOf(io.github.thatsmusic99.configurationmaster.api.ConfigFile.loadConfig(CONFIG.resolve("leaf-world-defaults.yml").toFile()).get("config-version")));
+    }
+
+    @Test
+    void defaultsWithoutVersionWarnKeepTheirValuesAndAreCompletedOnce() throws Exception {
+        defaultsWith(DEFAULTS_BODY);
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            LeafConfig.loadConfig();
+            LeafConfig.loadAfterBootstrap();
+            assertEquals(1, defaultsWarnings(log).size(), defaultsWarnings(log).toString());
+            assertTrue(defaultsWarnings(log).get(0).contains("leaf-world-defaults.yml"), defaultsWarnings(log).get(0));
+        }
+        assertFalse(LeafConfig.worldDefaultsConfig().saveFireworks.enabled);
+        io.github.thatsmusic99.configurationmaster.api.ConfigFile saved = io.github.thatsmusic99.configurationmaster.api.ConfigFile.loadConfig(CONFIG.resolve("leaf-world-defaults.yml").toFile());
+        assertEquals("3.1", String.valueOf(saved.get("config-version")));
+        assertEquals(false, saved.get("performance.save-fireworks"));
+    }
+
+    @Test
+    void defaultsWithUnparsableVersionStopTheStartAndStayUntouched() throws Exception {
+        Path defaults = defaultsWith("config-version: banana\n" + DEFAULTS_BODY);
+        byte[] before = Files.readAllBytes(defaults);
+
+        IllegalStateException exception = loadFailure();
+        assertTrue(messages(exception).contains("banana") && messages(exception).contains("leaf-world-defaults.yml"), messages(exception));
+        assertArrayEquals(before, Files.readAllBytes(defaults));
+    }
+
+    @Test
+    void defaultsFromANewerVersionWarnAndKeepTheirVersion() throws Exception {
+        defaultsWith("config-version: '3.10'\n" + DEFAULTS_BODY);
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            LeafConfig.loadConfig();
+            LeafConfig.loadAfterBootstrap();
+            assertEquals(1, defaultsWarnings(log).size(), defaultsWarnings(log).toString());
+            assertTrue(defaultsWarnings(log).get(0).contains("3.10"), defaultsWarnings(log).get(0));
+        }
+        io.github.thatsmusic99.configurationmaster.api.ConfigFile saved = io.github.thatsmusic99.configurationmaster.api.ConfigFile.loadConfig(CONFIG.resolve("leaf-world-defaults.yml").toFile());
+        assertEquals("3.10", String.valueOf(saved.get("config-version")));
+    }
+
+    @Test
+    void globalVersionDoesNotDecideTheDefaults() throws Exception {
+        // A missing global file starts at the current version, the existing defaults keep being judged by their own.
+        defaultsWith("config-version: '3.10'\n" + DEFAULTS_BODY);
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            LeafConfig.loadConfig();
+            assertEquals(1, defaultsWarnings(log).size(), defaultsWarnings(log).toString());
+            assertTrue(defaultsWarnings(log).get(0).contains("leaf-world-defaults.yml"));
+        }
+    }
+}
