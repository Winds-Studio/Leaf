diff --git a/src/test/java/org/dreeam/leaf/config/ConfigBinderReloadTest.java b/src/test/java/org/dreeam/leaf/config/ConfigBinderReloadTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d4953f8d919f20dc82fe49eecb74266fd749a6fa
--- /dev/null
+++ b/src/test/java/org/dreeam/leaf/config/ConfigBinderReloadTest.java
@@ -0,0 +1,458 @@
+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.dreeam.leaf.config.annotations.ConfigClassInfo;
+import org.dreeam.leaf.config.annotations.ConfigInfo;
+import org.dreeam.leaf.config.annotations.DoNotLoad;
+import org.dreeam.leaf.config.annotations.HotReloadUnsupported;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Binder behavior: candidate values, fallbacks, value checks and the first-value snapshots. */
+@Tag("LeafTest")
+class ConfigBinderReloadTest {
+
+    @TempDir
+    Path temp;
+
+    private int fileCounter;
+
+    private enum Mode {
+        FIRST, SECOND
+    }
+
+    /** A bare configuration view; only the binder is under test. */
+    private static final class TestConfig extends LeafConfigAccessor {
+
+        TestConfig(ConfigFile file) {
+            super(file);
+        }
+    }
+
+    private File write(String content) throws Exception {
+        File file = temp.resolve("config-" + this.fileCounter++ + ".yml").toFile();
+        Files.writeString(file.toPath(), content);
+        return file;
+    }
+
+    private TestConfig load(String content) throws Exception {
+        return new TestConfig(ConfigFile.loadConfig(write(content)));
+    }
+
+    // ---- Modules
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "binder-test", comments = {"section comment"})
+    static final class Scalars implements ConfigModule {
+
+        @ConfigInfo(name = "flag", comments = {"flag comment"})
+        static boolean flag = true;
+        @ConfigInfo(name = "count")
+        static int count = 5;
+        @ConfigInfo(name = "big")
+        static long big = 6L;
+        @ConfigInfo(name = "ratio")
+        static double ratio = 1.5D;
+        @ConfigInfo(name = "text")
+        static String text = "default";
+        @ConfigInfo(name = "items")
+        static List<String> items = new ArrayList<>(List.of("a"));
+        @ConfigInfo(name = "mode")
+        static Mode mode = Mode.FIRST;
+        @DoNotLoad
+        static int derived = 11;
+
+        static void reset() {
+            flag = true;
+            count = 5;
+            big = 6L;
+            ratio = 1.5D;
+            text = "default";
+            items = new ArrayList<>(List.of("a"));
+            mode = Mode.FIRST;
+            derived = 11;
+        }
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "reload-test")
+    static final class Reloadable implements ConfigModule {
+
+        @ConfigInfo(name = "value")
+        static int value = 1;
+        @ConfigInfo(name = "other")
+        static int other = 2;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "field-fixed")
+    static final class FieldFixed implements ConfigModule {
+
+        @HotReloadUnsupported
+        @ConfigInfo(name = "fixed")
+        static int fixed = 1;
+        @ConfigInfo(name = "free")
+        static int free = 1;
+    }
+
+    @HotReloadUnsupported
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "class-fixed")
+    static final class ClassFixed implements ConfigModule {
+
+        @ConfigInfo(name = "first")
+        static int first = 1;
+        @ConfigInfo(name = "second")
+        static List<String> second = new ArrayList<>(List.of("x"));
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "world-test")
+    static final class WorldOptions implements WorldConfigModule {
+
+        @ConfigInfo(name = "plain")
+        int plain = 1;
+        @HotReloadUnsupported
+        @ConfigInfo(name = "fixed")
+        int fixed = 2;
+        @ConfigInfo(name = "items")
+        List<String> items = new ArrayList<>(List.of("a"));
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "world-plain")
+    static final class PlainWorldOptions implements WorldConfigModule {
+
+        @ConfigInfo(name = "plain")
+        int plain = 1;
+    }
+
+    private static List<ConfigBinder.PendingValue> collectGlobalReload(Object module, TestConfig config) throws Exception {
+        List<ConfigBinder.PendingValue> values = new ArrayList<>();
+        ConfigBinder.collectGlobalReload(module, config, values);
+        return values;
+    }
+
+    private static LeafWorldConfig worldContainer(TestConfig config) {
+        return new LeafWorldConfig(config.configFile, LeafWorldConfig.Source.WORLD_DEFAULTS);
+    }
+
+    // ---- Startup binding
+
+    @Test
+    void bindsEveryTypeFromFile() throws Exception {
+        Scalars.reset();
+        TestConfig config = load("""
+            misc:
+              binder-test:
+                flag: false
+                count: 9
+                big: 10000000000
+                ratio: 2.5
+                text: hello
+                items: [x, y]
+                mode: second
+            """);
+        ConfigBinder.bindGlobal(new Scalars(), config);
+
+        assertFalse(Scalars.flag);
+        assertEquals(9, Scalars.count);
+        assertEquals(10_000_000_000L, Scalars.big);
+        assertEquals(2.5D, Scalars.ratio);
+        assertEquals("hello", Scalars.text);
+        assertEquals(List.of("x", "y"), Scalars.items);
+        assertEquals(Mode.SECOND, Scalars.mode);
+        assertEquals(11, Scalars.derived); // @DoNotLoad fields are never touched
+    }
+
+    @Test
+    void missingAndNullOptionsUseCodeDefaultsAndAreWritten() throws Exception {
+        Scalars.reset();
+        File file = write("misc:\n  binder-test:\n    count:\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        ConfigBinder.bindGlobal(new Scalars(), config);
+
+        assertEquals(5, Scalars.count);
+        assertEquals("default", Scalars.text);
+        config.configFile.save();
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(5, saved.get("misc.binder-test.count"));
+        assertEquals("default", saved.get("misc.binder-test.text"));
+        assertEquals("FIRST", saved.get("misc.binder-test.mode"));
+        assertFalse(saved.contains("misc.binder-test.derived"));
+        String yaml = Files.readString(file.toPath());
+        assertTrue(yaml.contains("# section comment"));
+        assertTrue(yaml.contains("# flag comment"));
+    }
+
+    /** P1-8: a value written to the in-memory file before binding (a migrated option) must not be replaced by the default. */
+    @Test
+    void valueWrittenBeforeBindingSurvivesDefaultRegistration() throws Exception {
+        Scalars.reset();
+        File file = write("misc:\n  binder-test:\n    flag: true\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        config.configFile.set("misc.binder-test.count", 7); // as a migration does, the option is not in the file
+        config.configFile.set("misc.binder-test.flag", false); // an option that is in the file, overwritten
+        ConfigBinder.bindGlobal(new Scalars(), config);
+
+        assertEquals(7, Scalars.count);
+        assertFalse(Scalars.flag);
+        config.configFile.save();
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(7, saved.get("misc.binder-test.count"));
+        assertEquals(false, saved.get("misc.binder-test.flag"));
+    }
+
+    // ---- P2-7, P2-9: value checks
+
+    @Test
+    void acceptsQuotedNumbersAndCaseInsensitiveBooleans() throws Exception {
+        Scalars.reset();
+        TestConfig config = load("misc:\n  binder-test:\n    count: '10'\n    flag: FALSE\n    ratio: 3\n");
+        ConfigBinder.bindGlobal(new Scalars(), config);
+
+        assertEquals(10, Scalars.count);
+        assertFalse(Scalars.flag);
+        assertEquals(3.0D, Scalars.ratio);
+    }
+
+    @Test
+    void rejectsUnparsableScalarsWithFilePathAndType() throws Exception {
+        String[][] cases = {
+            {"count: abc", "misc.binder-test.count", "int"},
+            {"count: 1.5", "misc.binder-test.count", "int"},
+            {"big: nope", "misc.binder-test.big", "long"},
+            {"ratio: x", "misc.binder-test.ratio", "double"},
+            {"flag: oops", "misc.binder-test.flag", "boolean"},
+            {"mode: third", "misc.binder-test.mode", "one of"},
+        };
+        for (String[] testCase : cases) {
+            Scalars.reset();
+            File file = write("misc:\n  binder-test:\n    " + testCase[0] + "\n");
+            TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+            IllegalArgumentException exception = assertThrows(IllegalArgumentException.class,
+                () -> ConfigBinder.bindGlobal(new Scalars(), config), testCase[0]);
+            assertTrue(exception.getMessage().contains(testCase[1]), exception.getMessage());
+            assertTrue(exception.getMessage().contains(testCase[2]), exception.getMessage());
+            assertTrue(exception.getMessage().contains(file.getName()), exception.getMessage());
+            assertEquals(5, Scalars.count, "no field is applied when a value is rejected");
+        }
+    }
+
+    @Test
+    void rejectsValuesWithTheWrongStructure() throws Exception {
+        String[] cases = {
+            "text: [a, b]",
+            "text:\n      inner: 1",
+            "flag: [true]",
+            "count:\n      inner: 1",
+            "mode: [first]",
+            "items: scalar",
+            "items:\n      inner: 1",
+        };
+        for (String testCase : cases) {
+            Scalars.reset();
+            TestConfig config = load("misc:\n  binder-test:\n    " + testCase + "\n");
+            IllegalArgumentException exception = assertThrows(IllegalArgumentException.class,
+                () -> ConfigBinder.bindGlobal(new Scalars(), config), testCase);
+            assertTrue(exception.getMessage().contains("misc.binder-test."), exception.getMessage());
+        }
+    }
+
+    // ---- Reload candidates
+
+    @Test
+    void reloadCandidateDoesNotTouchFieldsUntilApplied() throws Exception {
+        Reloadable.value = 1;
+        Reloadable.other = 2;
+        TestConfig config = load("misc:\n  reload-test:\n    value: 8\n    other: bad\n");
+        assertThrows(IllegalArgumentException.class, () -> collectGlobalReload(new Reloadable(), config));
+        assertEquals(1, Reloadable.value);
+
+        TestConfig valid = load("misc:\n  reload-test:\n    value: 8\n");
+        List<ConfigBinder.PendingValue> values = collectGlobalReload(new Reloadable(), valid);
+        assertEquals(1, Reloadable.value);
+        ConfigBinder.applyAll(values);
+        assertEquals(8, Reloadable.value);
+    }
+
+    @Test
+    void globalReloadKeepsCurrentValueForMissingOptionsAndWritesItBack() throws Exception {
+        Reloadable.value = 40;
+        Reloadable.other = 50;
+        File file = write("misc:\n  reload-test:\n    value: 9\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        ConfigBinder.applyAll(collectGlobalReload(new Reloadable(), config));
+
+        assertEquals(9, Reloadable.value);
+        assertEquals(50, Reloadable.other); // deleted from the file: the running value, not the code default 2
+        config.configFile.save();
+        assertEquals(50, ConfigFile.loadConfig(file).get("misc.reload-test.other"));
+    }
+
+    @Test
+    void listsAreIndependentCopies() throws Exception {
+        Scalars.reset();
+        TestConfig config = load("misc:\n  binder-test:\n    items: [x]\n");
+        ConfigBinder.bindGlobal(new Scalars(), config);
+        List<String> bound = Scalars.items;
+        bound.add("mutated");
+        TestConfig again = load("misc:\n  binder-test:\n    items: [x]\n");
+        ConfigBinder.bindGlobal(new Scalars(), again);
+        assertEquals(List.of("x"), Scalars.items);
+        assertFalse(bound == Scalars.items);
+    }
+
+    // ---- First-value snapshots
+
+    @Test
+    void fieldLevelUnsupportedOptionsRestoreTheirFirstValue() throws Exception {
+        FieldFixed.fixed = 1;
+        FieldFixed.free = 1;
+        TestConfig first = load("misc:\n  field-fixed:\n    fixed: 3\n    free: 3\n");
+        ConfigBinder.bindGlobal(new FieldFixed(), first);
+        ConfigBinder.captureGlobalInitialValues(new FieldFixed());
+        assertEquals(3, FieldFixed.fixed);
+
+        File file = write("misc:\n  field-fixed:\n    fixed: 8\n    free: 8\n");
+        TestConfig reload = new TestConfig(ConfigFile.loadConfig(file));
+        ConfigBinder.applyAll(collectGlobalReload(new FieldFixed(), reload));
+        assertEquals(3, FieldFixed.fixed);
+        assertEquals(8, FieldFixed.free);
+        // The new value is still written to the file for the next start.
+        reload.configFile.save();
+        assertEquals(8, ConfigFile.loadConfig(file).get("misc.field-fixed.fixed"));
+    }
+
+    @Test
+    void classLevelUnsupportedModulesRestoreAllOptions() throws Exception {
+        TestConfig first = load("misc:\n  class-fixed:\n    first: 3\n    second: [y]\n");
+        ConfigBinder.bindGlobal(new ClassFixed(), first);
+        ConfigBinder.captureGlobalInitialValues(new ClassFixed());
+        List<String> captured = ClassFixed.second;
+
+        TestConfig reload = load("misc:\n  class-fixed:\n    first: 8\n    second: [z]\n");
+        ConfigBinder.applyAll(collectGlobalReload(new ClassFixed(), reload));
+        assertEquals(3, ClassFixed.first);
+        assertEquals(List.of("y"), ClassFixed.second);
+        assertFalse(captured == ClassFixed.second, "the restored list is a copy");
+    }
+
+    @Test
+    void worldSnapshotsBelongToTheirConfiguration() throws Exception {
+        // Two worlds are first bound with different values for an option that cannot be reloaded.
+        TestConfig defaultsConfig = load("misc:\n  world-test:\n    fixed: 2\n");
+        LeafWorldConfig defaultsHolder = worldContainer(defaultsConfig);
+        WorldOptions defaults = new WorldOptions();
+        ConfigBinder.bindWorldDefaults(defaults, defaults, defaultsConfig);
+        ConfigBinder.captureWorldInitialValues(defaults, defaultsHolder);
+
+        LeafWorldConfig worldA = worldContainer(load("misc:\n  world-test:\n    fixed: 2\n"));
+        WorldOptions a = new WorldOptions();
+        ConfigBinder.applyWorldDefaults(a, defaults);
+        ConfigBinder.bindWorldOverride(a, defaults, load("misc:\n  world-test:\n    fixed: 2\n"));
+        ConfigBinder.captureWorldInitialValues(a, worldA);
+
+        LeafWorldConfig worldB = worldContainer(load(""));
+        WorldOptions b = new WorldOptions();
+        ConfigBinder.applyWorldDefaults(b, defaults);
+        ConfigBinder.bindWorldOverride(b, defaults, load("misc:\n  world-test:\n    fixed: 4\n"));
+        ConfigBinder.captureWorldInitialValues(b, worldB);
+        assertEquals(2, a.fixed);
+        assertEquals(4, b.fixed);
+
+        // Both override files now say 8; reloading twice keeps each world at its first value.
+        for (int round = 0; round < 2; round++) {
+            for (WorldOptions[] world : new WorldOptions[][]{{a}, {b}}) {
+                WorldOptions active = world[0];
+                LeafWorldConfig holder = active == a ? worldA : worldB;
+                WorldOptions candidate = new WorldOptions();
+                ConfigBinder.applyWorldDefaults(candidate, defaults);
+                ConfigBinder.bindWorldOverride(candidate, defaults, load("misc:\n  world-test:\n    fixed: 8\n"));
+                List<ConfigBinder.PendingValue> values = new ArrayList<>();
+                ConfigBinder.collectWorldReload(active, candidate, holder.initialValues(), values);
+                ConfigBinder.applyAll(values);
+            }
+        }
+        assertEquals(2, a.fixed);
+        assertEquals(4, b.fixed);
+
+        // A world that is unloaded and loaded again starts from the current override.
+        LeafWorldConfig worldBAgain = worldContainer(load(""));
+        WorldOptions bAgain = new WorldOptions();
+        ConfigBinder.applyWorldDefaults(bAgain, defaults);
+        ConfigBinder.bindWorldOverride(bAgain, defaults, load("misc:\n  world-test:\n    fixed: 8\n"));
+        ConfigBinder.captureWorldInitialValues(bAgain, worldBAgain);
+        assertEquals(8, bAgain.fixed);
+        assertEquals(8, worldBAgain.initialValues().values().iterator().next());
+    }
+
+    @Test
+    void worldConfigurationWithoutUnsupportedOptionsAllocatesNoSnapshot() throws Exception {
+        TestConfig config = load("");
+        LeafWorldConfig holder = worldContainer(config);
+        PlainWorldOptions module = new PlainWorldOptions();
+        ConfigBinder.bindWorldDefaults(module, module, config);
+        ConfigBinder.captureWorldInitialValues(module, holder);
+        assertNull(holder.initialValues());
+    }
+
+    @Test
+    void worldDefaultsReloadFallsBackToTheActiveModuleAndOverridesInheritDefaults() throws Exception {
+        WorldOptions active = new WorldOptions();
+        active.plain = 40;
+        active.items = new ArrayList<>(List.of("kept"));
+
+        // The candidate defaults file lacks both options: the active values are kept and written back.
+        File file = write("misc:\n  world-test:\n    fixed: 2\n");
+        TestConfig defaultsConfig = new TestConfig(ConfigFile.loadConfig(file));
+        WorldOptions candidate = new WorldOptions();
+        ConfigBinder.bindWorldDefaults(candidate, active, defaultsConfig);
+        assertEquals(40, candidate.plain);
+        assertEquals(List.of("kept"), candidate.items);
+        assertFalse(candidate.items == active.items);
+        defaultsConfig.configFile.save();
+        assertEquals(40, ConfigFile.loadConfig(file).get("misc.world-test.plain"));
+
+        // An override that only defines one option inherits the rest from the candidate defaults and
+        // does not complete its file.
+        File overrideFile = write("misc:\n  world-test:\n    plain: 5\n");
+        TestConfig overrideConfig = new TestConfig(ConfigFile.loadConfig(overrideFile));
+        WorldOptions world = new WorldOptions();
+        ConfigBinder.applyWorldDefaults(world, candidate);
+        ConfigBinder.bindWorldOverride(world, candidate, overrideConfig);
+        assertEquals(5, world.plain);
+        assertEquals(List.of("kept"), world.items);
+        assertFalse(world.items == candidate.items);
+        overrideConfig.configFile.save();
+        ConfigFile savedOverride = ConfigFile.loadConfig(overrideFile);
+        assertFalse(savedOverride.contains("misc.world-test.items"));
+    }
+
+    @Test
+    void worldOverrideRejectsInvalidValues() throws Exception {
+        WorldOptions defaults = new WorldOptions();
+        WorldOptions world = new WorldOptions();
+        ConfigBinder.applyWorldDefaults(world, defaults);
+        TestConfig config = load("misc:\n  world-test:\n    plain: abc\n");
+        assertThrows(IllegalArgumentException.class, () -> ConfigBinder.bindWorldOverride(world, defaults, config));
+        assertEquals(1, world.plain);
+    }
+
+    @Test
+    void sameWorldConfigIsReturnedForEveryCapture() throws Exception {
+        TestConfig config = load("");
+        LeafWorldConfig holder = worldContainer(config);
+        WorldOptions module = new WorldOptions();
+        ConfigBinder.captureWorldInitialValues(module, holder);
+        assertSame(holder.initialValues(), holder.initialValuesForCapture());
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/ConfigLibraryBehaviorTest.java b/src/test/java/org/dreeam/leaf/config/ConfigLibraryBehaviorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7c9cc7ba6633663163e0f03b272a4778bce48756
--- /dev/null
+++ b/src/test/java/org/dreeam/leaf/config/ConfigLibraryBehaviorTest.java
@@ -0,0 +1,163 @@
+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import io.github.thatsmusic99.configurationmaster.api.ConfigSection;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Pins down the ConfigurationMaster {@code v2.0.0-rc.3} behavior that the Leaf configuration framework
+ * relies on. A failure here means the library changed and the binder, migration and IO assumptions
+ * documented in plans/leaf-config-refactor must be re-checked.
+ */
+@Tag("LeafTest")
+class ConfigLibraryBehaviorTest {
+
+    @TempDir
+    Path temp;
+
+    private File write(String content) throws Exception {
+        File file = temp.resolve("config.yml").toFile();
+        Files.writeString(file.toPath(), content);
+        return file;
+    }
+
+    /** Walking sections with getKeys(false, true) lists every key; deep listings leave nested keys out. */
+    @Test
+    void sectionsCanBeWalkedForTheirKeys() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("_version: 1\na:\n  b: 1\n  c:\n    d: 2\ne: x\nn:\nempty: {}\n"));
+        assertEquals(List.of("_version", "a", "e", "n", "empty"), config.getKeys(false, true));
+        ConfigSection section = assertInstanceOf(ConfigSection.class, config.get("a"));
+        assertEquals(List.of("b", "c"), section.getKeys(false, true));
+        ConfigSection nested = assertInstanceOf(ConfigSection.class, section.get("c"));
+        assertEquals(List.of("d"), nested.getKeys(false, true));
+        assertEquals(2, config.get("a.c.d"));
+        assertNull(config.get("n"));
+    }
+
+    /** P1-9: loading a missing file creates it immediately. */
+    @Test
+    void loadingMissingFileCreatesIt() throws Exception {
+        File file = temp.resolve("missing.yml").toFile();
+        assertFalse(file.exists());
+        ConfigFile.loadConfig(file);
+        assertTrue(file.exists());
+    }
+
+    /** P1-9: constructing a ConfigFile directly neither creates nor reads the file, and it saves like a loaded one. */
+    @Test
+    void constructingConfigFileDoesNotCreateIt() throws Exception {
+        File file = temp.resolve("nested").resolve("fresh.yml").toFile();
+        ConfigFile config = new ConfigFile(file);
+        assertFalse(file.exists());
+        assertFalse(file.getParentFile().exists());
+        config.addDefault("a", 1, "comment");
+        file.getParentFile().mkdirs();
+        config.save();
+        assertTrue(file.exists());
+        ConfigFile reloaded = ConfigFile.loadConfig(file);
+        assertEquals(1, reloaded.get("a"));
+        assertTrue(Files.readString(file.toPath()).contains("# comment"));
+    }
+
+    /** P1-8: addDefault replaces a value written by set() with the loaded value or the default. */
+    @Test
+    void addDefaultOverwritesValuesSetAfterLoad() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("known: 3\n"));
+
+        config.set("migrated", 9);
+        config.addDefault("migrated", 1);
+        assertEquals(1, config.get("migrated")); // migrated value lost, replaced by the default
+
+        config.set("known", 5);
+        assertEquals(5, config.get("known"));
+        config.addDefault("known", 0);
+        assertEquals(3, config.get("known")); // replaced by the value loaded from the file
+
+        // The value can be restored by writing it again after registration, comments survive.
+        config.set("migrated", 9);
+        config.set("known", 5);
+        config.addComment("known", "known comment");
+        assertEquals(9, config.get("migrated"));
+        assertEquals(5, config.get("known"));
+    }
+
+    /** P1-8: set(path, null) does not hide a value loaded from the file. */
+    @Test
+    void setNullDoesNotHideLoadedValue() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("old: 9\n"));
+        config.set("old", null);
+        assertTrue(config.contains("old"));
+        assertEquals(9, config.get("old"));
+
+        config.set("runtime", 1);
+        config.set("runtime", null);
+        assertFalse(config.contains("runtime"));
+    }
+
+    /** P1-11, P2-17: save writes only registered or explicitly set keys; unregistered loaded keys are dropped. */
+    @Test
+    void saveWritesOnlyRegisteredKeys() throws Exception {
+        File file = write("known: 1\nextra: 2\nsec:\n  inner: 3\n  other: 4\n");
+        ConfigFile config = ConfigFile.loadConfig(file);
+        assertTrue(config.contains("extra"));
+        config.addDefault("known", 0, "known comment");
+        config.addDefault("sec.inner", 0);
+        config.set("explicit", 8);
+        config.save();
+
+        ConfigFile reloaded = ConfigFile.loadConfig(file);
+        assertEquals(1, reloaded.get("known"));
+        assertEquals(3, reloaded.get("sec.inner"));
+        assertEquals(8, reloaded.get("explicit"));
+        assertFalse(reloaded.contains("extra"));
+        assertFalse(reloaded.contains("sec.other"));
+        assertTrue(Files.readString(file.toPath()).contains("# known comment"));
+    }
+
+    /** Explicit null: still contained, reads as null, and is not replaced by addDefault. */
+    @Test
+    void explicitNullIsPresentButNotReplacedByDefault() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("n:\nm: abc\n"));
+        assertTrue(config.contains("n"));
+        assertNull(config.get("n"));
+        config.addDefault("n", 5);
+        assertNull(config.get("n"));
+        config.set("n", 5);
+        assertEquals(5, config.get("n"));
+    }
+
+    /** P2-7: the library's fallback getters hide unparsable scalars. */
+    @Test
+    void fallbackGettersHideUnparsableScalars() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("m: abc\nd: 1.5\nq: '10'\nb: oops\nT: TRUE\n"));
+        assertEquals(42, config.getInteger("m", 42));
+        assertEquals(42L, config.getLong("m", 42L));
+        assertEquals(4.5D, config.getDouble("m", 4.5D));
+        assertEquals(42, config.getInteger("d", 42));
+        assertEquals(10, config.getInteger("q", 42));
+        assertEquals(true, config.getBoolean("b", true));
+        assertEquals(false, config.getBoolean("b", false));
+    }
+
+    /** P2-9: raw values keep their structure; getString stringifies lists. */
+    @Test
+    void rawValuesKeepStructure() throws Exception {
+        ConfigFile config = ConfigFile.loadConfig(write("l: [a, b]\nsec:\n  k: v\n"));
+        assertInstanceOf(List.class, config.get("l"));
+        assertInstanceOf(ConfigSection.class, config.get("sec"));
+        assertEquals("[a, b]", config.getString("l", "d"));
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/ConfigModuleCallbackTest.java b/src/test/java/org/dreeam/leaf/config/ConfigModuleCallbackTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..31ce19ee345bfb8fa94c8c6d351a1e91264cc849
--- /dev/null
+++ b/src/test/java/org/dreeam/leaf/config/ConfigModuleCallbackTest.java
@@ -0,0 +1,274 @@
+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.level.NaturalSpawner;
+import org.bukkit.support.environment.LeafTest;
+import org.dreeam.leaf.config.modules.async.AsyncPathfinding;
+import org.dreeam.leaf.config.modules.async.MultithreadedTracker;
+import org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking;
+import org.dreeam.leaf.config.modules.fixes.MCBugFix;
+import org.dreeam.leaf.config.modules.gameplay.IceAndSnowChance;
+import org.dreeam.leaf.config.modules.misc.ConnectionMessage;
+import org.dreeam.leaf.config.modules.misc.RegionFormatConfig;
+import org.dreeam.leaf.config.modules.misc.VanillaUsernameCheck;
+import org.dreeam.leaf.config.modules.opt.FastRNG;
+import org.dreeam.leaf.config.modules.opt.ThrottleNaturalMobSpawning;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Module callbacks must leave the configuration fields as they were read and put derived values into
+ * {@code @DoNotLoad} fields (P1-16), and the options that decide world generation must not change on reload (P1-7).
+ */
+@LeafTest
+class ConfigModuleCallbackTest {
+
+    @TempDir
+    Path temp;
+
+    private int fileCounter;
+
+    private static final class TestConfig extends LeafConfigAccessor {
+
+        TestConfig(ConfigFile file) {
+            super(file);
+        }
+    }
+
+    private File write(String content) throws Exception {
+        File file = temp.resolve("config-" + this.fileCounter++ + ".yml").toFile();
+        Files.writeString(file.toPath(), content);
+        return file;
+    }
+
+    private TestConfig load(String content) throws Exception {
+        return new TestConfig(ConfigFile.loadConfig(write(content)));
+    }
+
+    private static void bind(ConfigModule module, TestConfig config) throws Exception {
+        ConfigBinder.bindGlobal(module, config);
+        module.onLoaded();
+    }
+
+    private static void reload(ConfigModule module, TestConfig config) throws Exception {
+        List<ConfigBinder.PendingValue> values = new ArrayList<>();
+        ConfigBinder.collectGlobalReload(module, config, values);
+        ConfigBinder.applyAll(values);
+        module.onLoaded();
+    }
+
+    private static void resetSnapshots() throws Exception {
+        Field field = ConfigBinder.class.getDeclaredField("INITIAL_GLOBAL_VALUES");
+        field.setAccessible(true);
+        ((Map<?, ?>) field.get(null)).clear();
+    }
+
+    private static void resetFastRng() throws Exception {
+        resetSnapshots();
+        Field decided = FastRNG.class.getDeclaredField("worldgenDecided");
+        decided.setAccessible(true);
+        decided.setBoolean(null, false);
+        FastRNG.worldgen = false;
+        FastRNG.enabled = false;
+    }
+
+    // ---- P1-7
+
+    @Test
+    void fastRngWorldgenDecisionSurvivesReload() throws Exception {
+        resetFastRng();
+        String on = "performance:\n  faster-random-generator:\n    enabled: true\n    enable-for-worldgen: true\n";
+        String off = "performance:\n  faster-random-generator:\n    enabled: false\n    enable-for-worldgen: true\n";
+        FastRNG module = new FastRNG();
+        bind(module, load(on));
+        ConfigBinder.captureGlobalInitialValues(module);
+        assertTrue(FastRNG.enabled);
+        assertTrue(FastRNG.worldgenEnabled());
+
+        // The main switch can be turned off by a reload, the world generation random source cannot.
+        File file = write(off);
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        reload(module, config);
+        reload(module, config);
+        assertFalse(FastRNG.rawEnabled);
+        assertFalse(FastRNG.enabled);
+        assertTrue(FastRNG.worldgenEnabled());
+        config.configFile.save();
+        assertEquals(false, ConfigFile.loadConfig(file).get("performance.faster-random-generator.enabled"));
+    }
+
+    @Test
+    void fastRngWorldgenStaysDisabledWhenFirstDecisionWasDisabled() throws Exception {
+        resetFastRng();
+        FastRNG module = new FastRNG();
+        bind(module, load("performance:\n  faster-random-generator:\n    enabled: false\n    enable-for-worldgen: true\n"));
+        ConfigBinder.captureGlobalInitialValues(module);
+        assertFalse(FastRNG.worldgenEnabled());
+
+        reload(module, load("performance:\n  faster-random-generator:\n    enabled: true\n    enable-for-worldgen: true\n"));
+        assertTrue(FastRNG.rawEnabled);
+        assertTrue(FastRNG.enabled);
+        assertFalse(FastRNG.worldgenEnabled());
+    }
+
+    @Test
+    void fastRngDoesNotWriteDerivedStateToTheFile() throws Exception {
+        resetFastRng();
+        File file = write("performance:\n  faster-random-generator:\n    enabled: true\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        bind(new FastRNG(), config);
+        config.configFile.save();
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(true, saved.get("performance.faster-random-generator.enabled"));
+        assertFalse(saved.contains("performance.faster-random-generator.worldgen"));
+        assertFalse(saved.contains("performance.faster-random-generator.active"));
+    }
+
+    // ---- P1-16
+
+    @Test
+    void asyncPathfindingKeepsOptionsAndDerivesEffectiveValues() throws Exception {
+        resetSnapshots();
+        AsyncPathfinding module = new AsyncPathfinding();
+        File file = write("async:\n  async-pathfinding:\n    enabled: false\n    max-threads: -3\n    queue-size: -5\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        bind(module, config);
+        ConfigBinder.captureGlobalInitialValues(module);
+
+        assertEquals(-3, AsyncPathfinding.rawMaxThreads);
+        assertEquals(-5, AsyncPathfinding.rawQueueSize);
+        assertEquals(0, AsyncPathfinding.maxThreads);
+        assertEquals(0, AsyncPathfinding.queueSize);
+        config.configFile.save();
+        assertEquals(-3, ConfigFile.loadConfig(file).get("async.async-pathfinding.max-threads"));
+
+        // The first values restored by a reload are the options as read, not the derived values.
+        reload(module, load("async:\n  async-pathfinding:\n    max-threads: 7\n"));
+        assertEquals(-3, AsyncPathfinding.rawMaxThreads);
+    }
+
+    @Test
+    void multithreadedTrackerKeepsThreadsOption() throws Exception {
+        resetSnapshots();
+        MultithreadedTracker module = new MultithreadedTracker();
+        bind(module, load("async:\n  async-entity-tracker:\n    enabled: false\n    threads: -2\n"));
+        assertEquals(-2, MultithreadedTracker.rawThreads);
+        assertEquals(Math.max(Math.min(Runtime.getRuntime().availableProcessors(), 4), 1), MultithreadedTracker.threads);
+    }
+
+    @Test
+    void parallelWorldTickingKeepsOptionsAndDerivesThreads() throws Exception {
+        resetSnapshots();
+        boolean enabled = SparklyPaperParallelWorldTicking.enabled;
+        try {
+            SparklyPaperParallelWorldTicking module = new SparklyPaperParallelWorldTicking();
+            bind(module, load("async:\n  parallel-world-ticking:\n    enabled: true\n    threads: -1\n    disable-hard-throw: true\n"));
+            assertEquals(-1, SparklyPaperParallelWorldTicking.rawThreads);
+            assertEquals(8, SparklyPaperParallelWorldTicking.threads);
+            assertTrue(SparklyPaperParallelWorldTicking.disableHardThrow);
+
+            resetSnapshots();
+            bind(module, load("async:\n  parallel-world-ticking:\n    enabled: false\n    threads: 4\n"));
+            assertEquals(4, SparklyPaperParallelWorldTicking.rawThreads);
+            assertEquals(0, SparklyPaperParallelWorldTicking.threads);
+        } finally {
+            SparklyPaperParallelWorldTicking.enabled = enabled;
+        }
+    }
+
+    @Test
+    void iceAndSnowChanceKeepsOption() throws Exception {
+        IceAndSnowChance module = new IceAndSnowChance();
+        File file = write("gameplay-mechanisms:\n  ice-and-snow-chance: -4\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        bind(module, config);
+        assertEquals(-4, IceAndSnowChance.rawIceAndSnowChance);
+        assertEquals(48, IceAndSnowChance.iceAndSnowChance);
+
+        // The option is not rewritten by a reload either, even when its key was deleted from the file.
+        reload(module, load(""));
+        assertEquals(-4, IceAndSnowChance.rawIceAndSnowChance);
+        config.configFile.save();
+        assertEquals(-4, ConfigFile.loadConfig(file).get("gameplay-mechanisms.ice-and-snow-chance"));
+    }
+
+    @Test
+    void connectionMessageKeepsLegacyPlaceholdersInTheOption() throws Exception {
+        File file = write("misc:\n  connection-message:\n    join:\n      message: '%player_name% joined'\n");
+        TestConfig config = new TestConfig(ConfigFile.loadConfig(file));
+        bind(new ConnectionMessage(), config);
+        assertEquals("%player_name% joined", ConnectionMessage.rawJoinMessage);
+        assertEquals("<player_name> joined", ConnectionMessage.joinMessage);
+        assertEquals("default", ConnectionMessage.quitMessage);
+        config.configFile.save();
+        assertEquals("%player_name% joined", ConfigFile.loadConfig(file).get("misc.connection-message.join.message"));
+    }
+
+    @Test
+    void mcBugFixKeepsMaxEntriesOption() throws Exception {
+        bind(new MCBugFix(), load("fixes:\n  vanilla-bug-fix:\n    mc-301114-max-entries: 0\n"));
+        assertEquals(0, MCBugFix.rawMc301114maxCombatEntries);
+        assertEquals(1, MCBugFix.mc301114maxCombatEntries);
+    }
+
+    @Test
+    void vanillaUsernameCheckKeepsConflictingOption() throws Exception {
+        resetSnapshots();
+        VanillaUsernameCheck module = new VanillaUsernameCheck();
+        bind(module, load("misc:\n  vanilla-username-check:\n    remove-all-check: true\n    use-username-regex: true\n"));
+        assertTrue(VanillaUsernameCheck.rawRemoveAllCheck);
+        assertFalse(VanillaUsernameCheck.removeAllCheck);
+        assertTrue(VanillaUsernameCheck.shouldSkipNonPlayerNameCheck());
+    }
+
+    @Test
+    void regionFormatKeepsCompressionLevelOption() throws Exception {
+        resetSnapshots();
+        bind(new RegionFormatConfig(), load("misc:\n  region-format:\n    format-name: LINEAR_V2\n    compress-level: 99\n"));
+        assertEquals(99, RegionFormatConfig.rawCompressionLevel);
+        assertEquals(1, RegionFormatConfig.compressionLevel);
+    }
+
+    // ---- Dynamic keys of ThrottleNaturalMobSpawning
+
+    @Test
+    void throttleMobSpawningReadsDynamicKeysAndWritesDefaultsInPercent() throws Exception {
+        MobCategory[] categories = NaturalSpawner.SPAWNING_CATEGORIES;
+        String custom = "performance.throttle-mob-spawning." + categories[0].getSerializedName();
+        File file = write("performance:\n  throttle-mob-spawning:\n    " + categories[0].getSerializedName()
+            + ":\n      min-failed: 3\n      spawn-chance: 50.0\n");
+        LeafGlobalConfig global = new LeafGlobalConfig(ConfigFile.loadConfig(file), org.dreeam.leaf.config.util.ConfigVersion.Check.current());
+        Field field = LeafConfig.class.getDeclaredField("globalConfig");
+        field.setAccessible(true);
+        field.set(null, global);
+
+        ThrottleNaturalMobSpawning module = new ThrottleNaturalMobSpawning();
+        module.onLoaded();
+
+        assertEquals(3L, ThrottleNaturalMobSpawning.failedAttempts[0]);
+        assertEquals(Math.round(0.5D * Integer.MAX_VALUE), ThrottleNaturalMobSpawning.spawnChance[0]);
+        assertEquals(8L, ThrottleNaturalMobSpawning.failedAttempts[1]); // deleted key: the code default
+        assertEquals(Math.round(0.25D * Integer.MAX_VALUE), ThrottleNaturalMobSpawning.spawnChance[1]);
+
+        global.configFile.save();
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(3, saved.get(custom + ".min-failed"));
+        assertEquals(50.0D, saved.get(custom + ".spawn-chance")); // the file unit is a percentage
+        String other = "performance.throttle-mob-spawning." + categories[1].getSerializedName();
+        assertEquals(8, saved.get(other + ".min-failed"));
+        assertEquals(25.0D, saved.get(other + ".spawn-chance"));
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/ConfigModuleContractTest.java b/src/test/java/org/dreeam/leaf/config/ConfigModuleContractTest.java
