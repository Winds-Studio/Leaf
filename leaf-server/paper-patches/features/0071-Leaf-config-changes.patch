+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.dreeam.leaf.config.migration.LeafConfigMigration;
+import org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities;
+import org.dreeam.leaf.config.util.ConfigVersion;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+/** Migrated values go through the binder and the saved file unchanged (P1-8). */
+@Tag("LeafTest")
+class LeafConfigMigrationBindingTest {
+
+    @TempDir
+    Path temp;
+
+    private static final class TestConfig extends LeafConfigAccessor {
+
+        TestConfig(ConfigFile file) {
+            super(file);
+        }
+    }
+
+    @Test
+    void leafRenameKeepsANonDefaultValueThroughBindingAndSaving() throws Exception {
+        File file = temp.resolve("global.yml").toFile();
+        Files.writeString(file.toPath(), "performance:\n  optimise-block-entities: false\n");
+        ConfigFile global = ConfigFile.loadConfig(file);
+        ConfigFile defaults = ConfigFile.loadConfig(temp.resolve("defaults.yml").toFile());
+        LeafConfigMigration.migrate(global, defaults, List.of(OptimizeBlockEntities.class), ConfigVersion.parse("3.0"), ConfigVersion.parse("3.1"));
+
+        OptimizeBlockEntities.enabled = true;
+        ConfigBinder.bindGlobal(new OptimizeBlockEntities(), new TestConfig(global));
+        assertFalse(OptimizeBlockEntities.enabled);
+        global.save();
+
+        ConfigFile saved = ConfigFile.loadConfig(file);
+        assertEquals(false, saved.get("performance.optimize-block-entities"));
+        assertFalse(saved.contains("performance.optimise-block-entities"));
+
+        // Reading the saved file again gives the same value
+        OptimizeBlockEntities.enabled = true;
+        ConfigBinder.bindGlobal(new OptimizeBlockEntities(), new TestConfig(saved));
+        assertFalse(OptimizeBlockEntities.enabled);
+        OptimizeBlockEntities.enabled = true;
+    }
+}
diff --git a/src/test/java/org/dreeam/leaf/config/LeafConfigReloadTransactionTest.java b/src/test/java/org/dreeam/leaf/config/LeafConfigReloadTransactionTest.java
