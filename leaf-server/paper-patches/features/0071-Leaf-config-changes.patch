+package org.dreeam.leaf.config;
+
+import io.github.classgraph.ClassGraph;
+import io.github.classgraph.ClassInfo;
+import io.github.classgraph.ScanResult;
+import org.dreeam.leaf.config.annotations.ConfigClassInfo;
+import org.dreeam.leaf.config.annotations.ConfigInfo;
+import org.dreeam.leaf.config.annotations.DoNotLoad;
+import org.dreeam.leaf.config.annotations.HotReloadUnsupported;
+import org.dreeam.leaf.config.migration.ConfigMigrationContext;
+import org.dreeam.leaf.config.util.ConfigPaths;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.lang.reflect.ParameterizedType;
+import java.lang.reflect.Type;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Checks the rules that configuration modules must follow. The binder does not check any of them at
+ * runtime, so a module that breaks a rule is only caught here.
+ */
+@Tag("LeafTest")
+class ConfigModuleContractTest {
+
+    private static final String MODULE_PACKAGE = "org.dreeam.leaf.config.modules";
+
+    // ---- Real modules
+
+    @Test
+    void everyGlobalModuleFollowsTheContract() throws Exception {
+        List<Class<?>> modules = modules(ConfigModule.class);
+        assertFalse(modules.isEmpty());
+        List<String> violations = new ArrayList<>();
+        for (Class<?> module : modules) {
+            violations.addAll(check(module, false, true));
+        }
+        violations.addAll(checkPaths(modules));
+        assertEquals(List.of(), violations);
+    }
+
+    @Test
+    void everyWorldModuleFollowsTheContract() throws Exception {
+        List<Class<?>> modules = modules(WorldConfigModule.class);
+        assertFalse(modules.isEmpty());
+        List<String> violations = new ArrayList<>();
+        for (Class<?> module : modules) {
+            violations.addAll(check(module, true, true));
+        }
+        violations.addAll(checkPaths(modules));
+        assertEquals(List.of(), violations);
+    }
+
+    @Test
+    void globalAndWorldModulesDoNotShareOptionsOrSections() throws Exception {
+        // Defaults and overrides share one schema, and the global file has its own; a module is never both.
+        for (Class<?> module : modules(WorldConfigModule.class)) {
+            assertFalse(ConfigModule.class.isAssignableFrom(module), module.getName());
+        }
+    }
+
+    @Test
+    void everyWorldModuleIsExposedByExactlyOneLeafWorldConfigField() {
+        Map<Class<?>, Integer> exposed = new HashMap<>();
+        for (Field field : LeafWorldConfig.class.getDeclaredFields()) {
+            if (WorldConfigModule.class.isAssignableFrom(field.getType())) {
+                exposed.merge(field.getType(), 1, Integer::sum);
+                assertFalse(Modifier.isStatic(field.getModifiers()), field.toString());
+            }
+        }
+        List<Class<?>> modules = modules(WorldConfigModule.class);
+        for (Class<?> module : modules) {
+            assertEquals(1, exposed.getOrDefault(module, 0), "Expected one LeafWorldConfig field of " + module.getName());
+        }
+        assertEquals(modules.size(), exposed.size(), "LeafWorldConfig exposes a module that is not part of the module package");
+    }
+
+    @Test
+    void modulePackagesFollowTheirScope() {
+        // Global modules sit directly in their category package; world modules sit in its world subpackage.
+        List<String> violations = new ArrayList<>();
+        for (Class<?> module : modules(ConfigModule.class)) {
+            String relative = module.getPackageName().substring(MODULE_PACKAGE.length() + 1);
+            if (relative.contains(".")) {
+                violations.add(module.getName() + " is global and must sit directly in a category package");
+            }
+        }
+        for (Class<?> module : modules(WorldConfigModule.class)) {
+            String relative = module.getPackageName().substring(MODULE_PACKAGE.length() + 1);
+            String[] parts = relative.split("\\.");
+            if (parts.length != 2 || !parts[1].equals("world")) {
+                violations.add(module.getName() + " is a world module and must sit in <category>.world");
+            }
+        }
+        assertTrue(violations.isEmpty(), String.join("\n", violations));
+    }
+
+    @Test
+    void everyAsyncModuleCannotBeReloaded() {
+        List<Class<?>> asyncModules = new ArrayList<>();
+        for (Class<?> module : modules(ConfigModule.class)) {
+            if (module.getPackageName().equals(MODULE_PACKAGE + ".async")) {
+                asyncModules.add(module);
+            }
+        }
+        assertFalse(asyncModules.isEmpty());
+        for (Class<?> module : asyncModules) {
+            assertTrue(module.isAnnotationPresent(HotReloadUnsupported.class),
+                module.getName() + " starts threads or executors and must be @HotReloadUnsupported");
+        }
+    }
+
+    // ---- The checks themselves reject modules that break the rules
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "ok")
+    static final class GoodGlobal implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static int a = 1;
+        @ConfigInfo(name = "list")
+        static List<String> list = new ArrayList<>();
+        @ConfigInfo(name = "mode")
+        static Thread.State mode = Thread.State.NEW;
+        @DoNotLoad
+        static int derived;
+
+        public static void migrate(ConfigMigrationContext migrations) {
+        }
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "ok-world")
+    static final class GoodWorld implements WorldConfigModule {
+
+        @ConfigInfo(name = "a")
+        int a = 1;
+    }
+
+    @Test
+    void acceptsWellFormedModules() throws Exception {
+        assertEquals(List.of(), check(GoodGlobal.class, false, true));
+        assertEquals(List.of(), check(GoodWorld.class, true, true));
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class InstanceFieldInGlobal implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class StaticFieldInWorld implements WorldConfigModule {
+
+        @ConfigInfo(name = "a")
+        static int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class FinalField implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static final int A = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class NullDefault implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static String a = null;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class DoNotLoadAndConfigInfo implements ConfigModule {
+
+        @DoNotLoad
+        @ConfigInfo(name = "a")
+        static int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class UnsupportedType implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static Map<String, String> a = new HashMap<>();
+        @ConfigInfo(name = "b")
+        static List<Integer> b = new ArrayList<>();
+        @ConfigInfo(name = "c")
+        static float c = 1;
+    }
+
+    static final class MissingClassInfo implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class BadMigrateSignature implements ConfigModule {
+
+        void migrate(ConfigMigrationContext migrations) {
+        }
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "bad")
+    static final class NotExposedWorldModule implements WorldConfigModule {
+
+        @ConfigInfo(name = "a")
+        int a = 1;
+    }
+
+    @Test
+    void rejectsModulesThatBreakTheContract() throws Exception {
+        assertFalse(check(InstanceFieldInGlobal.class, false, true).isEmpty());
+        assertFalse(check(StaticFieldInWorld.class, true, true).isEmpty());
+        assertFalse(check(FinalField.class, false, true).isEmpty());
+        assertFalse(check(NullDefault.class, false, true).isEmpty());
+        assertFalse(check(DoNotLoadAndConfigInfo.class, false, true).isEmpty());
+        assertEquals(3, check(UnsupportedType.class, false, true).stream().filter(v -> v.contains("type")).count());
+        assertFalse(check(MissingClassInfo.class, false, true).isEmpty());
+        assertFalse(check(BadMigrateSignature.class, false, true).isEmpty());
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "dup")
+    static final class DuplicateA implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "dup")
+    static final class DuplicateB implements ConfigModule {
+
+        @ConfigInfo(name = "a")
+        static int a = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "parent")
+    static final class OptionParent implements ConfigModule {
+
+        @ConfigInfo(name = "child")
+        static int child = 1;
+    }
+
+    @ConfigClassInfo(category = ConfigCategory.MISC, name = "parent.child")
+    static final class ChildSection implements ConfigModule {
+
+        @ConfigInfo(name = "x")
+        static int x = 1;
+    }
+
+    @Test
+    void rejectsDuplicateAndOverlappingPaths() {
+        assertFalse(checkPaths(List.of(DuplicateA.class, DuplicateB.class)).isEmpty());
+        // misc.parent.child is an option of one module and a section of the other
+        assertFalse(checkPaths(List.of(OptionParent.class, ChildSection.class)).isEmpty());
+        assertEquals(List.of(), checkPaths(List.of(GoodGlobal.class, DuplicateA.class)));
+    }
+
+    @Test
+    void rejectsWorldModulesThatLeafWorldConfigDoesNotExpose() {
+        boolean exposed = false;
+        for (Field field : LeafWorldConfig.class.getDeclaredFields()) {
+            exposed |= field.getType() == NotExposedWorldModule.class;
+        }
+        assertFalse(exposed);
+    }
+
+    // ---- Rules
+
+    private static List<Class<?>> modules(Class<?> moduleType) {
+        List<Class<?>> modules = new ArrayList<>();
+        try (ScanResult scan = new ClassGraph().acceptPackages(MODULE_PACKAGE).enableClassInfo().scan()) {
+            for (ClassInfo info : scan.getClassesImplementing(moduleType.getName())) {
+                if (!info.isInterface() && !info.isAbstract()) {
+                    modules.add(info.loadClass()); // ClassGraph does not initialize the class
+                }
+            }
+        }
+        modules.sort((left, right) -> left.getName().compareTo(right.getName()));
+        return modules;
+    }
+
+    /** Returns the broken rules of one module; empty when it follows the contract. */
+    private static List<String> check(Class<?> module, boolean world, boolean initialize) throws Exception {
+        List<String> violations = new ArrayList<>();
+        String name = module.getName();
+        if (module.getAnnotation(ConfigClassInfo.class) == null) {
+            violations.add(name + " is missing @ConfigClassInfo");
+        }
+        if (Modifier.isAbstract(module.getModifiers()) || module.getDeclaredConstructors().length == 0) {
+            violations.add(name + " must be a concrete class");
+        }
+        try {
+            module.getDeclaredConstructor();
+        } catch (NoSuchMethodException exception) {
+            violations.add(name + " needs a no-argument constructor");
+        }
+
+        Object instance = null;
+        if (initialize) {
+            Class.forName(name, true, module.getClassLoader());
+            try {
+                var constructor = module.getDeclaredConstructor();
+                constructor.setAccessible(true);
+                instance = constructor.newInstance();
+            } catch (NoSuchMethodException ignored) {
+                // reported above
+            }
+        }
+
+        for (Field field : module.getDeclaredFields()) {
+            boolean configInfo = field.isAnnotationPresent(ConfigInfo.class);
+            if (field.isAnnotationPresent(DoNotLoad.class)) {
+                if (configInfo) {
+                    violations.add(field + " has both @DoNotLoad and @ConfigInfo");
+                }
+                continue;
+            }
+            if (!configInfo) {
+                continue;
+            }
+            if (Modifier.isFinal(field.getModifiers())) {
+                violations.add(field + " must not be final");
+            }
+            if (Modifier.isStatic(field.getModifiers()) == world) {
+                violations.add(field + (world ? " must be an instance field in a world module" : " must be a static field in a global module"));
+            }
+            if (!supported(field)) {
+                violations.add(field + " has an unsupported type");
+            }
+            if (instance != null) {
+                field.setAccessible(true);
+                if (field.get(Modifier.isStatic(field.getModifiers()) ? null : instance) == null) {
+                    violations.add(field + " has a null default value");
+                }
+            }
+        }
+
+        for (Method method : module.getDeclaredMethods()) {
+            if (method.getName().equals("migrate")) {
+                if (!Modifier.isPublic(method.getModifiers()) || !Modifier.isStatic(method.getModifiers())
+                    || method.getReturnType() != void.class
+                    || !java.util.Arrays.equals(method.getParameterTypes(), new Class<?>[]{ConfigMigrationContext.class})) {
+                    violations.add(method + " must be public static void migrate(ConfigMigrationContext)");
+                }
+            }
+        }
+        return violations;
+    }
+
+    private static boolean supported(Field field) {
+        Class<?> type = field.getType();
+        if (type == boolean.class || type == Boolean.class
+            || type == int.class || type == Integer.class
+            || type == long.class || type == Long.class
+            || type == double.class || type == Double.class
+            || type == String.class || type.isEnum()) {
+            return true;
+        }
+        if (type == List.class) {
+            Type generic = field.getGenericType();
+            return generic instanceof ParameterizedType parameterized
+                && parameterized.getActualTypeArguments().length == 1
+                && parameterized.getActualTypeArguments()[0] == String.class;
+        }
+        return false;
+    }
+
+    /** Option paths of the given modules, which share one file, must be unique and must not nest. */
+    private static List<String> checkPaths(List<Class<?>> modules) {
+        List<String> violations = new ArrayList<>();
+        Map<String, Field> paths = new HashMap<>();
+        for (Class<?> module : modules) {
+            if (module.getAnnotation(ConfigClassInfo.class) == null) {
+                continue;
+            }
+            for (Field field : module.getDeclaredFields()) {
+                if (!field.isAnnotationPresent(ConfigInfo.class) || field.isAnnotationPresent(DoNotLoad.class)) {
+                    continue;
+                }
+                String path = ConfigPaths.fieldPath(module, field);
+                Field previous = paths.putIfAbsent(path, field);
+                if (previous != null) {
+                    violations.add("Duplicate option path " + path + ": " + previous + " and " + field);
+                }
+            }
+        }
+        for (Map.Entry<String, Field> entry : paths.entrySet()) {
+            for (Map.Entry<String, Field> other : paths.entrySet()) {
+                if (other.getKey().startsWith(entry.getKey() + ".")) {
+                    violations.add("Option path " + entry.getKey() + " (" + entry.getValue() + ") is also a section of " + other.getKey());
+                }
+            }
+        }
+        return violations;
+    }
+}
