+package org.dreeam.leaf.config.util;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.AccessDeniedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Tag("LeafTest")
+class ConfigFileIOTest {
+
+    @TempDir
+    Path temp;
+
+    /** A configuration whose save fails with the given exception. */
+    private static final class FailingConfig extends ConfigFile {
+
+        private final Exception failure;
+
+        FailingConfig(File file, Exception failure) throws Exception {
+            super(file);
+            this.failure = failure;
+        }
+
+        @Override
+        public void save() throws Exception {
+            throw this.failure;
+        }
+    }
+
+    // ---- Loading
+
+    @Test
+    void missingFileIsNotCreatedByLoading() throws Exception {
+        File file = temp.resolve("config").resolve("missing.yml").toFile();
+        ConfigFile config = ConfigFileIO.load(file);
+        assertFalse(file.exists());
+        assertFalse(file.getParentFile().exists());
+
+        config.addDefault("a", 1);
+        ConfigFileIO.SaveReport report = ConfigFileIO.save(config);
+        assertTrue(file.isFile()); // created when saved, including its directory
+        assertEquals(ConfigFileIO.SaveStatus.SAVED, report.results().get(0).status());
+        assertEquals(1, ConfigFileIO.load(file).get("a"));
+    }
+
+    @Test
+    void existingFileIsLoaded() throws Exception {
+        File file = temp.resolve("existing.yml").toFile();
+        Files.writeString(file.toPath(), "a: 5\n");
+        assertEquals(5, ConfigFileIO.load(file).get("a"));
+    }
+
+    @Test
+    void malformedYamlIsRejectedWithItsPath() throws Exception {
+        File file = temp.resolve("malformed.yml").toFile();
+        Files.writeString(file.toPath(), "a: [unterminated\nb: : :\n");
+        IOException exception = assertThrows(IOException.class, () -> ConfigFileIO.load(file));
+        assertTrue(exception.getMessage().contains(file.getName()), exception.getMessage());
+    }
+
+    @Test
+    void directoryInsteadOfFileIsReported() throws Exception {
+        File directory = temp.resolve("directory.yml").toFile();
+        assertTrue(directory.mkdir());
+        assertThrows(IOException.class, () -> ConfigFileIO.load(directory));
+        assertTrue(directory.isDirectory());
+    }
+
+    @Test
+    void danglingLinkIsReportedAndNotFollowed() throws Exception {
+        Path link = temp.resolve("link.yml");
+        Path target = temp.resolve("target.yml");
+        try {
+            Files.createSymbolicLink(link, target);
+        } catch (UnsupportedOperationException | IOException exception) {
+            return; // symbolic links are not available here
+        }
+        assertThrows(IOException.class, () -> ConfigFileIO.load(link.toFile()));
+        assertFalse(Files.exists(target));
+    }
+
+    // ---- Saving
+
+    @Test
+    void savesEveryTargetAndReportsEach() throws Exception {
+        File first = temp.resolve("first.yml").toFile();
+        File second = temp.resolve("second.yml").toFile();
+        ConfigFile firstConfig = ConfigFileIO.load(first);
+        ConfigFile secondConfig = ConfigFileIO.load(second);
+        firstConfig.addDefault("a", 1);
+        secondConfig.addDefault("b", 2);
+
+        ConfigFileIO.SaveReport report = ConfigFileIO.save(firstConfig, secondConfig);
+        assertEquals(2, report.results().size());
+        assertFalse(report.hasAccessDenied());
+        assertTrue(first.isFile());
+        assertTrue(second.isFile());
+    }
+
+    @Test
+    void accessDeniedIsReportedWithoutFailingAndOtherTargetsAreSaved() throws Exception {
+        File denied = temp.resolve("denied.yml").toFile();
+        File saved = temp.resolve("saved.yml").toFile();
+        // The denial is found through the cause chain
+        ConfigFile deniedConfig = new FailingConfig(denied, new IOException("wrapped", new AccessDeniedException("denied.yml")));
+        ConfigFile savedConfig = ConfigFileIO.load(saved);
+        savedConfig.addDefault("a", 1);
+
+        ConfigFileIO.SaveReport report = ConfigFileIO.save(deniedConfig, savedConfig);
+        assertTrue(report.hasAccessDenied());
+        assertEquals(ConfigFileIO.SaveStatus.ACCESS_DENIED, report.results().get(0).status());
+        assertEquals(ConfigFileIO.SaveStatus.SAVED, report.results().get(1).status());
+        assertTrue(saved.isFile());
+        assertTrue(report.describe().contains("ACCESS_DENIED"));
+    }
+
+    @Test
+    void otherFailuresAreThrownAfterEveryTargetWasAttempted() throws Exception {
+        File saved = temp.resolve("saved.yml").toFile();
+        IOException failure = new IOException("disk full");
+        ConfigFile failing = new FailingConfig(temp.resolve("failing.yml").toFile(), failure);
+        ConfigFile savedConfig = ConfigFileIO.load(saved);
+        savedConfig.addDefault("a", 1);
+
+        ConfigFileIO.ConfigSaveException exception = assertThrows(ConfigFileIO.ConfigSaveException.class,
+            () -> ConfigFileIO.save(failing, savedConfig));
+        assertEquals(failure, exception.getCause());
+        assertEquals(ConfigFileIO.SaveStatus.FAILED, exception.report().results().get(0).status());
+        assertEquals(ConfigFileIO.SaveStatus.SAVED, exception.report().results().get(1).status());
+        assertTrue(saved.isFile(), "a target saved before or after the failure is not rolled back");
+    }
+}
