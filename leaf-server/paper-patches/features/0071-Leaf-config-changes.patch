+package org.dreeam.leaf.config;
+
+import org.bukkit.support.environment.LeafTest;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** Gale files are archived in the stage that consumed them, into one backup directory. */
+@LeafTest
+class GaleArchiveTest {
+
+    private static final Path CONFIG = Path.of("config");
+    private static final Path WORLDS = Path.of("archive-test-worlds");
+    private static final String GALE_GLOBAL = "gameplay-mechanics:\n  enable-book-writing: false\n";
+    private static final String GALE_DEFAULTS = "small-optimizations:\n  save-fireworks: false\n";
+    private static final String GALE_WORLD = "small-optimizations:\n  save-fireworks: false\n";
+
+    @BeforeEach
+    @AfterEach
+    void clean() throws Exception {
+        delete(CONFIG);
+        delete(WORLDS);
+        for (String name : List.of("GLOBAL_MODULES", "WORLD_MODULES")) {
+            Field field = LeafConfig.class.getDeclaredField(name);
+            field.setAccessible(true);
+            ((List<?>) field.get(null)).clear();
+        }
+        org.dreeam.leaf.config.modules.gameplay.BookWriting.enabled = true;
+    }
+
+    private static void delete(Path path) throws IOException {
+        if (Files.notExists(path, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try (Stream<Path> files = Files.walk(path)) {
+            for (Path file : (Iterable<Path>) files.sorted(Comparator.reverseOrder())::iterator) {
+                if (Files.isWritable(file) || Files.isDirectory(file)) {
+                    Files.delete(file);
+                } else {
+                    file.toFile().setWritable(true);
+                    Files.delete(file);
+                }
+            }
+        }
+    }
+
+    private static List<Path> backups() throws IOException {
+        try (Stream<Path> entries = Files.list(CONFIG)) {
+            return entries.filter(path -> path.getFileName().toString().startsWith("backup-")).toList();
+        }
+    }
+
+    private static Path world(String name) throws IOException {
+        return Files.createDirectories(WORLDS.resolve(name));
+    }
+
+    private static void writeGaleStage() throws IOException {
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("gale-global.yml"), GALE_GLOBAL);
+        Files.writeString(CONFIG.resolve("gale-world-defaults.yml"), GALE_DEFAULTS);
+    }
+
+    @Test
+    void globalAndDefaultsSourcesAreArchivedWhenTheLeafFilesAreSaved() throws Exception {
+        writeGaleStage();
+        LeafConfig.loadConfig();
+        // Nothing is archived before the Leaf files exist
+        assertTrue(Files.exists(CONFIG.resolve("gale-global.yml")));
+
+        LeafConfig.loadAfterBootstrap();
+
+        assertFalse(Files.exists(CONFIG.resolve("gale-global.yml")));
+        assertFalse(Files.exists(CONFIG.resolve("gale-world-defaults.yml")));
+        assertEquals(1, backups().size());
+        assertTrue(Files.isRegularFile(backups().get(0).resolve("gale-global.yml")));
+        assertTrue(Files.isRegularFile(backups().get(0).resolve("gale-world-defaults.yml")));
+        assertTrue(Files.isRegularFile(CONFIG.resolve("leaf-global.yml")));
+        assertFalse(LeafConfig.worldDefaultsConfig().saveFireworks.enabled);
+    }
+
+    @Test
+    void sourceStaysWhenItsLeafFileCannotBeWritten() throws Exception {
+        writeGaleStage();
+        Path defaults = CONFIG.resolve("leaf-world-defaults.yml");
+        Files.writeString(defaults, "config-version: '3.1'\n");
+        if (!defaults.toFile().setReadOnly() || Files.isWritable(defaults)) {
+            return; // permissions are not enforced here
+        }
+
+        LeafConfig.loadConfig();
+        LeafConfig.loadAfterBootstrap();
+
+        assertFalse(Files.exists(CONFIG.resolve("gale-global.yml")));
+        assertTrue(Files.exists(CONFIG.resolve("gale-world-defaults.yml")), "the defaults could not be saved");
+        assertFalse(LeafConfig.worldDefaultsConfig().saveFireworks.enabled, "the imported value is active in memory");
+    }
+
+    @Test
+    void worldSourceIsArchivedWhenTheWorldIsLoadedEvenLongAfterStartup() throws Exception {
+        writeGaleStage();
+        LeafConfig.loadConfig();
+        LeafConfig.loadAfterBootstrap();
+        Path late = world("late");
+        Files.writeString(late.resolve("gale-world.yml"), GALE_WORLD + "something-else: 1\n");
+        Path unloaded = world("unloaded");
+        Files.writeString(unloaded.resolve("gale-world.yml"), GALE_WORLD);
+
+        LeafConfig.initWorldConfig(late);
+
+        assertFalse(Files.exists(late.resolve("gale-world.yml")));
+        assertTrue(Files.isRegularFile(late.resolve("leaf-world.yml")));
+        // The same backup directory as the startup stage, and worlds that are not loaded are not touched
+        assertEquals(1, backups().size());
+        try (Stream<Path> files = Files.walk(backups().get(0))) {
+            assertEquals(1, files.filter(path -> path.endsWith("gale-world.yml") && path.toString().contains("world-overrides")).count());
+        }
+        assertTrue(Files.exists(unloaded.resolve("gale-world.yml")));
+    }
+
+    @Test
+    void worldSourceWithoutImportableValuesIsArchivedWithoutCreatingAnOverride() throws Exception {
+        LeafConfig.loadConfig();
+        Path world = world("nothing");
+        Files.writeString(world.resolve("gale-world.yml"), "_version: 1\n");
+
+        LeafConfig.initWorldConfig(world);
+
+        assertFalse(Files.exists(world.resolve("gale-world.yml")));
+        assertFalse(Files.exists(world.resolve("leaf-world.yml")));
+    }
+
+    @Test
+    void worldSourceStaysWhenTheOverrideCannotBeSaved() throws Exception {
+        LeafConfig.loadConfig();
+        Path world = world("readonly");
+        Path gale = Files.writeString(world.resolve("gale-world.yml"), GALE_WORLD);
+        if (!world.toFile().setWritable(false) || Files.isWritable(world)) {
+            return; // permissions are not enforced here
+        }
+        try {
+            LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+            assertFalse(config.saveFireworks.enabled, "the imported value is active in memory");
+            assertTrue(Files.exists(gale));
+            assertFalse(Files.exists(world.resolve("leaf-world.yml")));
+        } finally {
+            world.toFile().setWritable(true);
+        }
+    }
+
+    @Test
+    void worldSourceWithAnInvalidValueStaysUntilItIsFixed() throws Exception {
+        LeafConfig.loadConfig();
+        Path world = world("invalid");
+        Path gale = Files.writeString(world.resolve("gale-world.yml"), "small-optimizations:\n  save-fireworks: maybe\n");
+
+        try {
+            LeafConfig.initWorldConfig(world);
+        } catch (RuntimeException expected) {
+            // the world fails to load
+        }
+        assertTrue(Files.exists(gale));
+        assertTrue(backups().isEmpty());
+    }
+}
