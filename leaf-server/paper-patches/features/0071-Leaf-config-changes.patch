+package org.dreeam.leaf.config;
+
+import io.github.thatsmusic99.configurationmaster.api.ConfigFile;
+import org.bukkit.support.environment.LeafTest;
+import org.dreeam.leaf.config.modules.gameplay.BookWriting;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * How {@link LeafConfig#initWorldConfig(Path)} reads {@code leaf-world.yml}: the version of the file
+ * decides what is migrated, and a world never gets a file it does not need. Works in the working directory
+ * of the test task, like the server does.
+ */
+@LeafTest
+class LeafWorldOverrideMigrationTest {
+
+    private static final Path CONFIG = Path.of("config");
+    private static final Path WORLDS = Path.of("override-test-worlds");
+
+    @BeforeEach
+    @AfterEach
+    void clean() throws Exception {
+        delete(CONFIG);
+        delete(WORLDS);
+        for (String name : List.of("GLOBAL_MODULES", "WORLD_MODULES")) {
+            Field field = LeafConfig.class.getDeclaredField(name);
+            field.setAccessible(true);
+            ((List<?>) field.get(null)).clear();
+        }
+        BookWriting.enabled = true;
+    }
+
+    private static void delete(Path path) throws IOException {
+        if (Files.notExists(path, LinkOption.NOFOLLOW_LINKS)) {
+            return;
+        }
+        try (Stream<Path> files = Files.walk(path)) {
+            for (Path file : (Iterable<Path>) files.sorted(Comparator.reverseOrder())::iterator) {
+                Files.delete(file);
+            }
+        }
+    }
+
+    private static Path world(String name) throws IOException {
+        return Files.createDirectories(WORLDS.resolve(name));
+    }
+
+    private static Path override(Path world, String content) throws IOException {
+        return Files.writeString(world.resolve("leaf-world.yml"), content);
+    }
+
+    private static void startConfig() {
+        LeafConfig.loadConfig();
+    }
+
+    // ---- No override
+
+    @Test
+    void worldWithoutOverrideUsesDefaultsAndGetsNoFile() throws Exception {
+        startConfig();
+        Path world = world("plain");
+
+        LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+
+        assertTrue(config.saveFireworks.enabled);
+        assertFalse(Files.exists(world.resolve("leaf-world.yml")));
+        assertNotSame(LeafConfig.worldDefaultsConfig().saveFireworks, config.saveFireworks);
+    }
+
+    // ---- Versions of an existing override
+
+    @Test
+    void currentVersionOverrideIsReadAndNotRewritten() throws Exception {
+        startConfig();
+        Path world = world("current");
+        Path file = override(world, "config-version: '3.1'\nperformance:\n  save-fireworks: false\n");
+        byte[] before = Files.readAllBytes(file);
+
+        LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+
+        assertFalse(config.saveFireworks.enabled);
+        assertArrayEquals(before, Files.readAllBytes(file));
+    }
+
+    @Test
+    void olderVersionOnlyUpdatesTheVersionAndKeepsExplicitValuesOnly() throws Exception {
+        startConfig();
+        Path world = world("older");
+        Path file = override(world, "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+
+        LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+
+        assertFalse(config.saveFireworks.enabled);
+        ConfigFile saved = ConfigFile.loadConfig(file.toFile());
+        assertEquals("3.1", String.valueOf(saved.get("config-version")));
+        assertEquals(false, saved.get("performance.save-fireworks"));
+        // Defaults are not copied into an override
+        assertFalse(saved.contains("performance.max-projectile-chunk-loads.per-tick"));
+        assertFalse(saved.contains("performance.optimize-block-entities"));
+    }
+
+    @Test
+    void missingVersionWarnsKeepsValuesAndIsCompletedOnce() throws Exception {
+        startConfig();
+        Path world = world("unversioned");
+        Path file = override(world, "performance:\n  save-fireworks: false\n");
+
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+            assertFalse(config.saveFireworks.enabled);
+            assertEquals(1, log.warnings().size(), log.warnings().toString());
+            assertTrue(log.warnings().get(0).contains("leaf-world.yml"), log.warnings().get(0));
+        }
+        ConfigFile saved = ConfigFile.loadConfig(file.toFile());
+        assertEquals("3.1", String.valueOf(saved.get("config-version")));
+        assertEquals(false, saved.get("performance.save-fireworks"));
+
+        // The next load is silent
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            assertFalse(LeafConfig.initWorldConfig(world).saveFireworks.enabled);
+            assertEquals(List.of(), log.warnings());
+        }
+    }
+
+    @Test
+    void unparsableVersionFailsTheWorldAndLeavesTheFile() throws Exception {
+        startConfig();
+        Path world = world("broken");
+        Path file = override(world, "config-version: banana\nperformance:\n  save-fireworks: false\n");
+        byte[] before = Files.readAllBytes(file);
+
+        RuntimeException exception = assertThrows(RuntimeException.class, () -> LeafConfig.initWorldConfig(world));
+        String messages = exception.toString() + exception.getCause();
+        assertTrue(messages.contains("banana") && messages.contains("leaf-world.yml"), messages);
+        assertArrayEquals(before, Files.readAllBytes(file));
+    }
+
+    @Test
+    void newerVersionWarnsAndKeepsItsVersion() throws Exception {
+        startConfig();
+        Path world = world("newer");
+        Path file = override(world, "config-version: '3.10'\nperformance:\n  save-fireworks: false\n");
+        byte[] before = Files.readAllBytes(file);
+
+        try (LogCapture log = new LogCapture("LeafConfig")) {
+            LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+            assertFalse(config.saveFireworks.enabled);
+            assertEquals(1, log.warnings().size(), log.warnings().toString());
+            assertTrue(log.warnings().get(0).contains("3.10"), log.warnings().get(0));
+        }
+        assertArrayEquals(before, Files.readAllBytes(file));
+    }
+
+    @Test
+    void everyWorldIsMigratedByItsOwnVersion() throws Exception {
+        // The global configuration is already current; a world loaded later still has its old version.
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("leaf-global.yml"), "config-version: '3.1'\n");
+        startConfig();
+        Path current = world("a");
+        Path old = world("b");
+        Path currentFile = override(current, "config-version: '3.1'\nperformance:\n  save-fireworks: false\n");
+        Path oldFile = override(old, "config-version: '3.0'\nperformance:\n  save-fireworks: false\n");
+        byte[] currentBytes = Files.readAllBytes(currentFile);
+
+        LeafConfig.initWorldConfig(current);
+        assertArrayEquals(currentBytes, Files.readAllBytes(currentFile));
+        assertEquals("3.0", String.valueOf(ConfigFile.loadConfig(oldFile.toFile()).get("config-version")));
+
+        LeafConfig.initWorldConfig(old);
+        assertEquals("3.1", String.valueOf(ConfigFile.loadConfig(oldFile.toFile()).get("config-version")));
+    }
+
+    @Test
+    void invalidValueFailsTheWorldAndLeavesTheFile() throws Exception {
+        startConfig();
+        Path world = world("invalid");
+        Path file = override(world, "config-version: '3.0'\nperformance:\n  max-projectile-chunk-loads:\n    per-tick: lots\n");
+        byte[] before = Files.readAllBytes(file);
+
+        assertThrows(RuntimeException.class, () -> LeafConfig.initWorldConfig(world));
+        assertArrayEquals(before, Files.readAllBytes(file));
+    }
+
+    // ---- Gale world overrides
+
+    private static final String GALE_FIREWORKS = "small-optimizations:\n  save-fireworks: false\n";
+
+    @Test
+    void galeValuesBecomeAnOverrideWithTheCurrentVersion() throws Exception {
+        startConfig();
+        Path world = world("gale");
+        Files.writeString(world.resolve("gale-world.yml"), "_version: 1\n" + GALE_FIREWORKS);
+
+        LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+
+        assertFalse(config.saveFireworks.enabled);
+        ConfigFile saved = ConfigFile.loadConfig(world.resolve("leaf-world.yml").toFile());
+        assertEquals("3.1", String.valueOf(saved.get("config-version")));
+        assertEquals(false, saved.get("performance.save-fireworks"));
+        assertFalse(saved.contains("performance.max-projectile-chunk-loads.per-tick"));
+        assertFalse(Files.exists(world.resolve("gale-world.yml"))); // archived once the world is loaded
+    }
+
+    @Test
+    void galeFileWithoutImportableValuesCreatesNoOverride() throws Exception {
+        startConfig();
+        for (String content : List.of("_version: 1\n", "unknown-option: 1\n", "small-optimizations:\n  save-fireworks:\n", "")) {
+            Path world = world("gale-" + Math.abs(content.hashCode()));
+            Files.writeString(world.resolve("gale-world.yml"), content);
+            assertTrue(LeafConfig.initWorldConfig(world).saveFireworks.enabled, content);
+            assertFalse(Files.exists(world.resolve("leaf-world.yml")), content);
+        }
+    }
+
+    @Test
+    void invalidGaleValueFailsTheWorldAndKeepsTheSource() throws Exception {
+        startConfig();
+        Path world = world("gale-invalid");
+        Path gale = Files.writeString(world.resolve("gale-world.yml"), "small-optimizations:\n  save-fireworks: maybe\n");
+
+        assertThrows(RuntimeException.class, () -> LeafConfig.initWorldConfig(world));
+        assertFalse(Files.exists(world.resolve("leaf-world.yml")));
+        assertTrue(Files.exists(gale));
+
+        // After the source is fixed, the next load migrates it
+        Files.writeString(gale, GALE_FIREWORKS);
+        assertFalse(LeafConfig.initWorldConfig(world).saveFireworks.enabled);
+        assertTrue(Files.exists(world.resolve("leaf-world.yml")));
+    }
+
+    @Test
+    void existingLeafOverrideWinsOverTheGaleFile() throws Exception {
+        startConfig();
+        Path world = world("gale-and-leaf");
+        Files.writeString(world.resolve("gale-world.yml"), GALE_FIREWORKS);
+        Path file = override(world, "config-version: '3.1'\nperformance:\n  save-fireworks: true\n");
+        byte[] before = Files.readAllBytes(file);
+
+        LeafWorldConfig config = LeafConfig.initWorldConfig(world);
+
+        assertTrue(config.saveFireworks.enabled);
+        assertArrayEquals(before, Files.readAllBytes(file));
+        assertFalse(Files.exists(world.resolve("gale-world.yml")));
+    }
+
+    // ---- Gale global values through binding and saving (P1-8)
+
+    @Test
+    void leafRenameInAnExistingCategorySurvivesBindingAndSaving() throws Exception {
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("leaf-global.yml"), "config-version: '3.0'\nperformance:\n  optimise-block-entities: false\n");
+
+        startConfig();
+
+        assertFalse(org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities.enabled);
+        ConfigFile global = LeafConfig.globalConfig().configFile;
+        global.save();
+        ConfigFile saved = ConfigFile.loadConfig(global.getFile());
+        assertEquals(false, saved.get("performance.optimize-block-entities"));
+        assertFalse(saved.contains("performance.optimise-block-entities"));
+        org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities.enabled = true;
+    }
+
+    @Test
+    void galeGlobalValueSurvivesBindingAndSaving() throws Exception {
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("gale-global.yml"), "gameplay-mechanics:\n  enable-book-writing: false\n");
+
+        startConfig();
+
+        assertFalse(BookWriting.enabled);
+        ConfigFile global = LeafConfig.globalConfig().configFile;
+        assertEquals(false, global.get("gameplay-mechanisms.book-writing.enabled"));
+        global.save();
+        ConfigFile saved = ConfigFile.loadConfig(global.getFile());
+        assertEquals(false, saved.get("gameplay-mechanisms.book-writing.enabled"));
+    }
+
+    // ---- Layout: values written before binding (migrations, the version) do not change the saved order
+
+    /** The keys of a saved file, with their indentation, in file order; values and comments are left out. */
+    private static List<String> keys(Path file) throws IOException {
+        return Files.readAllLines(file).stream()
+            .filter(line -> line.matches("^\\s*[A-Za-z0-9'_.-]+:.*"))
+            .map(line -> line.substring(0, line.indexOf(':')))
+            .toList();
+    }
+
+    /** Saves the files like {@link LeafConfig#loadAfterBootstrap()} does at the end of startup. */
+    private static void saveStartupFiles() throws Exception {
+        LeafConfig.saveConfigs(LeafConfig.worldDefaultsConfig().configFile, LeafConfig.globalConfig().configFile);
+    }
+
+    private static final List<String> GLOBAL_ROOTS =
+        List.of("config-version", "async", "performance", "fixes", "gameplay-mechanisms", "network", "misc");
+
+    private static List<String> roots(List<String> keys) {
+        return keys.stream().filter(key -> !key.startsWith(" ")).toList();
+    }
+
+    /** Checks that the entries directly below every category are sorted by name. */
+    private static void assertCategoriesSorted(List<String> keys) {
+        List<String> entries = new java.util.ArrayList<>();
+        for (String key : keys) {
+            if (!key.startsWith(" ")) {
+                assertEquals(entries.stream().sorted().toList(), entries, "entries before " + key);
+                entries.clear();
+            } else if (key.startsWith("  ") && !key.startsWith("   ")) {
+                entries.add(key.strip());
+            }
+        }
+        assertEquals(entries.stream().sorted().toList(), entries);
+    }
+
+    @Test
+    void freshFilesAreOrderedByCategoryAndName() throws Exception {
+        startConfig();
+        saveStartupFiles();
+
+        List<String> global = keys(CONFIG.resolve("leaf-global.yml"));
+        assertEquals(GLOBAL_ROOTS, roots(global));
+        assertCategoriesSorted(global);
+        assertTrue(Files.readString(CONFIG.resolve("leaf-global.yml")).strip().startsWith("# Leaf"));
+
+        List<String> defaults = keys(CONFIG.resolve("leaf-world-defaults.yml"));
+        assertEquals(List.of("config-version", "performance", "fixes", "gameplay-mechanisms"), roots(defaults));
+        assertCategoriesSorted(defaults);
+    }
+
+    @Test
+    void galeMigratedFilesAreSavedInTheFreshLayout() throws Exception {
+        startConfig();
+        saveStartupFiles();
+        List<String> freshGlobal = keys(CONFIG.resolve("leaf-global.yml"));
+        List<String> freshDefaults = keys(CONFIG.resolve("leaf-world-defaults.yml"));
+        clean();
+
+        Files.createDirectories(CONFIG);
+        Files.writeString(CONFIG.resolve("gale-global.yml"), """
+            _version: 1
+            gameplay-mechanics:
+              enable-book-writing: false
+            small-optimizations:
+              reduced-intervals:
+                increase-time-statistics: 2
+            log-to-console:
+              invalid-statistics: false
+            """);
+        Files.writeString(CONFIG.resolve("gale-world-defaults.yml"), "_version: 1\n" + GALE_FIREWORKS);
+        startConfig();
+        saveStartupFiles();
+
+        // Already the first save after the migration has the layout of a fresh file
+        assertEquals(freshGlobal, keys(CONFIG.resolve("leaf-global.yml")));
+        // The header is written above the version, at the top of the file
+        assertTrue(Files.readString(CONFIG.resolve("leaf-global.yml")).strip().startsWith("# Leaf"));
+        assertEquals(false, ConfigFile.loadConfig(CONFIG.resolve("leaf-world-defaults.yml").toFile()).get("performance.save-fireworks"));
+        assertEquals(freshDefaults, keys(CONFIG.resolve("leaf-world-defaults.yml")));
+        BookWriting.enabled = true;
+        org.dreeam.leaf.config.modules.opt.ReducedIntervals.increaseTimeStatistics = 1;
+        org.dreeam.leaf.config.modules.misc.LogToConsole.invalidStatistics = true;
+    }
+
+    @Test
+    void reloadedRenameIsSavedInTheFreshLayout() throws Exception {
+        startConfig();
+        saveStartupFiles();
+        List<String> fresh = keys(CONFIG.resolve("leaf-global.yml"));
+
+        // A renamed option is set by the migration before the modules are bound
+        Files.writeString(CONFIG.resolve("leaf-global.yml"), "performance:\n  optimise-block-entities: false\nconfig-version: '3.0'\n");
+        LeafConfig.reloadConfigs(List.of());
+
+        assertEquals(fresh, keys(CONFIG.resolve("leaf-global.yml")));
+        assertFalse(org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities.enabled);
+        org.dreeam.leaf.config.modules.opt.OptimizeBlockEntities.enabled = true;
+    }
+
+    @Test
+    void rewrittenOverrideStartsWithItsVersion() throws Exception {
+        startConfig();
+        Path older = world("version-last");
+        override(older, "performance:\n  save-fireworks: false\nconfig-version: '3.0'\n");
+        Path missing = world("version-missing");
+        override(missing, "performance:\n  save-fireworks: false\n");
+        Path gale = world("version-gale");
+        Files.writeString(gale.resolve("gale-world.yml"), "_version: 1\n" + GALE_FIREWORKS);
+
+        for (Path world : List.of(older, missing, gale)) {
+            assertFalse(LeafConfig.initWorldConfig(world).saveFireworks.enabled, world.toString());
+            assertEquals(List.of("config-version", "performance", "  save-fireworks"),
+                keys(world.resolve("leaf-world.yml")), world.toString());
+        }
+    }
+}
